msgid "You are not a member of any workspace."
msgstr "Vous n’êtes membre d’aucun workspace."

#: extension/ui/pages/LoginPage.tsx
msgid "Sign up on Dust"
msgstr "S’inscrire sur Dust"

#: extension/ui/pages/LoginPage.tsx
msgid "Then"
msgstr "Puis"

#: extension/ui/pages/LoginPage.tsx
msgid "Or"
msgstr "Ou"

#: extension/ui/pages/LoginPage.tsx
msgid "Logout"
msgstr "Se déconnecter"

#: extension/ui/pages/LoginPage.tsx
msgid "Something unexpected occurred. Please try logging in again. If the problem persists, contact us at support@dust.tt."
msgstr "Une erreur inattendue s’est produite. Reconnectez-vous. Si le problème persiste, contactez-nous à support@dust.tt."

