engine biome(1.0)
language js

// Disallows `+` with a string or template literal operand inside JSX props and
// children. See CONTRACTS [ui-text-not-concatenated].
`$left + $right` as $concat where {
    or {
        $left <: JsStringLiteralExpression(),
        $right <: JsStringLiteralExpression(),
        $left <: JsTemplateExpression(),
        $right <: JsTemplateExpression()
    },
    $concat <: within or { JsxExpressionChild(), JsxExpressionAttributeValue() },
    register_diagnostic(
        span = $concat,
        message = "Avoid building text with `+` in JSX (CONTRACTS [ui-text-not-concatenated]). Use a single string or template literal instead.",
        severity = "error"
    )
}
