engine biome(1.0)
language js

// Prevents server-side code from importing client-only modules. A value import
// pulls the whole module graph behind it into the front-api bundle at boot: one
// `@app/components/...` import cost us React, tiptap, posthog-js and the
// Datadog browser SDK, all loaded before the server bound its socket.
// Type-only imports are erased at build time, so they are allowed.
pattern client_module_source() {
    or {
        `"@app/components/$_"`,
        `"@app/hooks/$_"`,
        `"@app/pages/$_"`,
        `"@app/lib/client/$_"`,
        `"@app/lib/swr/$_"`,
        `"@app/lib/tracking"`,
        `"@app/lib/utils/utm_client"`,
        `"@app/logger/datadogLogger"`,
        `"@dust-tt/sparkle"`,
        `"@dust-tt/sparkle/$_"`
    }
}

pattern no_client_import_in_server() {
    or {
        `import $_ from $source`,
        `import { $_ } from $source`,
        `import * as $_ from $source`,
    } as $import where {
        $source <: client_module_source(),
        $import <: not r"import type .*",
        // The tiptap node definitions are framework-free by construction and are
        // shared with the server-side markdown pipeline; their React views live
        // in sibling `*WithView` modules.
        $source <: not r".*@app/components/editor/extensions/.*"
    }
}

no_client_import_in_server() as $import where {
    register_diagnostic(
        span = $import,
        message = "This server-side module value-imports client-only code. Move the shared runtime value to a server-safe `@app/lib/...` module, or use `import type` when importing only a type.",
        severity = "error"
    )
}
