engine biome(1.0)
language js

// Forbids deep imports from @dust-tt/client subpaths (e.g. @dust-tt/client/src,
// @dust-tt/client/src/toto.ts) in front/ and front-api/ code. Only the
// package root @dust-tt/client should be imported.
pattern client_deep_import() {
    `"@dust-tt/client/$_"` where {
        $filename <: or {
            r".*/front/.*",
            r".*/front-api/.*",
        }
    }
}

// Skip structural matching when the source cannot contain this rule's target.
// Keep backslashes as candidates so escaped spellings are still checked.
file(body = $body) where {
    $body <: or { includes "@dust-tt/client/", includes "\\" },
    $body <: contains bubble client_deep_import() as $source where {
        register_diagnostic(
            span = $source,
            message = "Deep imports from '@dust-tt/client/*' are not allowed. Import from '@dust-tt/client' instead.",
            severity = "error"
        )
    }
}
