{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "root": true,
  "plugins": [],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.{js,jsx,ts,tsx}",
      "**/package.json",
      "**/biome.json",
      "!!**/.next",
      "!!**/node_modules",
      "!!**/workers-build",
      "!!**/dist",
      "!!**/build",
      "!!**/coverage",
      "!**/.yalc/**/*.{js,jsx,ts,tsx}",
      "!!**/x/**",
      "!!extension/shared/lib/swr.ts",
      "!!extension/packages",
      "!!**/package-lock.json",
      "!!**/__snapshots__",
      "!!**/.git",
      "!!cli/dust-sandbox/functions-runner/runner.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true
  },
  "linter": {
    "includes": [
      "sdks/js/**",
      "viz/**",
      "extension/**",
      "cli/dust-cli/**",
      "firebase-functions/**",
      "sparkle/**",
      "connectors/**",
      "front-spa/**",
      "front/**",
      "front-api/**",
      "marketing/**",
      "cli/dust-sandbox/functions-runner/**",
      "cli/dust-sandbox/pod/**"
    ],
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": { "fix": "safe", "level": "error" },
        "noUnusedVariables": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "useImportType": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "front/**/*.{js,jsx,ts,tsx}",
        "front-api/**/*.{js,jsx,ts,tsx}",
        "connectors/src/**/*.{js,jsx,ts,tsx}",
        "cli/dust-cli/**/*.{js,jsx,ts,tsx}",
        "extension/**/*.{js,jsx,ts,tsx}"
      ],
      "plugins": [
        "./.grit/patterns/noBulkLodash.grit",
        "./.grit/patterns/noDirectSparkleNotification.grit"
      ]
    },
    {
      "includes": [
        "front/**/*.{js,jsx,ts,tsx}",
        "front-api/**/*.{js,jsx,ts,tsx}"
      ],
      "plugins": [
        "./.grit/patterns/enforceClientTypesInPublicApi.grit",
        "./.grit/patterns/noClientDeepImports.grit"
      ]
    },
    {
      "includes": [
        "front/**/*.{js,jsx,ts,tsx}",
        "front-api/**/*.{js,jsx,ts,tsx}",
        "!front/lib/api/assistant/conversation/fetch.ts",
        "!**/*.{test,spec}.{js,jsx,ts,tsx}",
        "!front/tests/**"
      ],
      "plugins": ["./.grit/patterns/noExpensiveConversationFetch.grit"]
    },
    {
      "includes": [
        "front/**/*.{js,jsx,ts,tsx}",
        "!**/*.{test,spec}.{js,jsx,ts,tsx}"
      ],
      "plugins": [
        "./.grit/patterns/noLocaleLessDateTimeFormat.grit",
        "./.grit/patterns/noLocaleLessToLocaleString.grit"
      ]
    },
    {
      "includes": [
        "front/components/**/*.{js,jsx,ts,tsx}",
        "front/hooks/**/*.{js,jsx,ts,tsx}",
        "front/lib/swr/**/*.{js,jsx,ts,tsx}",
        "!**/*.{test,spec}.{js,jsx,ts,tsx}"
      ],
      "plugins": ["./.grit/patterns/noBareLocaleCompare.grit"]
    },
    {
      "includes": [
        "front/components/**/*.{js,jsx,ts,tsx}",
        "front/hooks/**/*.{js,jsx,ts,tsx}",
        "front/lib/client/**/*.{js,jsx,ts,tsx}",
        "front/lib/swr/**/*.{js,jsx,ts,tsx}",
        "!**/*.{test,spec}.{js,jsx,ts,tsx}"
      ],
      "plugins": ["./.grit/patterns/noHardcodedEnUsLocale.grit"]
    },
    {
      "includes": ["front-api/**/*.ts", "!front-api/routes/types.ts"],
      "plugins": ["./.grit/patterns/noInlineSuccessResponseBody.grit"]
    },
    {
      "includes": [
        "front-api/**/*.ts",
        "front/lib/api/**/*.ts",
        "front/types/**/*.ts",
        "front/temporal/**/*.ts",
        "!front-api/esbuild*.ts",
        "!**/*.{test,spec}.{ts,tsx}"
      ],
      "plugins": ["./.grit/patterns/noClientImportsInServer.grit"]
    },
    {
      "includes": [
        "front/components/**/*.{js,jsx,ts,tsx}",
        "front/lib/**/*.tsx",
        "front-spa/**/*.{js,jsx,ts,tsx}",
        "sparkle/src/**/*.{js,jsx,ts,tsx}",
        "viz/**/*.{js,jsx,ts,tsx}",
        "!**/*.stories.{js,jsx,ts,tsx}",
        "!sparkle/src/lottie/**",
        "!sparkle/playground/**"
      ],
      "plugins": ["./.grit/patterns/noCssImportant.grit"]
    },
    {
      "includes": [
        "front/**/*.{js,jsx,ts,tsx}",
        "front-api/**/*.{js,jsx,ts,tsx}",
        "connectors/src/**/*.{js,jsx,ts,tsx}"
      ],
      "plugins": [
        "./.grit/patterns/noRawSql.grit",
        "./.grit/patterns/noUnverifiedWorkspaceBypass.grit"
      ]
    },
    {
      "includes": [
        "extension/**/*.{js,jsx,ts,tsx}",
        "front-spa/**/*.{js,jsx,ts,tsx}",
        "front/**/*.{js,jsx,ts,tsx}",
        "front-api/**/*.{js,jsx,ts,tsx}",
        "sparkle/**/*.{js,jsx,ts,tsx}",
        "!front-api/server.ts",
        "!sparkle/.storybook/**",
        "!sparkle/playground/**"
      ],
      "plugins": ["./.grit/patterns/noNextImports.grit"]
    },
    {
      "includes": ["front/**/*.tsx", "front-spa/**/*.tsx"],
      "plugins": ["./.grit/patterns/noSparkleClassInFront.grit"]
    },
    {
      "includes": ["front/**/*.tsx"],
      "plugins": ["./.grit/patterns/noStringConcatInJsx.grit"]
    },
    {
      "includes": [
        "front/components/**/*.{ts,tsx}",
        "front/hooks/**/*.{ts,tsx}",
        "front/lib/swr/**/*.{ts,tsx}",
        "front-spa/src/**/*.{ts,tsx}",
        "!**/*.{test,spec}.{ts,tsx}",
        "!front/components/poke/**",
        "!front-spa/src/poke/**",
        "!front/lib/swr/swr.ts",
        "!front-spa/src/app/components/AuthErrorPage.tsx",
        "!front-spa/src/lib/initDatadog.ts",
        "!front/components/UserMenu.tsx",
        "!front/components/actions/mcp/MCPServerDetails.tsx",
        "!front/components/actions/mcp/MCPServerSettings.tsx",
        "!front/components/actions/mcp/create/ConnectMCPServerDialog.tsx",
        "!front/components/actions/mcp/create/CreateMCPServerDialog.tsx",
        "!front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx",
        "!front/components/actions/mcp/forms/submitCreateMCPServerDialogForm.ts",
        "!front/components/agent_builder/AgentBuilder.tsx",
        "!front/components/agent_builder/SidekickPanelContext.tsx",
        "!front/components/agent_builder/hooks/useAgentPreview.ts",
        "!front/components/agent_builder/settings/AgentBuilderDescriptionSection.tsx",
        "!front/components/agent_builder/settings/AgentBuilderNameSection.tsx",
        "!front/components/agent_builder/settings/utils.ts",
        "!front/components/agent_builder/submitAgentBuilderForm.ts",
        "!front/components/agent_builder/triggers/TriggerFilterRenderer.tsx",
        "!front/components/agent_builder/triggers/schedule/ScheduleEditionScheduler.tsx",
        "!front/components/agent_builder/types.ts",
        "!front/components/assistant/conversation/AgentMessage.tsx",
        "!front/components/assistant/conversation/ConversationContainer.tsx",
        "!front/components/assistant/conversation/ConversationViewer.tsx",
        "!front/components/assistant/conversation/FeedbackSelector.tsx",
        "!front/components/assistant/conversation/actions/VisualizationActionIframe.tsx",
        "!front/components/assistant/conversation/interactive_content/FrameRenderer.tsx",
        "!front/components/assistant/details/AgentDetailsButtonBar.tsx",
        "!front/components/credits/UsageUpgradeButton.tsx",
        "!front/components/data_source/BigQueryOptionsView.tsx",
        "!front/components/data_source/ConnectorPermissionsModal.tsx",
        "!front/components/data_source/CreateOrUpdateConnectionBigQueryModal.tsx",
        "!front/components/data_source/CreateOrUpdateConnectionSnowflakeModal.tsx",
        "!front/components/data_source/GithubCodeEnableView.tsx",
        "!front/components/data_source/IntercomConfigView.tsx",
        "!front/components/data_source/SetupNotionPrivateIntegrationModal.tsx",
        "!front/components/pages/oauth/OAuthFinalizePage.tsx",
        "!front/components/pages/oauth/OAuthSetupRedirectPage.tsx",
        "!front/components/pages/onboarding/JoinPage.tsx",
        "!front/components/pages/onboarding/VerifyPage.tsx",
        "!front/components/pages/spaces/apps/AppSettingsPage.tsx",
        "!front/components/pod/EditPodTitleDialog.tsx",
        "!front/components/pod/PodPageContent.tsx",
        "!front/components/sandbox/DomainInputForm.tsx",
        "!front/components/sandbox/SandboxEnvVarsSection.tsx",
        "!front/components/skill_builder/SkillBuilder.tsx",
        "!front/components/skill_builder/SkillBuilderAgentFacingDescriptionSection.tsx",
        "!front/components/skill_builder/SkillBuilderInstructionsEditor.tsx",
        "!front/components/skill_builder/SkillBuilderUserFacingDescriptionSection.tsx",
        "!front/components/skill_builder/submitSkillBuilderForm.ts",
        "!front/components/skill_builder/utils.ts",
        "!front/components/spaces/AddConnectionMenu.tsx",
        "!front/components/spaces/AdvancedNotionManagement.tsx",
        "!front/components/spaces/EditSpaceManagedDatasourcesViews.tsx",
        "!front/components/spaces/SpaceCreateAppModal.tsx",
        "!front/components/spaces/SpaceDataSourceViewContentList.tsx",
        "!front/components/spaces/SpaceSearchLayout.tsx",
        "!front/components/spaces/websites/SpaceWebsiteModal.tsx",
        "!front/components/triggers/CreateWebhookSourceWithProviderForm.tsx",
        "!front/components/triggers/WebhookSourceDetailsInfo.tsx",
        "!front/components/triggers/WebhookSourceSheet.tsx",
        "!front/components/workspace/DustMcpServerSettingsSheet.tsx",
        "!front/components/workspace/settings/BotToggle.tsx",
        "!front/hooks/conversations/useBranchConversation.ts",
        "!front/hooks/conversations/useCompactConversation.ts",
        "!front/hooks/conversations/useConversationMarkAsUnread.ts",
        "!front/hooks/conversations/usePlanFile.ts",
        "!front/hooks/useAnalyticsConversation.ts",
        "!front/hooks/useAuditLogsToggle.ts",
        "!front/hooks/useAwuPurchase.ts",
        "!front/hooks/useChangeMembersRoles.ts",
        "!front/hooks/useCreateConversationWithMessage.ts",
        "!front/hooks/useDeleteConversation.ts",
        "!front/hooks/useEditAndValidateAction.ts",
        "!front/hooks/useFileUploaderService.ts",
        "!front/hooks/useGoTemplateFromSearchParam.ts",
        "!front/hooks/useHomepageUseCases.ts",
        "!front/hooks/useMoveConversationOutOfPod.tsx",
        "!front/hooks/useMoveConversationToPod.tsx",
        "!front/hooks/usePokeProductionChecks.ts",
        "!front/hooks/useSkillSuggestions.ts",
        "!front/hooks/useSubmitMessage.ts",
        "!front/hooks/useSuggestionBatches.ts",
        "!front/hooks/useToolFileUpload.ts",
        "!front/hooks/useWorkspaceDefaultAgent.ts",
        "!front/hooks/useWorkspaceSubscriptionCancellation.ts",
        "!front/hooks/useYAMLUpload.ts",
        "!front/lib/swr/agent_memories.ts",
        "!front/lib/swr/agent_suggestions.ts",
        "!front/lib/swr/agent_triggers.ts",
        "!front/lib/swr/assistants.ts",
        "!front/lib/swr/connectors.ts",
        "!front/lib/swr/conversation_selected_spaces.ts",
        "!front/lib/swr/credits.ts",
        "!front/lib/swr/data_classification_labels.ts",
        "!front/lib/swr/data_source_view_documents.ts",
        "!front/lib/swr/data_source_view_tables.ts",
        "!front/lib/swr/discovery.ts",
        "!front/lib/swr/files.ts",
        "!front/lib/swr/frames.ts",
        "!front/lib/swr/github_connection.ts",
        "!front/lib/swr/groups.ts",
        "!front/lib/swr/mcp_servers.ts",
        "!front/lib/swr/memberships.ts",
        "!front/lib/swr/mentions.tsx",
        "!front/lib/swr/model_tiers.ts",
        "!front/lib/swr/notifications.ts",
        "!front/lib/swr/pods.ts",
        "!front/lib/swr/provider_credentials.ts",
        "!front/lib/swr/sandbox.ts",
        "!front/lib/swr/share.ts",
        "!front/lib/swr/skill_configurations.ts",
        "!front/lib/swr/slack_workflows.ts",
        "!front/lib/swr/spaces.ts",
        "!front/lib/swr/tags.ts",
        "!front/lib/swr/upgrade_requests.ts",
        "!front/lib/swr/usage_settings.ts",
        "!front/lib/swr/user.ts",
        "!front/lib/swr/wakeups.ts",
        "!front/lib/swr/webhook_source.ts",
        "!front/lib/swr/workos.ts",
        "!front/lib/swr/workspaces.ts"
      ],
      "plugins": ["./.grit/patterns/noRawApiErrorMessageInUi.grit"]
    },
    {
      "includes": ["marketing/pages/**/*.{js,jsx,ts,tsx}"],
      "plugins": [
        "./.grit/patterns/nextjsPageComponentNaming.grit",
        "./.grit/patterns/nextjsNoDataFetchingInGetssp.grit"
      ]
    },
    {
      "includes": ["front-api/routes/**/*.ts"],
      "plugins": ["./.grit/patterns/noDirectRoleCheck.grit"]
    },
    {
      "includes": [
        "front-api/routes/v1/**/*.ts",
        "front-api/middlewares/**/*.ts",
        "front-api/lib/**/*.ts",
        "!front-api/middlewares/utils.ts",
        "!**/*.test.ts"
      ],
      "plugins": ["./.grit/patterns/noPrivateApiErrorInShared.grit"]
    },
    {
      "includes": [
        "connectors/src/lib/models/**/*.ts",
        "connectors/src/resources/storage/models/**/*.ts",
        "front/lib/models/**/*.ts",
        "front/lib/resources/storage/models/**/*.ts",
        "front/lib/resources/storage/wrappers/**/*.ts",
        "!front/lib/resources/storage/data_types.ts",
        "!connectors/src/resources/storage/data_types.ts"
      ],
      "plugins": [
        "./.grit/patterns/tooLongIndexName.grit",
        "./.grit/patterns/noSequelizeDataTypesImport.grit"
      ]
    },
    {
      "includes": ["cli/dust-cli/**", "sparkle/**"],
      "javascript": {
        "jsxRuntime": "reactClassic"
      }
    },
    {
      "includes": ["front-spa/**", "front/**", "sparkle/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
            "useExhaustiveDependencies": "error"
          }
        }
      }
    },
    {
      "includes": ["front/**/*.{js,jsx,ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": {
              "level": "error",
              "options": { "style": "separatedType" }
            }
          }
        }
      }
    },
    {
      "includes": [
        "front/components/**/*.{js,jsx,ts,tsx}",
        "front/hooks/**/*.{js,jsx,ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Intl": "Format with the functions of @app/lib/i18n/format instead of Intl."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["date-fns", "date-fns-tz"],
                    "importNamePattern": "(format|intlFormat|lightFormat).*",
                    "message": "Format dates with the functions of @app/lib/i18n/format instead of date-fns."
                  },
                  {
                    "group": [
                      "date-fns/format*",
                      "date-fns/intlFormat*",
                      "date-fns/lightFormat",
                      "date-fns-tz/format*"
                    ],
                    "message": "Format dates with the functions of @app/lib/i18n/format instead of date-fns."
                  },
                  {
                    "group": ["@tiptap/react"],
                    "importNamePattern": "EditorContent",
                    "message": "Import EditorContent from @app/components/editor/EditorContent so the editor is masked from session replay."
                  },
                  {
                    "group": ["dayjs", "dayjs/**", "luxon", "luxon/**"],
                    "message": "Format dates with the functions of @app/lib/i18n/format instead of dayjs or luxon."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "front/migrations/**",
        "front/mailing/**",
        "connectors/migrations/**"
      ],
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": [
        "sparkle/**/*.stories.tsx",
        "sparkle/.storybook/**",
        "sparkle/playground/**",
        "sparkle/scripts/**",
        "sparkle/rollup.config.js",
        "sparkle/svgr.config.js",
        "sparkle/postcss.config.js",
        "sparkle/tailwind.config.js",
        "sparkle/svgr-*-template.js"
      ],
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ],
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "html": {
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": false
    }
  },
  "assist": {
    "includes": [
      "sdks/js/**",
      "viz/**",
      "extension/**",
      "cli/dust-cli/**",
      "firebase-functions/**",
      "sparkle/**",
      "connectors/**",
      "front-spa/**",
      "front/**",
      "front-api/**",
      "cli/dust-sandbox/functions-runner/**",
      "cli/dust-sandbox/pod/**"
    ],
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
