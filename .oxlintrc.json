{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import"
  ],
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": [
    "./oxlint-plugins/dust.mjs"
  ],
  "ignorePatterns": [
    "**/.next/**",
    "**/node_modules/**",
    "**/workers-build/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/x/**",
    "**/__snapshots__/**",
    "**/.yalc/**",
    "extension/shared/lib/swr.ts",
    "extension/packages/**",
    "cli/dust-sandbox/functions-runner/runner.js",
    "front/migrations/**",
    "front/mailing/**",
    "connectors/migrations/**",
    "sparkle/**/*.stories.tsx",
    "sparkle/.storybook/**",
    "sparkle/playground/**",
    "sparkle/scripts/**",
    "sparkle/rollup.config.js",
    "sparkle/svgr.config.js",
    "sparkle/postcss.config.js",
    "sparkle/tailwind.config.js",
    "sparkle/svgr-*-template.js",
    "**/*.{mjs,cjs,mts,cts}"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "args": "none",
        "caughtErrors": "all",
        "ignoreRestSiblings": true,
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "curly": [
      "error",
      "all"
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "disallowTypeAnnotations": false,
        "fixStyle": "separate-type-imports"
      }
    ],
    "import/no-cycle": "error",
    "typescript/no-import-type-side-effects": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.{jsx,tsx}"
      ],
      "rules": {
        "dust/noUnusedReactImport": "error"
      }
    },
    {
      "files": [
        "front/**/*.{js,jsx,ts,tsx}",
        "front-api/**/*.{js,jsx,ts,tsx}",
        "connectors/src/**/*.{js,jsx,ts,tsx}",
        "cli/dust-cli/**/*.{js,jsx,ts,tsx}",
        "extension/**/*.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "dust/noBulkLodash": "error",
        "dust/noDirectSparkleNotification": "error"
      }
    },
    {
      "files": [
        "front/**/*.{js,jsx,ts,tsx}",
        "front-api/**/*.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "dust/enforceClientTypesInPublicApi": "error",
        "dust/noClientDeepImports": "error"
      }
    },
    {
      "files": [
        "front/**/*.{js,jsx,ts,tsx}",
        "front-api/**/*.{js,jsx,ts,tsx}"
      ],
      "excludeFiles": [
        "front/lib/api/assistant/conversation/fetch.ts",
        "**/*.{test,spec}.{js,jsx,ts,tsx}",
        "front/tests/**"
      ],
      "rules": {
        "dust/noExpensiveConversationFetch": "error"
      }
    },
    {
      "files": [
        "front/**/*.{js,jsx,ts,tsx}"
      ],
      "excludeFiles": [
        "**/*.{test,spec}.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "dust/noLocaleLessDateTimeFormat": "error",
        "dust/noLocaleLessToLocaleString": "error"
      }
    },
    {
      "files": [
        "front/components/**/*.{js,jsx,ts,tsx}",
        "front/hooks/**/*.{js,jsx,ts,tsx}",
        "front/lib/swr/**/*.{js,jsx,ts,tsx}"
      ],
      "excludeFiles": [
        "**/*.{test,spec}.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "dust/noBareLocaleCompare": "error"
      }
    },
    {
      "files": [
        "front/components/**/*.{js,jsx,ts,tsx}",
        "front/hooks/**/*.{js,jsx,ts,tsx}",
        "front/lib/client/**/*.{js,jsx,ts,tsx}",
        "front/lib/swr/**/*.{js,jsx,ts,tsx}"
      ],
      "excludeFiles": [
        "**/*.{test,spec}.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "dust/noHardcodedEnUsLocale": "error"
      }
    },
    {
      "files": [
        "front-api/**/*.ts"
      ],
      "excludeFiles": [
        "front-api/routes/types.ts"
      ],
      "rules": {
        "dust/noInlineSuccessResponseBody": "error"
      }
    },
    {
      "files": [
        "front-api/**/*.ts",
        "front/lib/api/**/*.ts",
        "front/types/**/*.ts",
        "front/temporal/**/*.ts"
      ],
      "excludeFiles": [
        "front-api/esbuild*.ts",
        "**/*.{test,spec}.{ts,tsx}"
      ],
      "rules": {
        "dust/noClientImportsInServer": "error"
      }
    },
    {
      "files": [
        "front/components/**/*.{js,jsx,ts,tsx}",
        "front/lib/**/*.tsx",
        "front-spa/**/*.{js,jsx,ts,tsx}",
        "sparkle/src/**/*.{js,jsx,ts,tsx}",
        "viz/**/*.{js,jsx,ts,tsx}"
      ],
      "excludeFiles": [
        "**/*.stories.{js,jsx,ts,tsx}",
        "sparkle/src/lottie/**",
        "sparkle/playground/**"
      ],
      "rules": {
        "dust/noCssImportant": "error"
      }
    },
    {
      "files": [
        "front/**/*.{js,jsx,ts,tsx}",
        "front-api/**/*.{js,jsx,ts,tsx}",
        "connectors/src/**/*.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "dust/noRawSql": "error",
        "dust/noUnverifiedWorkspaceBypass": "error"
      }
    },
    {
      "files": [
        "extension/**/*.{js,jsx,ts,tsx}",
        "front-spa/**/*.{js,jsx,ts,tsx}",
        "front/**/*.{js,jsx,ts,tsx}",
        "front-api/**/*.{js,jsx,ts,tsx}",
        "sparkle/**/*.{js,jsx,ts,tsx}"
      ],
      "excludeFiles": [
        "front-api/server.ts",
        "sparkle/.storybook/**",
        "sparkle/playground/**"
      ],
      "rules": {
        "dust/noNextImports": "error"
      }
    },
    {
      "files": [
        "front/**/*.tsx",
        "front-spa/**/*.tsx"
      ],
      "rules": {
        "dust/noSparkleClassInFront": "error"
      }
    },
    {
      "files": [
        "front/**/*.tsx"
      ],
      "rules": {
        "dust/noStringConcatInJsx": "error"
      }
    },
    {
      "files": [
        "front/components/**/*.{ts,tsx}",
        "front/hooks/**/*.{ts,tsx}",
        "front/lib/swr/**/*.{ts,tsx}"
      ],
      "rules": {
        "dust/noRawErrorMessageInUi": "error"
      }
    },
    {
      "files": [
        "front/components/poke/**",
        "front/**/*.test.{ts,tsx}",
        "front/**/*.stories.tsx"
      ],
      "rules": {
        "dust/noRawErrorMessageInUi": "off"
      }
    },
    {
      "files": [
        "front/components/UserMenu.tsx",
        "front/components/actions/mcp/MCPServerDetails.tsx",
        "front/components/actions/mcp/MCPServerSettings.tsx",
        "front/components/actions/mcp/create/ConnectMCPServerDialog.tsx",
        "front/components/actions/mcp/create/CreateMCPServerDialog.tsx",
        "front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx",
        "front/components/actions/mcp/forms/submitCreateMCPServerDialogForm.ts",
        "front/components/agent_builder/AgentBuilder.tsx",
        "front/components/agent_builder/SidekickPanelContext.tsx",
        "front/components/agent_builder/hooks/useAgentPreview.ts",
        "front/components/agent_builder/settings/AgentBuilderDescriptionSection.tsx",
        "front/components/agent_builder/settings/AgentBuilderNameSection.tsx",
        "front/components/agent_builder/settings/utils.ts",
        "front/components/agent_builder/submitAgentBuilderForm.ts",
        "front/components/agent_builder/triggers/TriggerFilterRenderer.tsx",
        "front/components/agent_builder/triggers/schedule/ScheduleEditionScheduler.tsx",
        "front/components/agent_builder/types.ts",
        "front/components/assistant/conversation/AgentMessage.tsx",
        "front/components/assistant/conversation/ConversationContainer.tsx",
        "front/components/assistant/conversation/ConversationViewer.tsx",
        "front/components/assistant/conversation/actions/VisualizationActionIframe.tsx",
        "front/components/assistant/details/AgentDetailsButtonBar.tsx",
        "front/components/credits/UsageUpgradeButton.tsx",
        "front/components/data_source/ConnectorPermissionsModal.tsx",
        "front/components/file_explorer/useMarkdownFileEditor.ts",
        "front/components/pages/oauth/OAuthFinalizePage.tsx",
        "front/components/pages/oauth/OAuthSetupRedirectPage.tsx",
        "front/components/pages/onboarding/JoinPage.tsx",
        "front/components/pages/onboarding/VerifyPage.tsx",
        "front/components/pod/PodFileTabPreview.tsx",
        "front/components/pod/PodPageContent.tsx",
        "front/components/sandbox/DomainInputForm.tsx",
        "front/components/sandbox/SandboxEnvVarsSection.tsx",
        "front/components/skill_builder/SkillBuilder.tsx",
        "front/components/skill_builder/SkillBuilderUserFacingDescriptionSection.tsx",
        "front/components/skill_builder/submitSkillBuilderForm.ts",
        "front/components/skill_builder/utils.ts",
        "front/components/spaces/AddConnectionMenu.tsx",
        "front/components/spaces/AdvancedNotionManagement.tsx",
        "front/components/spaces/EditSpaceManagedDatasourcesViews.tsx",
        "front/components/spaces/websites/SpaceWebsiteModal.tsx",
        "front/components/triggers/CreateWebhookSourceWithProviderForm.tsx",
        "front/components/triggers/WebhookSourceSheet.tsx",
        "front/components/workspace/DustMcpServerSettingsSheet.tsx",
        "front/components/workspace/settings/BotToggle.tsx",
        "front/hooks/conversations/useCompactConversation.ts",
        "front/hooks/useAnalyticsConversation.ts",
        "front/hooks/useAuditLogsToggle.ts",
        "front/hooks/useAwuPurchase.ts",
        "front/hooks/useChangeMembersRoles.ts",
        "front/hooks/useCreateConversationWithMessage.ts",
        "front/hooks/useFileUploaderService.ts",
        "front/hooks/useGoTemplateFromSearchParam.ts",
        "front/hooks/usePokeProductionChecks.ts",
        "front/hooks/useSubmitMessage.ts",
        "front/hooks/useToolFileUpload.ts",
        "front/hooks/useWorkspaceDefaultAgent.ts",
        "front/hooks/useWorkspaceSubscriptionCancellation.ts",
        "front/hooks/useYAMLUpload.ts",
        "front/lib/swr/agent_memories.ts",
        "front/lib/swr/agent_triggers.ts",
        "front/lib/swr/assistants.ts",
        "front/lib/swr/credits.ts",
        "front/lib/swr/data_classification_labels.ts",
        "front/lib/swr/discovery.ts",
        "front/lib/swr/files.ts",
        "front/lib/swr/github_connection.ts",
        "front/lib/swr/groups.ts",
        "front/lib/swr/mcp_servers.ts",
        "front/lib/swr/memberships.ts",
        "front/lib/swr/notifications.ts",
        "front/lib/swr/tags.ts",
        "front/lib/swr/wakeups.ts",
        "front/lib/swr/workspaces.ts"
      ],
      "rules": {
        "dust/noRawErrorMessageInUi": "off"
      }
    },
    {
      "files": [
        "marketing/pages/**/*.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "dust/nextjsPageComponentNaming": "error"
      }
    },
    {
      "files": [
        "front-api/routes/**/*.ts"
      ],
      "rules": {
        "dust/noDirectRoleCheck": "error"
      }
    },
    {
      "files": [
        "connectors/src/lib/models/**/*.ts",
        "connectors/src/resources/storage/models/**/*.ts",
        "front/lib/models/**/*.ts",
        "front/lib/resources/storage/models/**/*.ts",
        "front/lib/resources/storage/wrappers/**/*.ts"
      ],
      "excludeFiles": [
        "front/lib/resources/storage/data_types.ts",
        "connectors/src/resources/storage/data_types.ts"
      ],
      "rules": {
        "dust/tooLongIndexName": "warn",
        "dust/noSequelizeDataTypesImport": "error"
      }
    },
    {
      "files": [
        "front-spa/**",
        "front/**",
        "sparkle/**"
      ],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error"
      }
    },
    {
      "files": [
        "front/**/*.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "import/consistent-type-specifier-style": [
          "error",
          "prefer-top-level"
        ]
      }
    },
    {
      "files": [
        "front/components/**/*.{js,jsx,ts,tsx}",
        "front/hooks/**/*.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Intl",
            "message": "Format with the functions of @app/lib/i18n/format instead of Intl."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "date-fns",
                  "date-fns-tz"
                ],
                "importNamePattern": "(format|intlFormat|lightFormat).*",
                "message": "Format dates with the functions of @app/lib/i18n/format instead of date-fns."
              },
              {
                "group": [
                  "date-fns/format*",
                  "date-fns/intlFormat*",
                  "date-fns/lightFormat",
                  "date-fns-tz/format*"
                ],
                "message": "Format dates with the functions of @app/lib/i18n/format instead of date-fns."
              },
              {
                "group": [
                  "@tiptap/react"
                ],
                "importNamePattern": "EditorContent",
                "message": "Import EditorContent from @app/components/editor/EditorContent so the editor is masked from session replay."
              },
              {
                "group": [
                  "dayjs",
                  "dayjs/**",
                  "luxon",
                  "luxon/**"
                ],
                "message": "Format dates with the functions of @app/lib/i18n/format instead of dayjs or luxon."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "cli/dust-cli/**",
        "sparkle/**"
      ],
      "rules": {
        "no-unused-vars": [
          "error",
          {
            "varsIgnorePattern": "^(_|React$)",
            "args": "none",
            "caughtErrors": "all",
            "ignoreRestSiblings": true,
            "caughtErrorsIgnorePattern": "^_"
          }
        ]
      }
    }
  ]
}
