#!/usr/bin/env bash
# Usage: impls/henry/build. Builds x/henry/dfs for linux/amd64, pushes the server image and copies
# dfs-mount to .state/impls/henry/<tag>/. Prints the tag. Tag = last commit touching x/henry/dfs,
# suffixed with -dirty when the tree has local changes.
source "$(dirname "$0")/../../bin/lib.sh"
require_dust_dev

SRC="$(cd "$BENCH_DIR/../dfs" && pwd)"
TAG="$(git -C "$SRC" log -1 --format=%h -- .)"
[[ -z "$(git -C "$SRC" status --porcelain -- .)" ]] || TAG="$TAG-dirty"
IMAGE="$REGISTRY/henry-dfs:$TAG"
OUT="$STATE_DIR/impls/henry/$TAG"

use_docker
log "building $IMAGE"
docker buildx build --platform linux/amd64 --build-arg "FDB_VERSION=$FDB_VERSION" \
  -f "$BENCH_DIR/impls/henry/Dockerfile" -t "$IMAGE" --load "$SRC"
docker push -q "$IMAGE"

mkdir -p "$OUT"
container="$(docker create --platform linux/amd64 "$IMAGE")"
docker cp -q "$container:/usr/local/bin/dfs-mount" "$OUT/dfs-mount"
docker rm "$container" >/dev/null
echo "$IMAGE" >"$OUT/image"
ln -sfn "$TAG" "$STATE_DIR/impls/henry/latest"
log "built $IMAGE, dfs-mount in $OUT"
echo "$TAG"
