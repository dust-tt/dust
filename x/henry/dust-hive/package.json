{
  "name": "dust-hive",
  "version": "0.1.0",
  "description": "CLI tool for isolated Dust development environments",
  "type": "module",
  "bin": {
    "dust-hive": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt .",
    "format": "oxfmt .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "cac": "^6.7.14",
    "yaml": "^2.3.0",
    "zod": "^4.3.5"
  }
}
