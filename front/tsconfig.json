{
  "compilerOptions": {
    "checkers": 1,
    "target": "es6",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "noErrorTruncation": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@app/*": [
        "./*"
      ]
    }
  },
  "include": [
    "global.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.jsx",
    "**/*.js",
    "**/*.mjs",
    "./.eslintrc.js",
  ],
  "exclude": [
    "node_modules",
    "dist",
    "app",
    "migrations/20250214_backfill_gong_modjo_default_configurations.ts",
    "migrations/20250306_gong_labs_to_connector.ts",
    "migrations/20250321_startstop_relocated_transcripts_workflows.ts",
    "migrations/20260209_disable_transcripts_on_connected_datasources.ts"
  ]
}