#: front/components/navigation/AppStatusBanner.tsx
msgid "Check our <0>status page</0> for updates."
msgstr "Check our <0>status page</0> for updates."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace is not operational"
msgstr "Your workspace is not operational"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Model providers"
msgstr "Model providers"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Contact your workspace admin."
msgstr "Contact your workspace admin."

#: front/components/navigation/AppStatusBanner.tsx
msgid "No provider credentials configured. Please set up at least one model provider."
msgstr "No provider credentials configured. Please set up at least one model provider."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Please set up your OpenAI credentials."
msgstr "Please set up your OpenAI credentials."

#: front/components/navigation/AppStatusBanner.tsx
msgid "The following model providers have invalid credentials: {invalidProviderNames}."
msgstr "The following model providers have invalid credentials: {invalidProviderNames}."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your payment has failed!"
msgstr "Your payment has failed!"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Please make sure to update your payment method in the Admin section to maintain access to your workspace. We will retry in a few days."
msgstr "Please make sure to update your payment method in the Admin section to maintain access to your workspace. We will retry in a few days."

#: front/components/navigation/AppStatusBanner.tsx
msgid "After 3 attempts, your workspace will be downgraded to the free plan. Connections will be deleted and members will be revoked. Details <0>here</0>."
msgstr "After 3 attempts, your workspace will be downgraded to the free plan. Connections will be deleted and members will be revoked. Details <0>here</0>."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Manage credits"
msgstr "Manage credits"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace is out of credits"
msgstr "Your workspace is out of credits"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace has used all its credits"
msgstr "Your workspace has used all its credits"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace has run out of credits. Agents are blocked until you top up."
msgstr "Your workspace has run out of credits. Agents are blocked until you top up."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace has used all of its included credits and is now billed pay-as-you-go. Top up to avoid overage charges."
msgstr "Your workspace has used all of its included credits and is now billed pay-as-you-go. Top up to avoid overage charges."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Programmatic API cap reached"
msgstr "Programmatic API cap reached"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Programmatic API cap at 80%"
msgstr "Programmatic API cap at 80%"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace has exhausted its monthly programmatic API credit cap. Programmatic API calls are blocked until the billing cycle resets or the cap is raised."
msgstr "Your workspace has exhausted its monthly programmatic API credit cap. Programmatic API calls are blocked until the billing cycle resets or the cap is raised."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace has used 80% of its monthly programmatic API credit cap. Consider raising the cap to avoid interruptions."
msgstr "Your workspace has used 80% of its monthly programmatic API credit cap. Consider raising the cap to avoid interruptions."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Manage usage"
msgstr "Manage usage"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your credit balance is running low"
msgstr "Your credit balance is running low"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace's remaining credit balance has dropped below the threshold you set. Top up to avoid running out of credits."
msgstr "Your workspace's remaining credit balance has dropped below the threshold you set. Top up to avoid running out of credits."

