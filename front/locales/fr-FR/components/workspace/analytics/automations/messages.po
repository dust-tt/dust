#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Allow a Slack workflow"
msgstr "Autoriser un workflow Slack"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Anyone who can run the workflow in Slack will be able to summon agents through it, guests included."
msgstr "Toute personne pouvant exécuter le workflow dans Slack pourra solliciter des agents par son intermédiaire, invités compris."

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Workflow name"
msgstr "Nom du workflow"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "e.g. Weekly report"
msgstr "ex. : Rapport hebdomadaire"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "The sender name shown in Slack on the workflow's messages. It has to match exactly, spelling and capitalization included."
msgstr "Le nom d’expéditeur affiché dans Slack sur les messages du workflow. Il doit correspondre exactement, orthographe et majuscules comprises."

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Spaces it can reach"
msgstr "Espaces accessibles"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Add spaces"
msgstr "Ajouter des espaces"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Search spaces"
msgstr "Rechercher des espaces"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "No space found"
msgstr "Aucun espace trouvé"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "The workflow always reaches agents shared in {GLOBAL_SPACE_NAME}. Add spaces to let it summon their agents too."
msgstr "Le workflow a toujours accès aux agents partagés dans {GLOBAL_SPACE_NAME}. Ajoutez des espaces pour qu’il puisse aussi solliciter leurs agents."

