msgid "Go to payment"
msgstr "Passer au paiement"

#: front/components/workspace/BuyCreditDialog.tsx
msgid "Purchase credits"
msgstr "Acheter des crédits"

#: front/components/workspace/BuyCreditDialog.tsx
