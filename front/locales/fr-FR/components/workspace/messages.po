#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "Archive unused agents"
msgstr "Archiver les agents inutilisés"

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "Choose how long an agent has to go unmentioned to be archived."
msgstr "Choisissez combien de temps un agent doit rester sans mention pour être archivé."

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "Review what would be archived before archiving it."
msgstr "Vérifiez ce qui serait archivé avant de l’archiver."

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "Unmentioned for"
msgstr "Sans mention depuis"

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "days"
msgstr "jours"

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "Between {MIN_INACTIVITY_THRESHOLD_DAYS} and {MAX_INACTIVITY_THRESHOLD_DAYS}"
msgstr "Entre {MIN_INACTIVITY_THRESHOLD_DAYS} et {MAX_INACTIVITY_THRESHOLD_DAYS}"

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "Nothing is archived until you have seen the count. Agents with a schedule or a pending wake-up are excluded."
msgstr "Rien n’est archivé avant que vous ayez vu le décompte. Les agents planifiés ou avec un réveil en attente sont exclus."

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "{eligibleCount, plural, one {# agent would be archived} other {# agents would be archived}}"
msgstr "{eligibleCount, plural, one {# agent serait archivé} other {# agents seraient archivés}}"

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "No agent would be archived"
msgstr "Aucun agent ne serait archivé"

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "Nobody has mentioned them since {cutoffDate}."
msgstr "Personne ne les a mentionnés depuis le {cutoffDate}."

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "No agent has gone unmentioned since {cutoffDate}."
msgstr "Tous les agents ont été mentionnés depuis le {cutoffDate}."

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "{protectedCount, plural, one {# agent with a schedule or a pending wake-up.} other {# agents with a schedule or a pending wake-up.}} Agents with a schedule or a pending wake-up are excluded from archival."
msgstr "{protectedCount, plural, one {# agent planifié ou avec un réveil en attente.} other {# agents planifiés ou avec un réveil en attente.}} Les agents planifiés ou avec un réveil en attente sont exclus de l’archivage."

#: front/components/workspace/ArchiveUnusedAgentsModal.tsx
msgid "Archiving will cancel their pending runs and suspend their editors' access. It can be undone one agent at a time."
msgstr "L’archivage annulera leurs exécutions en attente et suspendra l’accès de leurs éditeurs. Il peut être annulé agent par agent."

