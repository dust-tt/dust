#: front/components/workspace/settings/ConversationExternalNotificationsToggle.tsx
msgid "Email and Slack notifications"
msgstr "Notifications par e-mail et Slack"

#: front/components/workspace/settings/ConversationExternalNotificationsToggle.tsx
msgid "Whether members can receive conversation notifications by email or Slack. In-app Dust notifications are not affected."
msgstr "Détermine si les membres peuvent recevoir les notifications de conversation par e-mail ou Slack. Les notifications dans Dust ne sont pas concernées."

#: front/components/workspace/settings/DustMcpServerSettingsItem.tsx
msgid "MCP server"
msgstr "Serveur MCP"

#: front/components/workspace/settings/DustMcpServerSettingsItem.tsx
