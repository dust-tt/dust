#: front/components/workspace/settings/InactiveAgentArchival.tsx
msgid "Archive unused agents"
msgstr "Archiver les agents inutilisés"

#: front/components/workspace/settings/InactiveAgentArchival.tsx
msgid "Automatically archive unused agents. Or <0>archive them once</0>."
msgstr "Archiver automatiquement les agents inutilisés. Ou <0>les archiver une seule fois</0>."

#: front/components/workspace/settings/InactiveAgentArchival.tsx
msgid "Inactivity threshold"
msgstr "Seuil d’inactivité"

#: front/components/workspace/settings/InactiveAgentArchival.tsx
msgid "How long an agent has to go unmentioned before it's archived. Agents with a schedule are excluded."
msgstr "Durée pendant laquelle un agent doit rester sans mention avant d’être archivé. Les agents planifiés sont exclus."

#: front/components/workspace/settings/InactiveAgentArchival.tsx
msgid "Between {MIN_INACTIVITY_THRESHOLD_DAYS} and {MAX_INACTIVITY_THRESHOLD_DAYS}"
msgstr "Entre {MIN_INACTIVITY_THRESHOLD_DAYS} et {MAX_INACTIVITY_THRESHOLD_DAYS}"

#: front/components/workspace/settings/InactiveAgentArchival.tsx
msgid "days"
msgstr "jours"

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Workspace members only"
msgstr "Membres du workspace uniquement"

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Frames can only be viewed by workspace members"
msgstr "Les Frames ne sont visibles que par les membres du workspace"

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Members + email invites"
msgstr "Membres + invitations par e-mail"

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Frames can be shared with workspace members or via email invite"
msgstr "Les Frames peuvent être partagés avec les membres du workspace ou via une invitation par e-mail"

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "No restrictions"
msgstr "Aucune restriction"

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Members can share frames publicly, with the workspace, or via email invite"
msgstr "Les membres peuvent partager les Frames publiquement, avec le workspace ou via une invitation par e-mail"

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Frame sharing"
msgstr "Partage des Frames"

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Whether frames are shareable outside the workspace"
msgstr "Détermine si les Frames peuvent être partagés en dehors du workspace"

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Block external access"
msgstr "Bloquer l’accès externe"

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Restrict Frame sharing"
msgstr "Restreindre le partage des Frames"

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Non-workspace members with email invites will lose access to all frames in this workspace. Their invites are preserved and will resume if you change this setting later."
msgstr "Les personnes extérieures au workspace invitées par e-mail perdront l’accès à tous les Frames de ce workspace. Leurs invitations sont conservées et redeviendront actives si vous modifiez ce paramètre plus tard."

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Public links will also stop working."
msgstr "Les liens publics cesseront également de fonctionner."

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "This will revoke public access to all currently shared frames in this workspace. Existing public links will stop working."
msgstr "Cela révoquera l’accès public à tous les Frames actuellement partagés dans ce workspace. Les liens publics existants cesseront de fonctionner."

#: front/components/workspace/settings/InteractiveContentSharingToggle.tsx
msgid "Restrict sharing"
msgstr "Restreindre le partage"

#: front/components/workspace/settings/MessagingAppToggles.tsx
msgid "Slack Bot"
msgstr "Bot Slack"

#: front/components/workspace/settings/MessagingAppToggles.tsx
