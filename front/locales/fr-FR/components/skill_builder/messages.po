msgid "They can all find it via the composer and agent builder."
msgstr "Ils peuvent tous la trouver via la zone de saisie et l’éditeur d’agent."

#: front/components/skill_builder/SkillBuilderAvailabilityMessage.tsx
#: front/components/skill_builder/SkillBuilderAvailabilitySection.tsx
msgid "All members can find it via the composer and agent builder"
msgstr "Tous les membres peuvent la trouver via la zone de saisie et l’éditeur d’agent"

