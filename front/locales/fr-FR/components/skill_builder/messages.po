msgid "Only members of all the following can view and use this skill: {spaceLinks}."
msgstr "Seuls les membres de tous les espaces suivants peuvent voir et utiliser cette compétence : {spaceLinks}."

#: front/components/skill_builder/SkillBuilderAvailabilityMessage.tsx
msgid "Only members of {spaceLinks} can view and use this skill."
msgstr "Seuls les membres de {spaceLinks} peuvent voir et utiliser cette compétence."

#: front/components/skill_builder/SkillBuilderAvailabilityMessage.tsx
msgid "Who is this skill available for?"
msgstr "Qui peut accéder à cette compétence ?"

#: front/components/skill_builder/SkillBuilderAvailabilityMessage.tsx
msgid "Among them:"
msgstr "Parmi eux :"

#: front/components/skill_builder/SkillBuilderAvailabilitySection.tsx
msgid "Editors only"
msgstr "Éditeurs uniquement"

#: front/components/skill_builder/SkillBuilderAvailabilitySection.tsx
msgid "Members"
msgstr "Membres"

#: front/components/skill_builder/SkillBuilderAvailabilitySection.tsx
msgid "Members and agents"
msgstr "Membres et agents"

#: front/components/skill_builder/SkillBuilderAvailabilitySection.tsx
msgid "Available to all members and agents with Discover Skills"
msgstr "Disponible pour tous les membres et les agents dotés de Discover Skills"

#: front/components/skill_builder/SkillBuilderAvailabilitySection.tsx
msgid "You don’t have permission to change this skill’s availability"
msgstr "Vous n’avez pas l’autorisation de modifier la disponibilité de cette compétence"

#: front/components/skill_builder/SkillBuilderAvailabilitySection.tsx
msgid "You don’t have permission to change the availability of an auto-discoverable skill"
msgstr "Vous n’avez pas l’autorisation de modifier la disponibilité d’une compétence détectable automatiquement"

#: front/components/skill_builder/SkillBuilderAvailabilitySection.tsx
#: front/components/skill_builder/SuggestedSkillAvailability.tsx
msgid "Availability"
msgstr "Disponibilité"

#: front/components/skill_builder/SkillBuilderAvailabilitySection.tsx
msgid "You don’t have permission to make skills auto-discoverable"
msgstr "Vous n’avez pas l’autorisation de rendre des compétences détectables automatiquement"

#: front/components/skill_builder/SkillBuilderAvailabilitySection.tsx
msgid "This skill has workspace-wide effects"
msgstr "Cette compétence a des effets sur tout le workspace"

