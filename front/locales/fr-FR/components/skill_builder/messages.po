#: front/components/skill_builder/SkillBuilderEnableSuggestionsSection.tsx
msgid "Self-improve"
msgstr "Auto-amélioration"

#: front/components/skill_builder/SkillBuilderEnableSuggestionsSection.tsx
msgid "Dust will analyze how this skill is used and suggest improvements to its instructions over time."
msgstr "Dust analysera l’utilisation de cette compétence et suggérera au fil du temps des améliorations de ses instructions."

#: front/components/skill_builder/SkillBuilderFilesSection.tsx
msgid "Duplicate files skipped."
msgstr "Fichiers en double ignorés."

#: front/components/skill_builder/SkillBuilderFilesSection.tsx
msgid "Already attached: {duplicateFileNames}"
msgstr "Déjà joints : {duplicateFileNames}"

#: front/components/skill_builder/SkillBuilderFilesSection.tsx
msgid "Upload files"
