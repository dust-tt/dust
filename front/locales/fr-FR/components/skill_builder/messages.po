msgid "Only skill editors can save changes."
msgstr "Seuls les éditeurs de la compétence peuvent enregistrer les modifications."

#: front/components/skill_builder/SkillBuilder.tsx
msgid "Edit skill {skillName}"
msgstr "Modifier la compétence {skillName}"

