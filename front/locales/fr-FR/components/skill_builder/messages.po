msgid "This skill was automatically generated based on your workspace's configuration. We recommend reviewing and editing it to match your specific needs before saving."
msgstr "Cette compétence a été générée automatiquement à partir de la configuration de votre workspace. Nous vous recommandons de la vérifier et de l’adapter à vos besoins avant de l’enregistrer."

#: front/components/skill_builder/SkillBuilder.tsx
msgid "Some skill editors cannot access some of the restricted spaces"
msgstr "Certains éditeurs de la compétence n’ont pas accès à certains espaces restreints"

#: front/components/skill_builder/SkillBuilder.tsx
msgid "Cancel"
msgstr "Annuler"

#: front/components/skill_builder/SkillBuilder.tsx
msgid "Saving..."
msgstr "Enregistrement…"

#: front/components/skill_builder/SkillBuilder.tsx
msgid "Save"
msgstr "Enregistrer"

#: front/components/skill_builder/SkillBuilderAgentFacingDescriptionSection.tsx
#: front/components/skill_builder/SkillSuggestionCard.tsx
msgid "When to use this skill"
msgstr "Quand utiliser cette compétence"

#: front/components/skill_builder/SkillBuilderAgentFacingDescriptionSection.tsx
msgid "Tell the agent when it should use this skill."
msgstr "Indiquez à l’agent quand utiliser cette compétence."

#: front/components/skill_builder/SkillBuilderAgentFacingDescriptionSection.tsx
msgid "Restore description"
msgstr "Restaurer la description"

#: front/components/skill_builder/SkillBuilderAvailabilityMessage.tsx
msgid "Only editors can find it via the composer and agent builder"
msgstr "Seuls les éditeurs peuvent la trouver via la zone de saisie et l’éditeur d’agent"

