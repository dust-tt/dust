#: front/components/skill_builder/SkillBuilderInstructionsSection.tsx
msgctxt "button, insert content in the instructions"
msgid "Insert"
msgstr "Insérer"

#: front/components/skill_builder/SkillBuilderInstructionsSection.tsx
msgid "This skill is noticeably large"
msgstr "Cette compétence est particulièrement volumineuse"

