#: front/components/skill_builder/SkillBuilderFilesSection.tsx
#: front/components/skill_builder/SuggestedSkillFiles.tsx
msgid "Files"
msgstr "Fichiers"

#: front/components/skill_builder/SkillBuilderFilesSection.tsx
msgid "Add files that will be available to the skill at runtime. Templates, schemas, scripts, or reference materials."
