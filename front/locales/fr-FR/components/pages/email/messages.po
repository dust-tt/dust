msgid "The tool has been approved and will now execute."
msgstr "L’outil a été approuvé et va maintenant s’exécuter."

#: front/components/pages/email/ValidationPage.tsx
msgid "Tool rejected"
msgstr "Outil refusé"

#: front/components/pages/email/ValidationPage.tsx
msgid "The tool has been rejected and will not execute."
msgstr "L’outil a été refusé et ne s’exécutera pas."

#: front/components/pages/email/ValidationPage.tsx
msgid "Already validated"
msgstr "Déjà validé"

#: front/components/pages/email/ValidationPage.tsx
msgid "This tool has already been approved or rejected."
msgstr "Cet outil a déjà été approuvé ou refusé."
