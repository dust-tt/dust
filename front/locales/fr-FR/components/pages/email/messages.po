msgid "This approval link has expired. Please request a new validation email or approve the tool directly in Dust."
msgstr "Ce lien d’approbation a expiré. Demandez un nouvel e-mail de validation ou approuvez l’outil directement dans Dust."

#: front/components/pages/email/ValidationPage.tsx
msgid "Invalid link"
msgstr "Lien non valide"

