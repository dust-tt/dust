msgstr "Impossible d’envoyer le code"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Please enter the full 6-digit code."
msgstr "Saisissez le code complet à 6 chiffres."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Invalid code"
msgstr "Code non valide"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Network error. Please try again."
msgstr "Erreur réseau. Réessayez."

