msgstr "Contactez l’administrateur de votre workspace pour mettre à jour votre rôle."

#: front/components/pages/onboarding/LoginErrorPage.tsx
msgid "Please contact us at support@dust.tt for assistance."
msgstr "Contactez-nous à support@dust.tt pour obtenir de l’aide."

#: front/components/pages/onboarding/LoginErrorPage.tsx
msgid "Back to homepage"
msgstr "Retour à l’accueil"

#: front/components/pages/onboarding/NoWorkspacePage.tsx
msgid "Sign out"
msgstr "Se déconnecter"

