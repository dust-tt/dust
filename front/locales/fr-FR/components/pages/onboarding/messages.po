#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Phone number"
msgstr "Numéro de téléphone"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "To start your free trial, we need to verify your account with an SMS code."
msgstr "Pour démarrer votre essai gratuit, nous devons vérifier votre compte avec un code SMS."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Your number will only be used for this verification."
msgstr "Votre numéro sera utilisé uniquement pour cette vérification."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Sending..."
msgstr "Envoi…"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Send code"
msgstr "Envoyer le code"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Enter verification code"
msgstr "Saisissez le code de vérification"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "A verification code has been sent to <0>{maskedPhone}</0>"
msgstr "Un code de vérification a été envoyé au <0>{maskedPhone}</0>"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Back"
msgstr "Retour"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Resend code ({resendCooldown}s)"
msgstr "Renvoyer le code ({resendCooldown} s)"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Resend code"
msgstr "Renvoyer le code"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Verifying..."
msgstr "Vérification…"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Verify now"
