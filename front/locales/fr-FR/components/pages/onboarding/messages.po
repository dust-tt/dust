msgstr "Cliquez ci-dessous pour activer votre abonnement gratuit."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Activating..."
msgstr "Activation…"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Activate trial"
msgstr "Activer l’essai"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "You're in. Welcome to Dust."
msgstr "C’est parti. Bienvenue sur Dust."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "You've got <0>{formattedCredits} credits</0> to explore, they never expire, so take your time. Let's put them to work."
msgstr "Vous disposez de <0>{formattedCredits} crédits</0> pour explorer. Ils n’expirent jamais, prenez votre temps. Mettons-les à profit."
