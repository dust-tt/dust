#: front/components/app/ModelPicker.tsx
msgid "Setup provider"
msgstr "Configurer un fournisseur"

#: front/components/app/ModelPicker.tsx
msgid "No provider available"
msgstr "Aucun fournisseur disponible"

#: front/components/app/ModelPicker.tsx
