msgid "Create new dataset"
msgstr "Créer un jeu de données"

#: front/components/app/DatasetView.tsx
msgid "A dataset with the same name already exists"
msgstr "Un jeu de données portant ce nom existe déjà"

#: front/components/app/DatasetView.tsx
msgid "Dataset name must only contain letters, numbers, and the characters `._-`"
msgstr "Le nom du jeu de données ne doit contenir que des lettres, des chiffres et les caractères `._-`"

#: front/components/app/DatasetView.tsx
msgid "Key already exists"
msgstr "Cette clé existe déjà"

#: front/components/app/DatasetView.tsx
msgid "Please choose a different key"
msgstr "Choisissez une autre clé."

#: front/components/app/DatasetView.tsx
msgid "Error reading JSONL file."
msgstr "Erreur lors de la lecture du fichier JSONL."

#: front/components/app/DatasetView.tsx
msgid "Error parsing JSONL line {lineIndex}: {parseError}"
msgstr "Erreur lors de l’analyse de la ligne JSONL {lineIndex} : {parseError}"

#: front/components/app/DatasetView.tsx
msgid "Dataset size is currently limited to 256 entries"
msgstr "La taille d’un jeu de données est actuellement limitée à 256 entrées"

#: front/components/app/DatasetView.tsx
msgid "JSONL upload size is currently limited to 512KB"
msgstr "La taille des fichiers JSONL importés est actuellement limitée à 512 Ko"

#: front/components/app/DatasetView.tsx
msgid "Dataset name"
msgstr "Nom du jeu de données"

#: front/components/app/DatasetView.tsx
msgid "Description"
msgstr "Description"

#: front/components/app/DatasetView.tsx
msgid "Optional"
msgstr "Facultatif"

#: front/components/app/DatasetView.tsx
msgid "Schema"
msgstr "Schéma"

#: front/components/app/DatasetView.tsx
msgid "Set the properties and types to ensure your dataset is valid when you update it. The properties descriptions are used to generate the inputs to your app when run from an agent."
msgstr "Définissez les propriétés et leurs types pour garantir la validité de votre jeu de données lors de ses mises à jour. Les descriptions des propriétés servent à générer les entrées de votre app lorsqu’elle est exécutée depuis un agent."

#: front/components/app/DatasetView.tsx
msgid "(JSON inputs are only supported when using Dust Apps through the API and not through agent actions)"
msgstr "(Les entrées JSON ne sont prises en charge que lorsque les apps Dust sont utilisées via l’API, et non via les actions d’agent)"

#: front/components/app/DatasetView.tsx
msgid "Delete property"
msgstr "Supprimer la propriété"

#: front/components/app/DatasetView.tsx
msgid "Add property after"
msgstr "Ajouter une propriété après"

#: front/components/app/DatasetView.tsx
msgid "Property description"
msgstr "Description de la propriété"

#: front/components/app/DatasetView.tsx
msgid "Input data for test-running your app using the 'RUN' button."
msgstr "Données d’entrée pour tester votre app avec le bouton « RUN »."

#: front/components/app/DatasetView.tsx
msgid "Running this app from the API or an agent will use the input data provided at runtime."
msgstr "Lorsque cette app est exécutée depuis l’API ou un agent, ce sont les données d’entrée fournies à l’exécution qui sont utilisées."

#: front/components/app/DatasetView.tsx
msgid "Data"
msgstr "Données"

#: front/components/app/DatasetView.tsx
msgid "Add and edit your dataset entries below. You can insert or remove entries using buttons on the right."
msgstr "Ajoutez et modifiez les entrées de votre jeu de données ci-dessous. Vous pouvez insérer ou supprimer des entrées avec les boutons à droite."

#: front/components/app/DatasetView.tsx
msgid "New entry"
msgstr "Nouvelle entrée"

