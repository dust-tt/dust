#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Error sending email"
msgstr "Erreur lors de l’envoi de l’e-mail"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "An unexpected error occurred while sending email."
msgstr "Une erreur inattendue s’est produite lors de l’envoi de l’e-mail."

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Email sent!"
msgstr "E-mail envoyé !"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Your request was sent to {adminFullName}"
msgstr "Votre demande a été envoyée à {adminFullName}"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "An unexpected error occurred while sending the request."
msgstr "Une erreur inattendue s’est produite lors de l’envoi de la demande."

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Request tool"
msgstr "Demander un outil"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Requesting access to {selectedToolName}"
msgstr "Demande d’accès à {selectedToolName}"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Requesting access"
msgstr "Demande d’accès"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "There are no extra tools set up that you can request access to. Ask an admin to set one up."
msgstr "Aucun outil supplémentaire n’est configuré pour que vous puissiez en demander l’accès. Demandez à un administrateur d’en configurer un."

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Which tools you want to get access to?"
msgstr "À quels outils souhaitez-vous accéder ?"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Pick tools"
msgstr "Choisir des outils"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "{adminName} is the administrator for the {selectedToolName} tool within Dust. Send an email to {adminName}, explaining your request."
msgstr "{adminName} est l’administrateur de l’outil {selectedToolName} dans Dust. Envoyez un e-mail à {adminName} pour expliquer votre demande."

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Hello"
msgstr "Bonjour"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Cancel"
msgstr "Annuler"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Send"
msgstr "Envoyer"
