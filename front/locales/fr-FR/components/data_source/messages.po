msgstr "Nous avons du mal à récupérer vos données depuis {providerName}. La synchronisation reprendra automatiquement une fois le problème résolu."

#: front/components/data_source/DataSourceSyncChip.tsx
msgid "Synchronization delayed"
msgstr "Synchronisation retardée"

#: front/components/data_source/DataSourceSyncChip.tsx
msgid "The synchronization failed because too many excessively large pages were found."
msgstr "La synchronisation a échoué, car trop de pages excessivement volumineuses ont été trouvées."

#: front/components/data_source/DataSourceSyncChip.tsx
msgid "Pages too large"
msgstr "Pages trop volumineuses"

#: front/components/data_source/DataSourceSyncChip.tsx
