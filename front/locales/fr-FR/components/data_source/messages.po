#: front/components/data_source/ConnectorPermissionsModal.tsx
msgid "Migration required"
msgstr "Migration requise"

#: front/components/data_source/ConnectorPermissionsModal.tsx
msgid "You are using a legacy way to connect your Slack workspace to Dust. Starting December 2025, all Slack connections require customers to create their own Slack app. This change ensures optimal performance and reliable real-time syncing."
msgstr "Vous utilisez une ancienne méthode pour connecter votre workspace Slack à Dust. Depuis décembre 2025, toutes les connexions Slack nécessitent que les clients créent leur propre app Slack. Ce changement garantit des performances optimales et une synchronisation en temps réel fiable."

#: front/components/data_source/ConnectorPermissionsModal.tsx
msgid "Please follow the instructions of the section <0>\"Setting up the Connection\"</0> in our <1>official documentation</1> and enter your credentials below to <2>complete the migration before March 3, 2026</2>."
msgstr "Suivez les instructions de la section <0>« Setting up the Connection »</0> de notre <1>documentation officielle</1> et saisissez vos identifiants ci-dessous pour <2>terminer la migration avant le 3 mars 2026</2>."

#: front/components/data_source/ConnectorPermissionsModal.tsx
msgid "Important"
msgstr "Important"

#: front/components/data_source/ConnectorPermissionsModal.tsx
msgid "<0>Editing</0> can break the existing data structure in Dust and Agents using them."
msgstr "<0>Toute modification</0> peut endommager la structure de données existante dans Dust et les agents qui l’utilisent."

#: front/components/data_source/ConnectorPermissionsModal.tsx
msgid "Read our <0>Playbook</0>."
msgstr "Consultez notre <0>guide pratique</0>."

#: front/components/data_source/ConnectorPermissionsModal.tsx
msgid "Connection owner"
msgstr "Propriétaire de la connexion"

#: front/components/data_source/ConnectorPermissionsModal.tsx
msgid "Authorized with Microsoft account <0>{microsoftAccount}</0>."
msgstr "Autorisée avec le compte Microsoft <0>{microsoftAccount}</0>."

