#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Gong configuration updated"
msgstr "Configuration Gong mise à jour"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Participant filter successfully updated."
msgstr "Le filtre de participants a bien été mis à jour."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Failed to update Gong configuration"
msgstr "Impossible de mettre à jour la configuration Gong"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Participant filter"
msgstr "Filtre de participants"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "All participants"
msgstr "Tous les participants"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Saving..."
msgstr "Enregistrement…"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Save"
msgstr "Enregistrer"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Filter calls by Gong permission profile."
msgstr "Filtrez les appels par profil d’autorisations Gong."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Only calls involving users listed in the selected profile's \"Specific Teams\" section will be synced."
msgstr "Seuls les appels impliquant des utilisateurs listés dans la section « Specific Teams » du profil sélectionné seront synchronisés."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Changing the filter only affects future syncs."
msgstr "Modifier le filtre n’affecte que les synchronisations futures."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Invalid retention period"
msgstr "Durée de conservation non valide"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Retention period must be a positive integer or empty for no limit."
msgstr "La durée de conservation doit être un entier positif, ou vide pour ne fixer aucune limite."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Retention period successfully updated."
msgstr "La durée de conservation a bien été mise à jour."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Trackers synchronization successfully updated."
msgstr "La synchronisation des trackers a bien été mise à jour."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Accounts synchronization successfully updated."
msgstr "La synchronisation des comptes a bien été mise à jour."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Exclude keywords successfully updated."
msgstr "Les mots-clés exclus ont bien été mis à jour."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Configuration successfully updated."
msgstr "La configuration a bien été mise à jour."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "All Gong data will sync automatically"
msgstr "Toutes les données Gong seront synchronisées automatiquement"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "All your Gong resources will sync automatically."
msgstr "Toutes vos ressources Gong seront synchronisées automatiquement."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Selecting items individually is not available."
msgstr "La sélection individuelle des éléments n’est pas disponible."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Exclude calls by title keywords"
msgstr "Exclure des appels selon les mots-clés du titre"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "e.g. internal, test, demo"
msgstr "par ex. interne, test, démo"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Exclude calls whose title contains these keywords (case-insensitive, comma-separated)."
msgstr "Excluez les appels dont le titre contient ces mots-clés (insensible à la casse, séparés par des virgules)."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Max {MAX_EXCLUDE_KEYWORDS} keywords of {MAX_EXCLUDE_KEYWORD_LENGTH} characters each."
msgstr "{MAX_EXCLUDE_KEYWORDS} mots-clés maximum, de {MAX_EXCLUDE_KEYWORD_LENGTH} caractères chacun."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Adding keywords removes existing matching transcripts."
msgstr "Ajouter des mots-clés supprime les transcriptions existantes correspondantes."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Removing keywords only affects future syncs."
msgstr "Retirer des mots-clés n’affecte que les synchronisations futures."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Retention period"
msgstr "Durée de conservation"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgctxt "retention period input placeholder"
msgid "unlimited"
msgstr "illimitée"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Set the number of days to retain Gong transcripts."
msgstr "Définissez le nombre de jours de conservation des transcriptions Gong."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Leave empty to disable retention (no limit)."
msgstr "Laissez vide pour désactiver la conservation (aucune limite)."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Outdated transcripts will be deleted on a daily basis."
msgstr "Les transcriptions expirées seront supprimées chaque jour."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Enable trackers (keyword and smart)"
msgstr "Activer les trackers (mots-clés et intelligents)"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "If activated, Dust will sync the list of keyword and smart trackers associated to each call transcript."
msgstr "Si cette option est activée, Dust synchronisera la liste des trackers par mots-clés et intelligents associés à chaque transcription d’appel."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Only new transcripts will be affected, please contact us at support@dust.tt if you need to update the existing transcripts."
msgstr "Seules les nouvelles transcriptions seront concernées. Contactez-nous à support@dust.tt si vous devez mettre à jour les transcriptions existantes."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Sync account metadata"
msgstr "Synchroniser les métadonnées des comptes"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "If activated, Dust will sync the account names from CRM context associated to each call transcript."
msgstr "Si cette option est activée, Dust synchronisera les noms des comptes du contexte CRM associés à chaque transcription d’appel."
