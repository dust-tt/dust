msgid "Name"
msgstr "Nom"

#: front/components/agent_builder/capabilities/shared/ChildAgentSection.tsx
#: front/components/agent_builder/capabilities/shared/DustAppSection.tsx
msgid "No description available"
msgstr "Aucune description disponible"

#: front/components/agent_builder/capabilities/shared/ChildAgentSection.tsx
msgid "Error loading agents"
msgstr "Erreur lors du chargement des agents"

#: front/components/agent_builder/capabilities/shared/ChildAgentSection.tsx
msgid "Failed to load available agents. Please try again later."
msgstr "Impossible de charger les agents disponibles. Réessayez plus tard."

#: front/components/agent_builder/capabilities/shared/ChildAgentSection.tsx
msgid "No agents available"
msgstr "Aucun agent disponible"

#: front/components/agent_builder/capabilities/shared/ChildAgentSection.tsx
msgid "There are no agents available to select. Please create an agent first."
msgstr "Aucun agent n’est disponible. Créez d’abord un agent."

#: front/components/agent_builder/capabilities/shared/ChildAgentSection.tsx
msgid "The agent selected is not available to you"
msgstr "L’agent sélectionné ne vous est pas accessible"

#: front/components/agent_builder/capabilities/shared/ChildAgentSection.tsx
msgid "The agent ({agentId}) selected is not available to you, either because it was archived or because you have lost access to it (based on a restricted space you're not a part of). As an editor you can still remove the Run Agent tool to add a new one pointing to another agent."
msgstr "L’agent sélectionné ({agentId}) ne vous est pas accessible, soit parce qu’il a été archivé, soit parce que vous n’y avez plus accès (il appartient à un espace restreint dont vous ne faites pas partie). En tant qu’éditeur, vous pouvez toujours supprimer l’outil Run Agent pour en ajouter un nouveau pointant vers un autre agent."

#: front/components/agent_builder/capabilities/shared/ChildAgentSection.tsx
msgid "Select an agent"
msgstr "Sélectionner un agent"

#: front/components/agent_builder/capabilities/shared/ChildAgentSection.tsx
msgid "Edit agent"
msgstr "Modifier l’agent"

#: front/components/agent_builder/capabilities/shared/DataSourceViewTagsFilterDropdown.tsx
msgid "Filters"
msgstr "Filtres"

#: front/components/agent_builder/capabilities/shared/DataSourceViewTagsFilterDropdown.tsx
msgid "Filtering"
msgstr "Filtrage"

#: front/components/agent_builder/capabilities/shared/DataSourceViewTagsFilterDropdown.tsx
msgid "Filter to only include content bearing must-have labels, and exclude content with must-not-have labels."
msgstr "Filtrez pour n’inclure que le contenu portant les étiquettes obligatoires et exclure le contenu portant les étiquettes interdites."

#: front/components/agent_builder/capabilities/shared/DataSourceViewTagsFilterDropdown.tsx
msgid "Must-have labels"
msgstr "Étiquettes obligatoires"

#: front/components/agent_builder/capabilities/shared/DataSourceViewTagsFilterDropdown.tsx
msgid "Must-not-have labels"
msgstr "Étiquettes interdites"

#: front/components/agent_builder/capabilities/shared/DataSourceViewTagsFilterDropdown.tsx
msgid "In-conversation filtering"
msgstr "Filtrage en conversation"

#: front/components/agent_builder/capabilities/shared/DataSourceViewTagsFilterDropdown.tsx
msgid "Allow agents to determine filters to apply based on conversation context."
msgstr "Permettre aux agents de déterminer les filtres à appliquer selon le contexte de la conversation."

#: front/components/agent_builder/capabilities/shared/DataSourceViewTagsFilterDropdown.tsx
msgid "Enable in-conversation filtering"
msgstr "Activer le filtrage en conversation"

#: front/components/agent_builder/capabilities/shared/DataSourceViewTagsFilterDropdown.tsx
msgid "Disable in-conversation filtering"
msgstr "Désactiver le filtrage en conversation"

#: front/components/agent_builder/capabilities/shared/DustAppSection.tsx
msgid "Select a Dust app"
msgstr "Sélectionner une app Dust"

#: front/components/agent_builder/capabilities/shared/DustAppSection.tsx
msgid "The agent will execute a <0>Dust Application</0> of your design before replying. The output of the app (last block) is injected in context for the model to generate an answer."
msgstr "L’agent exécutera une <0>app Dust</0> de votre conception avant de répondre. La sortie de l’app (dernier bloc) est injectée dans le contexte pour que le modèle génère une réponse."

#: front/components/agent_builder/capabilities/shared/DustAppSection.tsx
msgid "Space:"
msgstr "Espace :"

#: front/components/agent_builder/capabilities/shared/DustAppSection.tsx
msgid "Select a space..."
msgstr "Sélectionner un espace…"

#: front/components/agent_builder/capabilities/shared/DustAppSection.tsx
msgid "Edit selection"
msgstr "Modifier la sélection"

#: front/components/agent_builder/capabilities/shared/DustAppSection.tsx
msgid "No Dust apps available for this space"
msgstr "Aucune app Dust disponible pour cet espace"

#: front/components/agent_builder/capabilities/shared/DustAppSection.tsx
msgid "Create one or ask your admin to install apps from other spaces."
msgstr "Créez-en une ou demandez à votre administrateur d’installer des apps depuis d’autres espaces."

#: front/components/agent_builder/capabilities/shared/JsonSchemaSection.tsx
msgid "Instructions required"
msgstr "Instructions requises"

#: front/components/agent_builder/capabilities/shared/JsonSchemaSection.tsx
msgid "Please add agent instructions first."
msgstr "Ajoutez d’abord les instructions de l’agent."

#: front/components/agent_builder/capabilities/shared/JsonSchemaSection.tsx
msgid "Failed to generate schema."
msgstr "Impossible de générer le schéma."

#: front/components/agent_builder/capabilities/shared/JsonSchemaSection.tsx
msgid "An error occurred while generating the schema. Please contact us if the error persists."
msgstr "Une erreur s’est produite lors de la génération du schéma. Contactez-nous si l’erreur persiste."

#: front/components/agent_builder/capabilities/shared/JsonSchemaSection.tsx
msgid "Schema"
msgstr "Schéma"

#: front/components/agent_builder/capabilities/shared/JsonSchemaSection.tsx
msgid "Optionally, provide a schema for the data to be extracted. If you do not specify a schema, the tool will determine the schema based on the conversation context."
msgstr "Vous pouvez fournir un schéma pour les données à extraire. Si vous n’en spécifiez pas, l’outil déterminera le schéma selon le contexte de la conversation."

#: front/components/agent_builder/capabilities/shared/JsonSchemaSection.tsx
msgid "Automatically re-generate the extraction schema based on instructions"
msgstr "Régénérer automatiquement le schéma d’extraction à partir des instructions"

#: front/components/agent_builder/capabilities/shared/JsonSchemaSection.tsx
msgid "Re-generate from instructions"
msgstr "Régénérer à partir des instructions"

#: front/components/agent_builder/capabilities/shared/ProcessingMethodSection.tsx
msgid "<0>{methodLabel}</0> will ignore text documents and files in your selection. Create separate knowledge tools if you need both."
msgstr "<0>{methodLabel}</0> ignorera les documents texte et les fichiers de votre sélection. Créez des outils de connaissances distincts si vous avez besoin des deux."

#: front/components/agent_builder/capabilities/shared/ProcessingMethodSection.tsx
msgid "<0>Note:</0> When you select a folder, only tables directly inside it will be included. Tables in nested subfolders won't be automatically added."
msgstr "<0>Remarque :</0> lorsque vous sélectionnez un dossier, seules les tables qu’il contient directement sont incluses. Les tables des sous-dossiers ne sont pas ajoutées automatiquement."

#: front/components/agent_builder/capabilities/shared/ProcessingMethodSection.tsx
msgid "<0>{methodLabel}</0> will ignore tables in your selection. Switch processing method if you want to use your structured data."
msgstr "<0>{methodLabel}</0> ignorera les tables de votre sélection. Changez de méthode de traitement si vous voulez utiliser vos données structurées."

#: front/components/agent_builder/capabilities/shared/ProcessingMethodSection.tsx
msgid "Knowledge lookup method"
msgstr "Méthode de recherche dans les connaissances"

#: front/components/agent_builder/capabilities/shared/ProcessingMethodSection.tsx
msgid "Sets the approach for finding and retrieving information from your data sources. Need help? Check our <0>guide.</0>"
msgstr "Définit la manière de trouver et de récupérer les informations dans vos sources de données. Besoin d’aide ? Consultez notre <0>guide.</0>"

#: front/components/agent_builder/capabilities/shared/ProcessingMethodSection.tsx
msgid "Loading..."
msgstr "Chargement…"

#: front/components/agent_builder/capabilities/shared/ProjectSection.tsx
msgid "Select a Pod"
msgstr "Sélectionner un Pod"

#: front/components/agent_builder/capabilities/shared/ProjectSection.tsx
msgid "No Pods available"
msgstr "Aucun Pod disponible"

#: front/components/agent_builder/capabilities/shared/ProjectSection.tsx
msgid "No Pods are available in your workspace. Create a Pod first to use this feature."
msgstr "Aucun Pod n’est disponible dans votre workspace. Créez d’abord un Pod pour utiliser cette fonctionnalité."

#: front/components/agent_builder/capabilities/shared/ProjectSection.tsx
msgid "Choose the Pod that the agent can access. The agent will have access to Pod metadata and context from the selected Pod."
msgstr "Choisissez le Pod auquel l’agent peut accéder. L’agent aura accès aux métadonnées et au contexte du Pod sélectionné."

#: front/components/agent_builder/capabilities/shared/ProjectSection.tsx
msgid "Select a Pod..."
msgstr "Sélectionner un Pod…"

#: front/components/agent_builder/capabilities/shared/ProjectSection.tsx
msgid "Search..."
msgstr "Rechercher…"

#: front/components/agent_builder/capabilities/shared/ProjectSection.tsx
msgid "No description available."
msgstr "Aucune description disponible."

#: front/components/agent_builder/capabilities/shared/ProjectSection.tsx
msgid "No matches"
msgstr "Aucun résultat"

#: front/components/agent_builder/capabilities/shared/ProjectSection.tsx
msgid "No Pods"
msgstr "Aucun Pod"

#: front/components/agent_builder/capabilities/shared/SecretSection.tsx
msgid "Select a secret"
msgstr "Sélectionner un secret"

#: front/components/agent_builder/capabilities/shared/SecretSection.tsx
msgid "Failed to load secrets"
msgstr "Impossible de charger les secrets"

#: front/components/agent_builder/capabilities/shared/SecretSection.tsx
msgid "The agent will use the selected secret to authenticate with the service. The secret value will be securely injected at runtime."
msgstr "L’agent utilisera le secret sélectionné pour s’authentifier auprès du service. La valeur du secret sera injectée de façon sécurisée lors de l’exécution."

#: front/components/agent_builder/capabilities/shared/SecretSection.tsx
msgid "Change"
msgstr "Modifier"

#: front/components/agent_builder/capabilities/shared/SecretSection.tsx
msgid "No secrets found. Create a secret in your workspace settings first."
msgstr "Aucun secret trouvé. Créez d’abord un secret dans les paramètres de votre workspace."

#: front/components/agent_builder/capabilities/shared/SelectedDataSources.tsx
msgid "No table detected"
msgstr "Aucune table détectée"

#: front/components/agent_builder/capabilities/shared/SelectedDataSources.tsx
msgid "No document detected"
msgstr "Aucun document détecté"

#: front/components/agent_builder/capabilities/shared/SelectedDataSources.tsx
msgid "We couldn't find any tables in your selection. Add tables to enable \"{serverName}\"."
msgstr "Aucune table n’a été trouvée dans votre sélection. Ajoutez des tables pour activer « {serverName} »."

#: front/components/agent_builder/capabilities/shared/SelectedDataSources.tsx
msgid "We couldn't find any documents in your selection. Add documents to enable \"{serverName}\"."
msgstr "Aucun document n’a été trouvé dans votre sélection. Ajoutez des documents pour activer « {serverName} »."

#: front/components/agent_builder/capabilities/shared/SelectedDataSources.tsx
msgid "Select data sources"
msgstr "Sélectionner des sources de données"

#: front/components/agent_builder/capabilities/shared/SelectedDataSources.tsx
msgid "{dataSourceCount, plural, one {Selected data source} other {Selected data sources}}"
msgstr "{dataSourceCount, plural, one {Source de données sélectionnée} other {Sources de données sélectionnées}}"

