msgstr "Enregistrer"

#: front/components/agent_builder/capabilities/knowledge/KnowledgeConfigurationSheet.tsx
msgid "Select knowledge type and configure settings"
msgstr "Sélectionnez le type de connaissances et configurez les paramètres"

#: front/components/agent_builder/capabilities/knowledge/KnowledgeConfigurationSheet.tsx
msgid "Select tables"
msgstr "Sélectionner des tables"

#: front/components/agent_builder/capabilities/knowledge/KnowledgeConfigurationSheet.tsx
msgid "Select data sources"
msgstr "Sélectionner des sources de données"

#: front/components/agent_builder/capabilities/knowledge/KnowledgeConfigurationSheet.tsx
msgid "Choose the tables to query for your processing method"
msgstr "Choisissez les tables à interroger pour votre méthode de traitement"

#: front/components/agent_builder/capabilities/knowledge/KnowledgeConfigurationSheet.tsx
msgid "Choose the data sources to include in your knowledge base"
msgstr "Choisissez les sources de données à inclure dans votre base de connaissances"

#: front/components/agent_builder/capabilities/knowledge/KnowledgeConfigurationSheet.tsx
#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Configure knowledge"
msgstr "Configurer les connaissances"

#: front/components/agent_builder/capabilities/knowledge/KnowledgeConfigurationSheet.tsx
msgid "Name ..."
msgstr "Nom…"

#: front/components/agent_builder/capabilities/knowledge/KnowledgeFooter.tsx
msgid "{selectionCount, plural, one {Selection (# item)} other {Selection (# items)}}"
msgstr "{selectionCount, plural, one {Sélection (# élément)} other {Sélection (# éléments)}}"

#: front/components/agent_builder/capabilities/knowledge/KnowledgeFooter.tsx
msgid "No selection"
msgstr "Aucune sélection"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Content search"
msgstr "Recherche de contenu"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Analytics (tables, spreadsheets...)"
msgstr "Analyse (tables, feuilles de calcul…)"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Include all data"
msgstr "Inclure toutes les données"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Advanced processing"
msgstr "Traitement avancé"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "What’s the data?"
msgstr "De quelles données s’agit-il ?"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Provide a brief description of the data content and context to help the agent determine when to utilize it effectively."
msgstr "Fournissez une brève description du contenu et du contexte des données pour aider l’agent à déterminer quand les utiliser à bon escient."

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "This data contains…"
msgstr "Ces données contiennent…"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Configure Include Data"
msgstr "Configurer l’inclusion des données"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Set time range and describe what data to include."
msgstr "Définissez la période et décrivez les données à inclure."

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Describe what type of data you want to include from your selected data sources to provide context to the agent."
msgstr "Décrivez le type de données à inclure depuis les sources de données sélectionnées pour fournir du contexte à l’agent."

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Describe what data you want to include from your selected data sources..."
msgstr "Décrivez les données à inclure depuis les sources de données sélectionnées…"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Configure Extract Data"
msgstr "Configurer le traitement avancé"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Set extraction parameters and describe what data to extract."
msgstr "Définissez les paramètres d’extraction et décrivez les données à extraire."

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Provide a brief description (maximum 800 characters) of the data content and context to help the agent determine when to utilize it effectively."
msgstr "Fournissez une brève description (800 caractères maximum) du contenu et du contexte des données pour aider l’agent à déterminer quand les utiliser à bon escient."

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Configure Query Tables"
msgstr "Configurer l’analyse des tables"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Describe how you want to query the selected tables."
msgstr "Décrivez comment vous voulez interroger les tables sélectionnées."

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Query description"
msgstr "Description des requêtes"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Describe what kind of queries you want to run against your selected tables. The agent will use this context to generate appropriate SQL queries."
msgstr "Décrivez le type de requêtes que vous voulez exécuter sur les tables sélectionnées. L’agent utilisera ce contexte pour générer les requêtes SQL appropriées."

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Describe what you want to query from your tables..."
msgstr "Décrivez ce que vous voulez interroger dans vos tables…"

#: front/components/agent_builder/capabilities/knowledge/utils.ts
msgid "Configure Data Warehouse"
msgstr "Configurer l’entrepôt de données"
