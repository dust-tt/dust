#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Error generating filter: {errorMessage}"
msgstr "Erreur lors de la génération du filtre : {errorMessage}"

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Generating filter..."
msgstr "Génération du filtre…"

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Unable to generate filter. Please try rephrasing."
msgstr "Impossible de générer le filtre. Essayez de reformuler."

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Run only when (optional)"
msgstr "Exécuter uniquement si (facultatif)"

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Set conditions that must be met to run the agent."
msgstr "Définissez les conditions à remplir pour exécuter l’agent."

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Describe the conditions (e.g \"Pull requests by John on dust repository\")"
msgstr "Décrivez les conditions (ex. : « Pull requests de John sur le dépôt dust »)"

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Please select an event first"
msgstr "Sélectionnez d’abord un événement."

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Filter expression (optional)"
msgstr "Expression de filtre (facultatif)"

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Enter a filter that will be used to filter the webhook payload JSON. Will always trigger if left empty."
msgstr "Saisissez un filtre à appliquer au JSON du payload du webhook. Le déclenchement a toujours lieu si ce champ est vide."

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Payload filtering syntax"
msgstr "Syntaxe de filtrage du payload"

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "This trigger uses a custom webhook without an integrated provider. As a result, Dust is unable to automatically generate a payload filter. You can manually write a filter expression using our syntax to specify conditions on your webhook's payload."
msgstr "Ce déclencheur utilise un webhook personnalisé sans fournisseur intégré. Dust ne peut donc pas générer automatiquement de filtre de payload. Vous pouvez écrire manuellement une expression de filtre avec notre syntaxe pour définir des conditions sur le payload de votre webhook."

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "See documentation on <0>filter expressions</0> to learn how to write them."
msgstr "Consultez la documentation sur les <0>expressions de filtre</0> pour apprendre à les écrire."

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Example:\n"
"\n"
"{FILTER_EXPRESSION_EXAMPLE}"
msgstr "Exemple :\n"
"\n"
"{FILTER_EXPRESSION_EXAMPLE}"

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Compute stats"
msgstr "Calculer les statistiques"

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "Not enough data to compute statistics."
msgstr "Pas assez de données pour calculer des statistiques."

#. placeholder {0}: estimation.totalCount
#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "{0, plural, one {# event found in the last 24 hours.} other {# events found in the last 24 hours.}}"
msgstr "{0, plural, one {# événement trouvé au cours des dernières 24 heures.} other {# événements trouvés au cours des dernières 24 heures.}}"

#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "At least 10 events are needed for estimation."
msgstr "Au moins 10 événements sont nécessaires pour l’estimation."

#. placeholder {0}: estimation.matchingCount
#. placeholder {1}: estimation.totalCount
#: front/components/agent_builder/triggers/webhook/WebhookEditionFilters.tsx
msgid "According to the most recent data, this trigger would have created <0>{0, plural, one {# conversation} other {# conversations}}</0> out of <1>{1, plural, one {# event} other {# events}}</1> in the last 24 hours."
msgstr "D’après les données les plus récentes, ce déclencheur aurait créé <0>{0, plural, one {# conversation} other {# conversations}}</0> sur <1>{1, plural, one {# événement} other {# événements}}</1> au cours des dernières 24 heures."

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "Name"
msgstr "Nom"

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "Enter trigger name"
msgstr "Saisissez le nom du déclencheur"

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "This will count towards your personal credit pool."
msgstr "Cela sera comptabilisé dans votre réserve de crédits personnelle."

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "This will count towards your workspace's credit pool."
msgstr "Cela sera comptabilisé dans la réserve de crédits de votre workspace."

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "This will count towards your personal fair use limits."
msgstr "Cela sera comptabilisé dans vos limites personnelles d’usage raisonnable."

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "This will count towards your workspace's programmatic usage."
msgstr "Cela sera comptabilisé dans l’utilisation via l’API de votre workspace."

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "Rate limits"
msgstr "Limites de fréquence"

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "Maximum number of runs over a 24-hour window."
msgstr "Nombre maximal d’exécutions sur une période de 24 heures."

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "(<0>Learn more</0>)"
msgstr "(<0>En savoir plus</0>)"

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "Listen for"
msgstr "Écouter"

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "External event that will trigger a run of this agent."
msgstr "Événement externe qui déclenchera une exécution de cet agent."

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "Select event"
msgstr "Sélectionner un événement"

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgctxt "dropdown menu heading"
msgid "Select"
msgstr "Sélectionner"

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "Include webhook payload"
msgstr "Inclure le payload du webhook"

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "Message (optional)"
msgstr "Message (facultatif)"

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "Message for the agent when the trigger runs."
msgstr "Message transmis à l’agent lorsque le déclencheur s’exécute."

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "Where to create this conversation? (optional)"
msgstr "Où créer cette conversation ? (facultatif)"

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "Run this trigger's conversation inside a Pod instead."
msgstr "Exécuter plutôt la conversation de ce déclencheur dans un Pod."

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "another user"
msgstr "un autre utilisateur"

#: front/components/agent_builder/triggers/webhook/WebhookEditionSheet.tsx
msgid "You cannot edit this trigger. It is managed by <0>{editorName}</0>."
msgstr "Vous ne pouvez pas modifier ce déclencheur. Il est géré par <0>{editorName}</0>."

#: front/components/agent_builder/triggers/webhook/webhookEditionFormSchema.ts
msgid "Name is required"
msgstr "Le nom est obligatoire."

#: front/components/agent_builder/triggers/webhook/webhookEditionFormSchema.ts
msgid "Name should be less than 255 characters"
msgstr "Le nom doit faire moins de 255 caractères"

#: front/components/agent_builder/triggers/webhook/webhookEditionFormSchema.ts
msgid "Select a webhook source"
msgstr "Sélectionnez une source de webhook."

#: front/components/agent_builder/triggers/webhook/webhookEditionFormSchema.ts
