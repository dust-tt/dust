#: front/components/agent_builder/triggers/schedule/ScheduleEditionScheduler.tsx
msgid "Generating schedule..."
msgstr "Génération de la planification…"

#: front/components/agent_builder/triggers/schedule/ScheduleEditionScheduler.tsx
msgid "Unable to generate a schedule. Please try rephrasing."
msgstr "Impossible de générer une planification. Essayez de reformuler."

#: front/components/agent_builder/triggers/schedule/ScheduleEditionScheduler.tsx
msgid "{description}, in {timezoneLabel} timezone."
msgstr "{description}, fuseau horaire {timezoneLabel}."

#: front/components/agent_builder/triggers/schedule/ScheduleEditionScheduler.tsx
msgid "Scheduler"
msgstr "Planificateur"

#: front/components/agent_builder/triggers/schedule/ScheduleEditionScheduler.tsx
msgid "Describe when you want the agent to run in natural language."
msgstr "Décrivez en langage naturel quand l’agent doit s’exécuter."

#: front/components/agent_builder/triggers/schedule/ScheduleEditionScheduler.tsx
msgid "e.g. \"run every day at 9 AM\", or \"Late afternoon on business days\"..."
msgstr "ex. : « exécuter tous les jours à 9 h » ou « En fin d’après-midi les jours ouvrés »…"

#: front/components/agent_builder/triggers/schedule/ScheduleEditionScheduler.tsx
msgid "Next 5 occurrences"
msgstr "5 prochaines occurrences"

#: front/components/agent_builder/triggers/schedule/ScheduleEditionSheet.tsx
msgid "Name"
msgstr "Nom"

#: front/components/agent_builder/triggers/schedule/ScheduleEditionSheet.tsx
msgid "Enter trigger name"
msgstr "Saisissez le nom du déclencheur"

#: front/components/agent_builder/triggers/schedule/ScheduleEditionSheet.tsx
msgid "Message (optional)"
msgstr "Message (facultatif)"

#: front/components/agent_builder/triggers/schedule/ScheduleEditionSheet.tsx
msgid "Message for the agent when the trigger runs."
msgstr "Message transmis à l’agent lorsque le déclencheur s’exécute."

#: front/components/agent_builder/triggers/schedule/ScheduleEditionSheet.tsx
msgid "Where to create this conversation? (optional)"
msgstr "Où créer cette conversation ? (facultatif)"

#: front/components/agent_builder/triggers/schedule/ScheduleEditionSheet.tsx
msgid "Run this trigger's conversation inside a Pod instead."
msgstr "Exécuter plutôt la conversation de ce déclencheur dans un Pod."

#: front/components/agent_builder/triggers/schedule/ScheduleEditionSheet.tsx
msgid "another user"
msgstr "un autre utilisateur"

#: front/components/agent_builder/triggers/schedule/ScheduleEditionSheet.tsx
msgid "You cannot edit this schedule. It is managed by <0>{editorName}</0>."
msgstr "Vous ne pouvez pas modifier cette planification. Elle est gérée par <0>{editorName}</0>."

#: front/components/agent_builder/triggers/schedule/describeScheduleConfig.ts
msgid "Every {weekday} at {time}"
msgstr "Chaque {weekday} à {time}"

#: front/components/agent_builder/triggers/schedule/describeScheduleConfig.ts
msgid "{weeks, plural, one {Every # week on {weekday} at {time}} other {Every # weeks on {weekday} at {time}}}"
msgstr "{weeks, plural, one {Chaque semaine le {weekday} à {time}} other {Toutes les # semaines le {weekday} à {time}}}"

#: front/components/agent_builder/triggers/schedule/describeScheduleConfig.ts
msgid "Every day at {time}"
msgstr "Tous les jours à {time}"

#: front/components/agent_builder/triggers/schedule/describeScheduleConfig.ts
msgid "{intervalDays, plural, one {Every # day at {time}} other {Every # days at {time}}}"
msgstr "{intervalDays, plural, one {Chaque jour à {time}} other {Tous les # jours à {time}}}"

#: front/components/agent_builder/triggers/schedule/scheduleEditionFormSchema.ts
msgid "Name is required"
msgstr "Le nom est obligatoire."

#: front/components/agent_builder/triggers/schedule/scheduleEditionFormSchema.ts
msgid "Name should be less than 255 characters"
msgstr "Le nom doit faire moins de 255 caractères"

#: front/components/agent_builder/triggers/schedule/scheduleEditionFormSchema.ts
msgid "Timezone is required"
msgstr "Le fuseau horaire est obligatoire."

#: front/components/agent_builder/triggers/schedule/scheduleEditionFormSchema.ts
msgid "Cron expression is required"
msgstr "L’expression cron est obligatoire."

#: front/components/agent_builder/triggers/schedule/scheduleEditionFormSchema.ts
msgid "Schedule"
msgstr "Planification"
