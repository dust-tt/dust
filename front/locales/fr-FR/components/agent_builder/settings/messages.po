msgstr "Tous les membres peuvent voir et utiliser cet agent."

#: front/components/agent_builder/settings/AgentBuilderAvailabilityMessage.tsx
msgid "Only members of all of the following can view and use this agent: {spaceLinks}."
msgstr "Seuls les membres de tous les espaces suivants peuvent voir et utiliser cet agent : {spaceLinks}."

#: front/components/agent_builder/settings/AgentBuilderAvailabilityMessage.tsx
msgid "Only members of {spaceLinks} can view and use this agent."
msgstr "Seuls les membres de {spaceLinks} peuvent voir et utiliser cet agent."

#: front/components/agent_builder/settings/AgentBuilderAvailabilityMessage.tsx
msgid "Who is this agent available for?"
msgstr "Qui peut accéder à cet agent ?"

#: front/components/agent_builder/settings/AgentBuilderDescriptionSection.tsx
