msgstr "Ajoutez au moins {MIN_INSTRUCTIONS_LENGTH_SUGGESTIONS} caractères aux instructions pour obtenir des suggestions"

#: front/components/agent_builder/settings/AgentBuilderNameSection.tsx
msgid "Get name suggestions"
msgstr "Obtenir des suggestions de nom"

#: front/components/agent_builder/settings/AgentBuilderSettingsBlock.tsx
msgid "Settings"
msgstr "Paramètres"

#: front/components/agent_builder/settings/CostManagementSection.tsx
msgid "Cost Management"
msgstr "Gestion des coûts"

#: front/components/agent_builder/settings/CostManagementSection.tsx
msgid "Ignore credit spend threshold alert"
msgstr "Ignorer l’alerte de seuil de dépenses de crédits"

#: front/components/agent_builder/settings/CostManagementSection.tsx
msgid "Conversations with this agent will not pause to ask for confirmation when they cross the workspace's credit spend checkpoint."
msgstr "Les conversations avec cet agent ne seront pas mises en pause pour demander une confirmation lorsqu’elles franchiront le seuil de dépenses de crédits du workspace."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Failed to retrieve Slack channels. Please check your Slack integration."
msgstr "Impossible de récupérer les canaux Slack. Vérifiez votre intégration Slack."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Search channels..."
msgstr "Rechercher des canaux…"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "No channels available"
msgstr "Aucun canal disponible"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "No channels match \"{searchQuery}\""
msgstr "Aucun canal ne correspond à « {searchQuery} »"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Slack Channel Settings"
msgstr "Paramètres des canaux Slack"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Select channels in which this agent replies by default."
msgstr "Sélectionnez les canaux dans lesquels cet agent répond par défaut."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Set this agent as the default agent on one or several of your Slack channels. It will answer by default when the <0>@Dust</0> Slack bot is mentioned in these channels. Private channels you belong to appear here after you add the Slack tool, connect your personal Slack account, and invite <1>@Dust</1> to the channel."
msgstr "Définissez cet agent comme agent par défaut sur un ou plusieurs de vos canaux Slack. Il répondra par défaut lorsque le bot Slack <0>@Dust</0> sera mentionné dans ces canaux. Les canaux privés dont vous êtes membre apparaissent ici une fois que vous avez ajouté l’outil Slack, connecté votre compte Slack personnel et invité <1>@Dust</1> dans le canal."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Admin Access Required"
msgstr "Accès administrateur requis"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Only administrators can enable default agents for specific Slack channels."
msgstr "Seuls les administrateurs peuvent activer des agents par défaut pour des canaux Slack spécifiques."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Close"
msgstr "Fermer"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Save"
msgstr "Enregistrer"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Respond to all messages in channel"
msgstr "Répondre à tous les messages du canal"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Private channels only reply to @mentions. Auto-respond applies to public channels."
msgstr "Dans les canaux privés, l’agent répond uniquement aux @mentions. La réponse automatique s’applique aux canaux publics."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Auto-respond isn't available in private Slack channels. The agent will only reply when @Dust is mentioned."
msgstr "La réponse automatique n’est pas disponible dans les canaux Slack privés. L’agent répondra uniquement lorsque @Dust sera mentionné."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Agent will automatically respond to messages in selected channels (not just @mentions)"
msgstr "L’agent répondra automatiquement aux messages des canaux sélectionnés (pas seulement aux @mentions)"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Top-level posts only"
msgstr "Messages de premier niveau uniquement"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Only respond to new channel messages, not replies within threads"
msgstr "Répondre uniquement aux nouveaux messages du canal, pas aux réponses dans les fils"

#: front/components/agent_builder/settings/TagsSection.tsx
msgid "Could not get tag suggestions."
msgstr "Impossible d’obtenir des suggestions de tags."

#: front/components/agent_builder/settings/TagsSection.tsx
