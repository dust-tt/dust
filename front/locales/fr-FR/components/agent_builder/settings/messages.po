msgstr "Préférences Slack"

#: front/components/agent_builder/settings/AgentBuilderAvailabilityMessage.tsx
msgid "Only editors can view and use this agent."
msgstr "Seuls les éditeurs peuvent voir et utiliser cet agent."

#: front/components/agent_builder/settings/AgentBuilderAvailabilityMessage.tsx
msgid "Only editors with access to all of the following can view and use this agent: {spaceLinks}."
msgstr "Seuls les éditeurs ayant accès à tous les espaces suivants peuvent voir et utiliser cet agent : {spaceLinks}."

#: front/components/agent_builder/settings/AgentBuilderAvailabilityMessage.tsx
msgid "Only editors with access to {spaceLinks} can view and use this agent."
msgstr "Seuls les éditeurs ayant accès à {spaceLinks} peuvent voir et utiliser cet agent."

#: front/components/agent_builder/settings/AgentBuilderAvailabilityMessage.tsx
