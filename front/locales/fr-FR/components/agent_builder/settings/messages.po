msgstr "Une erreur s’est produite lors de la génération des suggestions de tags. Contactez-nous si l’erreur persiste."

#: front/components/agent_builder/settings/TagsSection.tsx
msgid "No tag suggestions available"
msgstr "Aucune suggestion de tag disponible"

#: front/components/agent_builder/settings/TagsSection.tsx
msgid "We couldn't find any relevant tags to suggest for this agent."
msgstr "Nous n’avons trouvé aucun tag pertinent à suggérer pour cet agent."

#: front/components/agent_builder/settings/TagsSection.tsx
msgid "Tags"
msgstr "Tags"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Add"
msgstr "Ajouter"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Select a tag"
msgstr "Sélectionner un tag"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Choose an option"
msgstr "Choisir une option"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Create \"{newTagName}\""
msgstr "Créer « {newTagName} »"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Generating suggestions..."
msgstr "Génération des suggestions…"

#: front/components/agent_builder/settings/TagsSelector.tsx
