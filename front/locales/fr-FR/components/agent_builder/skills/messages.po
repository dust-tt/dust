#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Add capabilities"
msgstr "Ajouter des capacités"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Add knowledge"
msgstr "Ajouter des connaissances"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Configuration validation failed"
msgstr "Échec de la validation de la configuration"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Remove {skillName}?"
msgstr "Retirer {skillName} ?"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "You will not be able to add this skill back because it is only accessible to the skill editors and you are not an editor."
msgstr "Vous ne pourrez pas rajouter cette compétence, car elle n’est accessible qu’à ses éditeurs et vous n’en faites pas partie."

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Remove"
msgstr "Retirer"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Cancel"
msgstr "Annuler"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Capabilities and knowledge"
msgstr "Capacités et connaissances"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Add skills, tools, and knowledge to enhance your agent's abilities. Need help? Check our <0>guide</0>."
msgstr "Ajoutez des compétences, des outils et des connaissances pour enrichir les capacités de votre agent. Besoin d’aide ? Consultez notre <0>guide</0>."
