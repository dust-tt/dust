#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "{disconnectedCount, plural, one {Connection required for personal tools} other {Connections required for personal tools}}"
msgstr "{disconnectedCount, plural, one {Connexion requise pour les outils personnels} other {Connexions requises pour les outils personnels}}"

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "About personal tools"
msgstr "À propos des outils personnels"

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "Personal tools uses credentials of the user running the agent. Other users will be asked to connect their own accounts when they run the agent. <0>Learn more</0>"
msgstr "Les outils personnels utilisent les identifiants de l’utilisateur qui exécute l’agent. Les autres utilisateurs devront connecter leurs propres comptes lorsqu’ils exécuteront l’agent. <0>En savoir plus</0>"

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "Connected"
msgstr "Connecté"

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "Connect"
msgstr "Connecter"

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "Failed to connect provider"
msgstr "Impossible de connecter le fournisseur"

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "{disconnectedCount, plural, one {# connection is required.} other {# connections are required.}} If you proceed without connecting, the agent will request credentials when they use the tool."
msgstr "{disconnectedCount, plural, one {# connexion est requise.} other {# connexions sont requises.}} Si vous continuez sans vous connecter, l’agent demandera les identifiants lors de l’utilisation de l’outil."

