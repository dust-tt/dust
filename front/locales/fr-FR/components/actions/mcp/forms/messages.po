#: front/components/actions/mcp/forms/mcpServerFormSchema.ts
#: front/components/actions/mcp/forms/utils.ts
msgid "Name is required."
msgstr "Le nom est obligatoire."

#: front/components/actions/mcp/forms/mcpServerFormSchema.ts
#: front/components/actions/mcp/forms/utils.ts
msgid "This name is already in use."
msgstr "Ce nom est déjà utilisé."

#: front/components/actions/mcp/forms/mcpServerFormSchema.ts
msgid "Description is required."
msgstr "La description est obligatoire."

#: front/components/actions/mcp/forms/utils.ts
msgid "This name produces the tool \"{conflictingToolName}\", which already exists on the connection \"{conflictingServerName}\". Enter a different name."
msgstr "Ce nom produit l’outil « {conflictingToolName} », qui existe déjà sur la connexion « {conflictingServerName} ». Saisissez un autre nom."

#: front/components/actions/mcp/forms/utils.ts
msgid "The default name \"{nameConflict}\" conflicts with an existing tool. Enter a different name."
msgstr "Le nom par défaut « {nameConflict} » est en conflit avec un outil existant. Saisissez un autre nom."

#: front/components/actions/mcp/forms/utils.ts
msgid "This name conflicts with an existing tool. Enter a different name."
msgstr "Ce nom est en conflit avec un outil existant. Saisissez un autre nom."

#: front/components/actions/mcp/forms/utils.ts
msgid "Failed to create MCP server"
msgstr "Impossible de créer le serveur MCP"

#: front/components/actions/mcp/forms/utils.ts
msgid "Failed to discover OAuth metadata for MCP server"
msgstr "Impossible de découvrir les métadonnées OAuth du serveur MCP"

#: front/components/actions/mcp/forms/utils.ts
msgid "Missing use case"
msgstr "Cas d’usage manquant"

#: front/components/actions/mcp/forms/utils.ts
msgid "Please select a use case"
msgstr "Sélectionnez un cas d’usage."

#: front/components/actions/mcp/forms/utils.ts
msgid "Failed to connect {providerName}"
msgstr "Impossible de connecter {providerName}"

#: front/components/actions/mcp/forms/utils.ts
msgid "Failed to connect OAuth provider"
msgstr "Impossible de connecter le fournisseur OAuth"
