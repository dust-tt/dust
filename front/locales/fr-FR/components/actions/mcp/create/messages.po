msgstr "Appliquer"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "{serverName} API key"
msgstr "Clé API {serverName}"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Bearer token"
msgstr "Jeton Bearer"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Automatic"
msgstr "Automatique"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Static OAuth"
msgstr "OAuth statique"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Paste your {serverName} API key here"
msgstr "Collez votre clé API {serverName} ici"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Paste the bearer token here"
msgstr "Collez le jeton Bearer ici"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "See {presetName} documentation."
msgstr "Voir la documentation de {presetName}."

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "URL"
msgstr "URL"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Authentication"
msgstr "Authentification"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Choose how to authenticate to the MCP server: Automatic discovery, Bearer token, or Static OAuth credentials."
msgstr "Choisissez comment vous authentifier auprès du serveur MCP : découverte automatique, jeton Bearer ou identifiants OAuth statiques."

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Dust will automatically discover if OAuth authentication is required. If OAuth is not needed, the server will be accessed without authentication. Otherwise, Dust will try to use dynamic client registration to get the OAuth credentials."
msgstr "Dust détecte automatiquement si une authentification OAuth est requise. Si OAuth n’est pas nécessaire, le serveur est accessible sans authentification. Sinon, Dust essaie d’utiliser l’enregistrement dynamique de client pour obtenir les identifiants OAuth."

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Could not load the redirect URI."
msgstr "Impossible de charger l’URI de redirection."

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Retry"
msgstr "Réessayer"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Loading redirect URI…"
msgstr "Chargement de l’URI de redirection…"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "In your OAuth app, allow this redirect URI: <0>{redirectUri}</0>"
msgstr "Dans votre application OAuth, autorisez cette URI de redirection : <0>{redirectUri}</0>"

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Account is required."
msgstr "Le compte est obligatoire."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Username is required."
msgstr "Le nom d’utilisateur est obligatoire."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Role is required."
msgstr "Le rôle est obligatoire."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Warehouse is required."
msgstr "L’entrepôt est obligatoire."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Private key is required."
msgstr "La clé privée est obligatoire."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Failed to save Snowflake credentials"
msgstr "Impossible d’enregistrer les identifiants Snowflake"

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Unexpected response from server (status {status})."
msgstr "Réponse inattendue du serveur (statut {status})."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "One or more fields are invalid."
msgstr "Un ou plusieurs champs ne sont pas valides."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Please check the Snowflake credentials"
msgstr "Vérifiez les identifiants Snowflake"

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Enter credentials for a Snowflake service user configured for key-pair authentication."
msgstr "Saisissez les identifiants d’un utilisateur de service Snowflake configuré pour l’authentification par paire de clés."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Account"
msgstr "Compte"

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Username"
msgstr "Nom d’utilisateur"

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Role"
msgstr "Rôle"

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Warehouse"
msgstr "Entrepôt"

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Private key (PEM format)"
msgstr "Clé privée (format PEM)"

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Private key passphrase (optional)"
msgstr "Phrase secrète de la clé privée (facultatif)"
