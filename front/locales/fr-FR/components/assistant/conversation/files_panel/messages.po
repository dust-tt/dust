#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Delete Frame?"
msgstr "Supprimer le Frame ?"

#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Are you sure you want to delete the Frame \"{fileName}\"? Its source, functions, databases and share links will be permanently removed. This action cannot be undone."
msgstr "Voulez-vous vraiment supprimer le Frame « {fileName} » ? Sa source, ses fonctions, ses bases de données et ses liens de partage seront définitivement supprimés. Cette action est irréversible."

#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Delete folder?"
msgstr "Supprimer le dossier ?"

#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Are you sure you want to delete \"{name}\" and all its contents? This action cannot be undone."
msgstr "Voulez-vous vraiment supprimer « {name} » et tout son contenu ? Cette action est irréversible."

#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Delete file?"
msgstr "Supprimer le fichier ?"

#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Are you sure you want to delete \"{fileName}\"? This action cannot be undone."
msgstr "Voulez-vous vraiment supprimer « {fileName} » ? Cette action est irréversible."

