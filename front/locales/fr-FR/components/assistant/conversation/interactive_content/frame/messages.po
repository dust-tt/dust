#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Share"
msgstr "Partager"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Share this frame"
msgstr "Partager ce Frame"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Could not load sharing settings."
msgstr "Impossible de charger les paramètres de partage."

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Only workspace members can be added"
msgstr "Seuls les membres du workspace peuvent être ajoutés"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Your admin has disabled external sharing. You can only invite people already in your workspace."
msgstr "Votre administrateur a désactivé le partage externe. Vous ne pouvez inviter que des personnes déjà présentes dans votre workspace."

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "You don’t have permission to invite people outside your workspace. You can only invite people already in your workspace."
msgstr "Vous n’êtes pas autorisé à inviter des personnes extérieures à votre workspace. Vous ne pouvez inviter que des personnes déjà présentes dans votre workspace."

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "You no longer have permission to share frames publicly"
msgstr "Vous n’êtes plus autorisé à partager des Frames publiquement"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "This frame is currently shared publicly. You can restrict access, but you won’t be able to make it public again."
msgstr "Ce Frame est actuellement partagé publiquement. Vous pouvez en restreindre l’accès, mais vous ne pourrez plus le rendre public."

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Some referenced files cannot be shared"
msgstr "Certains fichiers référencés ne peuvent pas être partagés"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Viewers will only be able to access files you can verify. Fix or remove these references before sharing: {blockedRefs}"
msgstr "Les lecteurs n’auront accès qu’aux fichiers que vous pouvez vérifier. Corrigez ou supprimez ces références avant de partager : {blockedRefs}"

