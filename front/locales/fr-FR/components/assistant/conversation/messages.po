msgid "Unnamed parent conversation"
msgstr "Conversation parente sans nom"

#: front/components/assistant/conversation/utils.ts
msgid "Compacting context, this may take a moment…"
msgstr "Compactage du contexte, cela peut prendre un moment…"

#: front/components/assistant/conversation/utils.ts
msgid "Summarizing “{truncatedParentConversationTitle}”, this may take a moment…"
msgstr "Synthèse de « {truncatedParentConversationTitle} » en cours, cela peut prendre un moment…"

#: front/components/assistant/conversation/utils.ts
msgid "Context compacted"
msgstr "Contexte compacté"

#: front/components/assistant/conversation/utils.ts
msgid "Summarized “{truncatedParentConversationTitle}” here"
msgstr "Synthèse de « {truncatedParentConversationTitle} » ajoutée ici"

#: front/components/assistant/conversation/utils.ts
msgid "Summarized another conversation here"
msgstr "Synthèse d’une autre conversation ajoutée ici"
