#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Rate limit exceeded"
msgstr "Limite de requêtes dépassée"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Your workspace has run out of credits. Purchase more credits to continue using Dust."
msgstr "Votre workspace n’a plus de crédits. Achetez des crédits pour continuer à utiliser Dust."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Your workspace has run out of credits. Contact your administrator to purchase more credits."
msgstr "Votre workspace n’a plus de crédits. Contactez votre administrateur pour acheter des crédits."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "You've reached your personal usage cap. You can adjust user caps on the usage page."
msgstr "Vous avez atteint votre plafond d’utilisation personnel. Vous pouvez ajuster les plafonds des utilisateurs sur la page d’utilisation."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "You've reached your personal usage cap. Contact your administrator to increase it."
msgstr "Vous avez atteint votre plafond d’utilisation personnel. Contactez votre administrateur pour l’augmenter."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Your group has reached its shared usage limit. You can adjust shared usage limits on the usage page."
msgstr "Votre groupe a atteint sa limite d’utilisation partagée. Vous pouvez ajuster les limites partagées sur la page d’utilisation."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Your group has reached its shared usage limit. Contact your group managers or administrator to increase it."
msgstr "Votre groupe a atteint sa limite d’utilisation partagée. Contactez les managers de votre groupe ou votre administrateur pour l’augmenter."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "You don't have a seat assigned in this workspace. Go to the usage page to assign yourself one."
msgstr "Aucun siège ne vous est attribué dans ce workspace. Rendez-vous sur la page d’utilisation pour vous en attribuer un."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "You don't have a seat assigned in this workspace. Contact your administrator to assign you one."
msgstr "Aucun siège ne vous est attribué dans ce workspace. Contactez votre administrateur pour qu’il vous en attribue un."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Too many steps"
msgstr "Trop d’étapes"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "This agent took too many steps to answer your query. Try narrowing down your question or breaking it into smaller parts."
msgstr "Cet agent a effectué trop d’étapes pour répondre à votre demande. Essayez de préciser votre question ou de la diviser en plusieurs parties."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "No answer generated"
msgstr "Aucune réponse générée"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Agent response generation failed"
msgstr "Échec de la génération de la réponse de l’agent"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "An unexpected error occurred while generating the agent response. Try again."
msgstr "Une erreur inattendue s’est produite pendant la génération de la réponse de l’agent. Réessayez."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Model tier not enabled"
msgstr "Niveau de modèle non activé"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "This agent uses a model tier that isn't enabled for you. Contact your workspace administrator or use another agent."
msgstr "Cet agent utilise un niveau de modèle qui n’est pas activé pour vous. Contactez l’administrateur de votre workspace ou utilisez un autre agent."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Early exit"
msgstr "Arrêt anticipé"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "A tool stopped before it finished. Check whether it completed, then retry."
msgstr "Un outil s’est arrêté avant la fin. Vérifiez s’il a abouti, puis réessayez."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Agent not available"
msgstr "Agent non disponible"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "This agent is no longer available to you. Contact your workspace administrator or use another agent."
msgstr "Cet agent n’est plus disponible pour vous. Contactez l’administrateur de votre workspace ou utilisez un autre agent."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "The model this agent uses isn't available. Edit the agent to use another model (advanced settings in the Instructions panel)."
msgstr "Le modèle utilisé par cet agent n’est pas disponible. Modifiez l’agent pour utiliser un autre modèle (paramètres avancés du panneau Instructions)."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Several tools have the same name. Each tool needs a unique name so the agent can pick the right one."
msgstr "Plusieurs outils portent le même nom. Chaque outil doit avoir un nom unique pour que l’agent puisse choisir le bon."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "You've reached the free usage cap for this 24-hour period. Try again later."
msgstr "Vous avez atteint le plafond d’utilisation gratuite pour cette période de 24 heures. Réessayez plus tard."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "The agent tried to run an action that doesn't exist. You can retry."
msgstr "L’agent a tenté d’exécuter une action qui n’existe pas. Vous pouvez réessayer."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "The agent sent invalid inputs to a tool."
msgstr "L’agent a envoyé des paramètres non valides à un outil."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "The tool call couldn't be parsed."
msgstr "Impossible d’analyser l’appel d’outil."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "This tool isn't available to the agent."
msgstr "Cet outil n’est pas disponible pour l’agent."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "This answer was marked as failed because it stopped responding."
msgstr "Cette réponse a été marquée comme échouée, car elle ne répondait plus."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Context window exceeded"
msgstr "Fenêtre de contexte dépassée"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Your message or retrieved data is too large. Break your request into smaller parts or reduce agent output."
msgstr "Votre message ou les données récupérées sont trop volumineux. Divisez votre demande en plusieurs parties ou réduisez la sortie de l’agent."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Code: {code}"
msgstr "Code : {code}"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Message: {rawMessage}"
msgstr "Message : {rawMessage}"

