#: front/components/assistant/details/tabs/AgentInfoTab/RedactedAgentMessage.tsx
msgid "Security notice"
msgstr "Avis de sécurité"

#: front/components/assistant/details/tabs/AgentInfoTab/RedactedAgentMessage.tsx
msgid "By becoming an editor you will have access to this agent's private data (instructions, skills, knowledge). This action will be logged for security purposes. Do you want to proceed?"
msgstr "En devenant éditeur, vous aurez accès aux données privées de cet agent (instructions, compétences, connaissances). Cette action sera journalisée pour des raisons de sécurité. Voulez-vous continuer ?"

#: front/components/assistant/details/tabs/AgentInfoTab/RedactedAgentMessage.tsx
msgid "Proceed"
msgstr "Continuer"

#: front/components/assistant/details/tabs/AgentInfoTab/RedactedAgentMessage.tsx
msgid "{missingSpacesCount, plural, one {You are about to join this space. This action will be logged for security purposes. Do you want to proceed?} other {You are about to join these spaces. This action will be logged for security purposes. Do you want to proceed?}}"
msgstr "{missingSpacesCount, plural, one {Vous êtes sur le point de rejoindre cet espace. Cette action sera journalisée pour des raisons de sécurité. Voulez-vous continuer ?} other {Vous êtes sur le point de rejoindre ces espaces. Cette action sera journalisée pour des raisons de sécurité. Voulez-vous continuer ?}}"

#: front/components/assistant/details/tabs/AgentInfoTab/RedactedAgentMessage.tsx
msgid "Joined {spaceName}"
msgstr "Vous avez rejoint {spaceName}"

#: front/components/assistant/details/tabs/AgentInfoTab/RedactedAgentMessage.tsx
msgid "You are now a member of {spaceName}."
msgstr "Vous êtes désormais membre de {spaceName}."

#: front/components/assistant/details/tabs/AgentInfoTab/RedactedAgentMessage.tsx
