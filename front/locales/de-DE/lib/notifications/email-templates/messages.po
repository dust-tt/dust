msgctxt "feedback author"
msgid "by {userName}"
msgstr "von {userName}"

#: front/lib/notifications/email-templates/agent-message-feedback-digest.tsx
msgctxt "quoted feedback"
msgid "\"{feedbackContent}\""
msgstr "„{feedbackContent}“"

#: front/lib/notifications/email-templates/conversations-unread.tsx
msgid "{mentionCount, plural, one {You have been mentioned in the following conversation:} other {You have been mentioned in the following conversations:}}"
msgstr "{mentionCount, plural, one {Sie wurden in der folgenden Unterhaltung erwähnt:} other {Sie wurden in den folgenden Unterhaltungen erwähnt:}}"

#: front/lib/notifications/email-templates/conversations-unread.tsx
msgid "{unreadCount, plural, one {You have unread message(s) in the following conversation:} other {You have unread message(s) in the following conversations:}}"
