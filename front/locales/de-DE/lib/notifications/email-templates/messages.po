#: front/lib/notifications/email-templates/_layout.tsx
msgid "An email from Dust about {workspaceName}"
msgstr "Eine E-Mail von Dust zu {workspaceName}"

#: front/lib/notifications/email-templates/_layout.tsx
msgid "Dust logo"
msgstr "Dust-Logo"

#: front/lib/notifications/email-templates/_layout.tsx
msgid "This is an automated email. Please do not reply."
msgstr "Dies ist eine automatisch versendete E-Mail. Antworten Sie nicht darauf."

#: front/lib/notifications/email-templates/_layout.tsx
msgid "You can manage your notification preferences from <0>your workspace</0>."
msgstr "Sie können Ihre Benachrichtigungseinstellungen in <0>Ihrem Workspace</0> verwalten."

#: front/lib/notifications/email-templates/_layout.tsx
msgid "Hi {name},"
msgstr "Hallo {name},"

#: front/lib/notifications/email-templates/_layout.tsx
msgid "Hi there,"
msgstr "Hallo,"

#: front/lib/notifications/email-templates/agent-message-feedback-digest.tsx
msgid "{feedbackCount, plural, one {You received # feedback on your agents today:} other {You received # feedbacks on your agents today:}}"
msgstr "{feedbackCount, plural, one {Sie haben heute # Rückmeldung zu Ihren Agenten erhalten:} other {Sie haben heute # Rückmeldungen zu Ihren Agenten erhalten:}}"

#: front/lib/notifications/email-templates/agent-message-feedback-digest.tsx
msgid "👍 {positiveCount} positive • 👎 {negativeCount} negative"
msgstr "👍 {positiveCount} positiv • 👎 {negativeCount} negativ"

#: front/lib/notifications/email-templates/agent-message-feedback-digest.tsx
msgctxt "feedback author"
msgid "by {userName} in <0>{conversationTitle}</0>"
msgstr "von {userName} in <0>{conversationTitle}</0>"

