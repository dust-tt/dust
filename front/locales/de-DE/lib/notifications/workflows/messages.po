#: front/lib/notifications/workflows/conversation-unread.ts
msgid "There is a new conversation in \"{projectName}\": {author} started \"{conversationTitle}\""
msgstr "Es gibt eine neue Unterhaltung in „{projectName}“: {author} hat „{conversationTitle}“ gestartet"

#: front/lib/notifications/workflows/conversation-unread.ts
msgid "{author} replied in \"{conversationTitle}\""
msgstr "{author} hat in „{conversationTitle}“ geantwortet"

#: front/lib/notifications/workflows/conversation-unread.ts
msgid "New message from {author} in \"{conversationTitle}\""
msgstr "Neue Nachricht von {author} in „{conversationTitle}“"

#: front/lib/notifications/workflows/conversation-unread.ts
