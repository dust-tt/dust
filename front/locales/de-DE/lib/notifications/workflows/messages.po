msgstr "Vorschau aufgrund der Aufbewahrungsrichtlinie für Agenten in dieser Unterhaltung nicht verfügbar."

#: front/lib/notifications/workflows/conversation-unread.ts
msgid "Summary not generated due to data retention policy on conversations in this workspace."
msgstr "Zusammenfassung aufgrund der Aufbewahrungsrichtlinie für Unterhaltungen in diesem Workspace nicht erstellt."

#: front/lib/notifications/workflows/conversation-unread.ts
msgid "Summary not generated due to data retention policy on agents in this conversation."
msgstr "Zusammenfassung aufgrund der Aufbewahrungsrichtlinie für Agenten in dieser Unterhaltung nicht erstellt."

#: front/lib/notifications/workflows/credit-usage-alert.ts
msgid "[Dust] Credit usage alert: {percentUsed}% of your credits consumed"
msgstr "[Dust] Credit-Warnung: {percentUsed} % Ihrer Credits verbraucht"

#: front/lib/notifications/workflows/credit-usage-alert.ts
#: front/lib/notifications/workflows/mcp-global-sharing-reconfiguration.ts
msgid "You're receiving this as an admin of the Dust workspace {workspaceName}."
msgstr "Sie erhalten diese E-Mail als Administrator des Dust-Workspace {workspaceName}."

#: front/lib/notifications/workflows/credit-usage-alert.ts
msgid "Your workspace has consumed {percentUsed}% of its available programmatic usage credits."
msgstr "Ihr Workspace hat {percentUsed} % seiner verfügbaren API-Credits verbraucht."

#: front/lib/notifications/workflows/credit-usage-alert.ts
msgid "• Total credits: {total}"
msgstr "• Credits insgesamt: {total}"

#: front/lib/notifications/workflows/credit-usage-alert.ts
msgid "• Consumed: {consumed}"
msgstr "• Verbraucht: {consumed}"

#: front/lib/notifications/workflows/credit-usage-alert.ts
msgid "• Remaining: {remaining}"
msgstr "• Verbleibend: {remaining}"

#: front/lib/notifications/workflows/credit-usage-alert.ts
msgid "To avoid service interruption, purchase additional credits from the Developers > Credits section."
msgstr "Um eine Unterbrechung des Dienstes zu vermeiden, kaufen Sie zusätzliche Credits unter Entwickler > Credits."

#: front/lib/notifications/workflows/credit-usage-alert.ts
msgid "Learn more about programmatic usage at Dust: {PROGRAMMATIC_USAGE_DOC_URL}"
msgstr "Weitere Informationen zur Nutzung von Dust über die API: {PROGRAMMATIC_USAGE_DOC_URL}"

#: front/lib/notifications/workflows/credit-usage-alert.ts
msgid "Purchase credits"
msgstr "Credits kaufen"

