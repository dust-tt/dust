#: front/lib/notifications/workflows/balance-threshold-reached.ts
msgid "[Dust] Credit balance alert - your workspace balance dropped below {threshold} credits"
msgstr "[Dust] Credit-Warnung: Ihr Workspace hat weniger als {threshold} Credits"

#: front/lib/notifications/workflows/balance-threshold-reached.ts
msgid "Your workspace's remaining credit balance has dropped below the threshold you configured."
msgstr "Die verbleibenden Credits Ihres Workspace sind unter den von Ihnen festgelegten Schwellenwert gefallen."

#: front/lib/notifications/workflows/balance-threshold-reached.ts
msgid "Alert threshold: {threshold} credits"
msgstr "Warnschwelle: {threshold} Credits"

#: front/lib/notifications/workflows/balance-threshold-reached.ts
msgid "{remainingBalanceCredits, plural, one {Remaining balance: {remaining} credit} other {Remaining balance: {remaining} credits}}"
msgstr "{remainingBalanceCredits, plural, one {Verbleibend: {remaining} Credit} other {Verbleibend: {remaining} Credits}}"

#: front/lib/notifications/workflows/balance-threshold-reached.ts
msgid "To avoid running out of credits, please reach out to your Dust representative."
msgstr "Damit Ihnen die Credits nicht ausgehen, wenden Sie sich an Ihren Dust-Ansprechpartner."

#: front/lib/notifications/workflows/balance-threshold-reached.ts
msgid "To avoid running out of credits, you can purchase more from your workspace usage page."
msgstr "Damit Ihnen die Credits nicht ausgehen, können Sie auf der Nutzungsseite Ihres Workspace weitere kaufen."

#: front/lib/notifications/workflows/balance-threshold-reached.ts
msgid "Manage credits"
msgstr "Credits verwalten"

#: front/lib/notifications/workflows/balance-threshold-reached.ts
msgid "See usage details"
msgstr "Nutzungsdetails ansehen"

