msgstr "{sharedByName} hat auf Dust ein Frame mit Ihnen geteilt."

#: front/lib/notifications/workflows/frame-sharing.ts
msgid "{expiresInMinutes, plural, one {The code expires in # minute.} other {The code expires in # minutes.}} Didn't request it? Ignore this email."
msgstr "{expiresInMinutes, plural, one {Der Code läuft in # Minute ab.} other {Der Code läuft in # Minuten ab.}} Nicht angefordert? Ignorieren Sie diese E-Mail."

#: front/lib/notifications/workflows/frame-sharing.ts
msgid "Your login code:"
msgstr "Ihr Anmeldecode:"

#: front/lib/notifications/workflows/frame-sharing.ts
msgid "{sharedByName} shared a frame with you"
msgstr "{sharedByName} hat ein Frame mit Ihnen geteilt"

#: front/lib/notifications/workflows/frame-sharing.ts
