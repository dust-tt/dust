#: front/lib/api_error_messages.ts
msgid "An unexpected error occurred."
msgstr "Ein unerwarteter Fehler ist aufgetreten."

#: front/lib/api_error_messages.ts
msgid "You are not signed in."
msgstr "Sie sind nicht angemeldet."

#: front/lib/api_error_messages.ts
msgid "This workspace requires you to sign in with SSO."
msgstr "Dieser Workspace erfordert eine Anmeldung per SSO."

#: front/lib/api_error_messages.ts
msgid "The request is missing its authorization header."
msgstr "Der Anfrage fehlt der Autorisierungs-Header."

#: front/lib/api_error_messages.ts
msgid "The request authorization header is malformed."
msgstr "Der Autorisierungs-Header der Anfrage ist fehlerhaft."

#: front/lib/api_error_messages.ts
msgid "The request basic authorization is invalid."
msgstr "Die Basic-Authentifizierung der Anfrage ist ungültig."

#: front/lib/api_error_messages.ts
msgid "Your session token is invalid."
msgstr "Ihr Sitzungstoken ist ungültig."

#: front/lib/api_error_messages.ts
msgid "Your session has expired. Sign in again."
msgstr "Ihre Sitzung ist abgelaufen. Melden Sie sich erneut an."

#: front/lib/api_error_messages.ts
msgid "The API key is invalid."
msgstr "Der API-Schlüssel ist ungültig."

#: front/lib/api_error_messages.ts
msgid "The sandbox token is invalid."
msgstr "Das Sandbox-Token ist ungültig."

#: front/lib/api_error_messages.ts
msgid "Something went wrong on our side."
msgstr "Auf unserer Seite ist ein Fehler aufgetreten."

#: front/lib/api_error_messages.ts
msgid "The request is malformed."
msgstr "Die Anfrage ist fehlerhaft."

#: front/lib/api_error_messages.ts
msgid "The table rows are invalid."
msgstr "Die Tabellenzeilen sind ungültig."

#: front/lib/api_error_messages.ts
msgid "User not found."
msgstr "Nutzer nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The content is too large."
msgstr "Der Inhalt ist zu groß."

#: front/lib/api_error_messages.ts
msgid "The data source returned an error."
msgstr "Die Datenquelle hat einen Fehler zurückgegeben."

#: front/lib/api_error_messages.ts
msgid "Data source not found."
msgstr "Datenquelle nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Data source view not found."
msgstr "Ansicht der Datenquelle nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "You don't have access to this data source."
msgstr "Sie haben keinen Zugriff auf diese Datenquelle."

#: front/lib/api_error_messages.ts
msgid "The data source has reached its quota."
msgstr "Die Datenquelle hat ihr Kontingent erreicht."

#: front/lib/api_error_messages.ts
msgid "The workspace has reached its quota."
msgstr "Der Workspace hat sein Kontingent erreicht."

#: front/lib/api_error_messages.ts
msgid "Document not found."
msgstr "Dokument nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "This data source isn't managed by a connection."
msgstr "Diese Datenquelle wird nicht über eine Verbindung verwaltet."

#: front/lib/api_error_messages.ts
msgid "The run failed."
msgstr "Die Ausführung ist fehlgeschlagen."

#: front/lib/api_error_messages.ts
msgid "App not found."
msgstr "App nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "You don't have access to this app."
msgstr "Sie haben keinen Zugriff auf diese App."

#: front/lib/api_error_messages.ts
msgid "The model provider rejected the credentials."
msgstr "Der Modellanbieter hat die Anmeldedaten abgelehnt."

#: front/lib/api_error_messages.ts
msgid "Model provider not found."
msgstr "Modellanbieter nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The model provider endpoint is invalid or can't be reached."
msgstr "Der Endpunkt des Modellanbieters ist ungültig oder nicht erreichbar."

#: front/lib/api_error_messages.ts
msgid "Dataset not found."
msgstr "Datensatz nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Workspace not found."
msgstr "Workspace nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "This workspace is hosted in another region."
msgstr "Dieser Workspace wird in einer anderen Region gehostet."

#: front/lib/api_error_messages.ts
msgid "You don't have access to this workspace."
msgstr "Sie haben keinen Zugriff auf diesen Workspace."

#: front/lib/api_error_messages.ts
msgid "Your workspace can't use this product with its current plan."
msgstr "Ihr Workspace kann dieses Produkt mit seinem aktuellen Tarif nicht nutzen."

#: front/lib/api_error_messages.ts
msgid "User not found in this workspace."
msgstr "Mitglied in diesem Workspace nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "This operation isn't supported."
msgstr "Dieser Vorgang wird nicht unterstützt."

#: front/lib/api_error_messages.ts
msgid "Personal workspace not found."
msgstr "Persönlicher Workspace nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The action failed with an unknown error."
msgstr "Die Aktion ist mit einem unbekannten Fehler fehlgeschlagen."

#: front/lib/api_error_messages.ts
msgid "The action failed."
msgstr "Die Aktion ist fehlgeschlagen."

#: front/lib/api_error_messages.ts
msgid "Membership not found."
msgstr "Mitgliedschaft nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Your membership to this workspace was revoked."
msgstr "Ihre Mitgliedschaft in diesem Workspace wurde widerrufen."

#: front/lib/api_error_messages.ts
msgid "Invitation not found."
msgstr "Einladung nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "You've reached a limit of your plan."
msgstr "Sie haben ein Limit Ihres Tarifs erreicht."

#: front/lib/api_error_messages.ts
msgid "Template not found."
msgstr "Vorlage nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Message not found."
msgstr "Nachricht nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Connection not found."
msgstr "Verbindung nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The connection couldn't be updated."
msgstr "Die Verbindung konnte nicht aktualisiert werden."

#: front/lib/api_error_messages.ts
msgid "You aren't allowed to update this connection."
msgstr "Sie dürfen diese Verbindung nicht ändern."

#: front/lib/api_error_messages.ts
msgid "The connection's authorization wasn't found."
msgstr "Die Autorisierung der Verbindung wurde nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The authorized account doesn't match this connection."
msgstr "Das autorisierte Konto passt nicht zu dieser Verbindung."

#: front/lib/api_error_messages.ts
msgid "The authorized account is missing required permissions."
msgstr "Dem autorisierten Konto fehlen erforderliche Berechtigungen."

#: front/lib/api_error_messages.ts
msgid "The authorized account must be an admin."
msgstr "Das autorisierte Konto muss ein Administrator sein."

#: front/lib/api_error_messages.ts
msgid "This connection type isn't supported."
msgstr "Dieser Verbindungstyp wird nicht unterstützt."

#: front/lib/api_error_messages.ts
msgid "The connection credentials are invalid."
msgstr "Die Anmeldedaten der Verbindung sind ungültig."

#: front/lib/api_error_messages.ts
msgid "The connection credentials weren't found."
msgstr "Die Anmeldedaten der Verbindung wurden nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Another operation is in progress on this connection."
msgstr "Für diese Verbindung läuft bereits ein anderer Vorgang."

#: front/lib/api_error_messages.ts
msgid "Agent not found."
msgstr "Agent nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "You don't have access to this agent."
msgstr "Sie haben keinen Zugriff auf diesen Agenten."

#: front/lib/api_error_messages.ts
msgid "You don't have permission to edit this agent."
msgstr "Sie haben keine Berechtigung, diesen Agenten zu bearbeiten."

#: front/lib/api_error_messages.ts
msgid "The agent message failed."
msgstr "Die Agent-Nachricht ist fehlgeschlagen."

#: front/lib/api_error_messages.ts
msgid "The request couldn't be processed."
msgstr "Die Anfrage konnte nicht verarbeitet werden."

#: front/lib/api_error_messages.ts
msgid "You've reached the message limit of your plan."
msgstr "Sie haben das Nachrichtenlimit Ihres Tarifs erreicht."

#: front/lib/api_error_messages.ts
msgid "Your workspace has run out of credits."
msgstr "Ihr Workspace hat keine Credits mehr."

#: front/lib/api_error_messages.ts
msgid "You've reached your usage limit."
msgstr "Sie haben Ihr Nutzungslimit erreicht."

#: front/lib/api_error_messages.ts
msgid "Your group has reached its shared usage limit."
msgstr "Ihre Gruppe hat ihr gemeinsames Nutzungslimit erreicht."

#: front/lib/api_error_messages.ts
msgid "You don't have a seat in this workspace."
msgstr "Sie haben keinen Platz in diesem Workspace."

#: front/lib/api_error_messages.ts
msgid "This model is disabled."
msgstr "Dieses Modell ist deaktiviert."

#: front/lib/api_error_messages.ts
msgid "This Dust agent couldn't be updated."
msgstr "Dieser Dust-Agent konnte nicht aktualisiert werden."

#: front/lib/api_error_messages.ts
msgid "The billing product is invalid."
msgstr "Das Abrechnungsprodukt ist ungültig."

#: front/lib/api_error_messages.ts
msgid "Too many requests. Try again in a moment."
msgstr "Zu viele Anfragen. Versuchen Sie es gleich noch einmal."

#: front/lib/api_error_messages.ts
msgid "The subscription payment failed."
msgstr "Die Zahlung für das Abonnement ist fehlgeschlagen."

#: front/lib/api_error_messages.ts
msgid "Subscription not found."
msgstr "Abonnement nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The subscription is in an invalid state."
msgstr "Das Abonnement befindet sich in einem ungültigen Zustand."

#: front/lib/api_error_messages.ts
msgid "This isn't available during the trial."
msgstr "Dies ist während des Testzeitraums nicht verfügbar."

#: front/lib/api_error_messages.ts
msgid "The service is temporarily unavailable."
msgstr "Der Dienst ist vorübergehend nicht verfügbar."

#: front/lib/api_error_messages.ts
msgid "This feature isn't enabled for your workspace."
msgstr "Diese Funktion ist für Ihren Workspace nicht aktiviert."

#: front/lib/api_error_messages.ts
msgid "This is only available in Pods."
msgstr "Dies ist nur in Pods verfügbar."

#: front/lib/api_error_messages.ts
msgid "The agent couldn't be saved."
msgstr "Der Agent konnte nicht gespeichert werden."

#: front/lib/api_error_messages.ts
msgid "The server returned an unexpected error."
msgstr "Der Server hat einen unerwarteten Fehler zurückgegeben."

#: front/lib/api_error_messages.ts
msgid "The server returned an unexpected response."
msgstr "Der Server hat eine unerwartete Antwort zurückgegeben."

#: front/lib/api_error_messages.ts
msgid "A network error occurred."
msgstr "Ein Netzwerkfehler ist aufgetreten."

#: front/lib/api_error_messages.ts
msgid "The action returned an unexpected response."
msgstr "Die Aktion hat eine unerwartete Antwort zurückgegeben."

#: front/lib/api_error_messages.ts
msgid "Feature flag not found."
msgstr "Feature-Flag nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "This feature flag already exists."
msgstr "Dieses Feature-Flag existiert bereits."

#: front/lib/api_error_messages.ts
msgid "The pagination parameters are invalid."
msgstr "Die Paginierungsparameter sind ungültig."

#: front/lib/api_error_messages.ts
msgid "Table not found."
msgstr "Tabelle nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "An invitation was already sent recently."
msgstr "Es wurde bereits vor Kurzem eine Einladung gesendet."

#: front/lib/api_error_messages.ts
msgid "Secret not found."
msgstr "Secret nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "API key not found."
msgstr "API-Schlüssel nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The API key doesn't have the required scope."
msgstr "Der API-Schlüssel hat nicht den erforderlichen Berechtigungsumfang."

#: front/lib/api_error_messages.ts
msgid "Admin API keys already read the analytics of every group."
msgstr "Administrator-API-Schlüssel lesen bereits die Statistiken aller Gruppen."

#: front/lib/api_error_messages.ts
msgid "Analytics access can only be granted on manual or provisioned groups."
msgstr "Der Zugriff auf Statistiken kann nur für manuelle oder provisionierte Gruppen gewährt werden."

#: front/lib/api_error_messages.ts
msgid "Transcripts configuration not found."
msgstr "Transkriptkonfiguration nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "This transcripts configuration can't be the default."
msgstr "Diese Transkriptkonfiguration kann nicht als Standard festgelegt werden."

#: front/lib/api_error_messages.ts
msgid "A transcripts configuration already exists."
msgstr "Es existiert bereits eine Transkriptkonfiguration."

#: front/lib/api_error_messages.ts
msgid "File not found."
msgstr "Datei nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The file is too large."
msgstr "Die Datei ist zu groß."

#: front/lib/api_error_messages.ts
msgid "This file type isn't supported."
msgstr "Dieser Dateityp wird nicht unterstützt."

#: front/lib/api_error_messages.ts
msgid "The file is empty."
msgstr "Die Datei ist leer."

#: front/lib/api_error_messages.ts
msgid "You can only read this file."
msgstr "Sie können diese Datei nur lesen."

#: front/lib/api_error_messages.ts
msgid "This file is being edited live and changed before your edit could be saved. Reload it and try again."
msgstr "Diese Datei wird gerade live bearbeitet und hat sich geändert, bevor Ihre Änderung gespeichert werden konnte. Laden Sie sie neu und versuchen Sie es erneut."

#: front/lib/api_error_messages.ts
msgid "This file is being edited live and can't take this change."
msgstr "Diese Datei wird gerade live bearbeitet und kann diese Änderung nicht übernehmen."

#: front/lib/api_error_messages.ts
msgid "Run not found."
msgstr "Ausführung nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "A space with this name already exists."
msgstr "Ein Bereich mit diesem Namen existiert bereits."

#: front/lib/api_error_messages.ts
msgid "Space not found."
msgstr "Bereich nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Task not found."
msgstr "Aufgabe nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Group not found."
msgstr "Gruppe nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The order sent does not list every group with a budget exactly once."
msgstr "Die gesendete Reihenfolge führt nicht jede Gruppe mit einem Budget genau einmal auf."

#: front/lib/api_error_messages.ts
msgid "The order of group budgets changed since you opened it. Reopen the group to see the current order."
msgstr "Die Reihenfolge der Gruppenbudgets hat sich geändert, seit Sie sie geöffnet haben. Öffnen Sie die Gruppe erneut, um die aktuelle Reihenfolge zu sehen."

#: front/lib/api_error_messages.ts
msgid "Coupon not found."
msgstr "Gutschein nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "This coupon can't be redeemed."
msgstr "Dieser Gutschein kann nicht eingelöst werden."

#: front/lib/api_error_messages.ts
msgid "This coupon was already redeemed."
msgstr "Dieser Gutschein wurde bereits eingelöst."

#: front/lib/api_error_messages.ts
msgid "Plugin not found."
msgstr "Plugin nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The plugin failed."
msgstr "Das Plugin ist fehlgeschlagen."

#: front/lib/api_error_messages.ts
msgid "Recommendation not found."
msgstr "Empfehlung nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Work area not found."
msgstr "Tätigkeitsbereich nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Trigger not found."
msgstr "Trigger nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Webhook source not found."
msgstr "Webhook-Quelle nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "You don't have access to this webhook source."
msgstr "Sie haben keinen Zugriff auf diese Webhook-Quelle."

#: front/lib/api_error_messages.ts
msgid "This webhook source is used by an agent trigger."
msgstr "Diese Webhook-Quelle wird von einem Agent-Trigger verwendet."

#: front/lib/api_error_messages.ts
msgid "The webhook source is misconfigured."
msgstr "Die Webhook-Quelle ist falsch konfiguriert."

#: front/lib/api_error_messages.ts
msgid "The webhook couldn't be processed."
msgstr "Der Webhook konnte nicht verarbeitet werden."

#: front/lib/api_error_messages.ts
msgid "The webhook couldn't be stored."
msgstr "Der Webhook konnte nicht gespeichert werden."

#: front/lib/api_error_messages.ts
msgid "Tool connection not found."
msgstr "Tool-Verbindung nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Tool not found."
msgstr "Tool nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Action not found."
msgstr "Aktion nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "This action isn't waiting for approval."
msgstr "Diese Aktion wartet nicht auf eine Genehmigung."

#: front/lib/api_error_messages.ts
msgid "Conversation not found."
msgstr "Unterhaltung nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "You don't have access to this conversation."
msgstr "Sie haben keinen Zugriff auf diese Unterhaltung."

#: front/lib/api_error_messages.ts
msgid "An agent is still running in this conversation."
msgstr "In dieser Unterhaltung läuft noch ein Agent."

#: front/lib/api_error_messages.ts
msgid "This conversation uses an agent that is no longer available."
msgstr "Diese Unterhaltung verwendet einen Agenten, der nicht mehr verfügbar ist."

#: front/lib/api_error_messages.ts
msgid "You're already a participant in this conversation."
msgstr "Sie nehmen bereits an dieser Unterhaltung teil."

#: front/lib/api_error_messages.ts
msgid "You aren't allowed to delete this message."
msgstr "Sie dürfen diese Nachricht nicht löschen."

#: front/lib/api_error_messages.ts
msgid "This message has changed. Refresh the page and try again."
msgstr "Diese Nachricht hat sich geändert. Aktualisieren Sie die Seite und versuchen Sie es erneut."

#: front/lib/api_error_messages.ts
msgid "Conversation context usage not found."
msgstr "Kontextnutzung der Unterhaltung nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The tool rejected the credentials."
msgstr "Das Tool hat die Anmeldedaten abgelehnt."

#: front/lib/api_error_messages.ts
msgid "The tool identifier is invalid."
msgstr "Die Tool-Kennung ist ungültig."

#: front/lib/api_error_messages.ts
msgid "Organization not found."
msgstr "Organisation nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The authentication provider returned an error."
msgstr "Der Authentifizierungsanbieter hat einen Fehler zurückgegeben."

#: front/lib/api_error_messages.ts
msgid "Multiple SSO connections aren't supported."
msgstr "Mehrere SSO-Verbindungen werden nicht unterstützt."

#: front/lib/api_error_messages.ts
msgid "Multiple directories aren't supported."
msgstr "Mehrere Verzeichnisse werden nicht unterstützt."

#: front/lib/api_error_messages.ts
msgid "You need to sign in to continue."
msgstr "Melden Sie sich an, um fortzufahren."

#: front/lib/api_error_messages.ts
msgid "Agent memory not found."
msgstr "Gedächtnis des Agenten nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Search failed."
msgstr "Die Suche ist fehlgeschlagen."

#: front/lib/api_error_messages.ts
msgid "Skill not found."
msgstr "Fähigkeit nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "GitHub repository not found."
msgstr "GitHub-Repository nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Sandbox function not found."
msgstr "Sandbox-Funktion nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Sandbox function call not found."
msgstr "Sandbox-Funktionsaufruf nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "The frame runtime is unavailable."
msgstr "Die Frame-Laufzeitumgebung ist nicht verfügbar."

#: front/lib/api_error_messages.ts
msgid "A Frame's manifest can't be moved or renamed on its own. Move or rename the Frame's folder instead."
msgstr "Das Manifest eines Frames kann nicht separat verschoben oder umbenannt werden. Verschieben oder benennen Sie stattdessen den Ordner des Frames um."

#: front/lib/api_error_messages.ts
msgid "A fast function can't call tools."
msgstr "Eine schnelle Funktion kann keine Tools aufrufen."

#: front/lib/api_error_messages.ts
msgid "Project details not found."
msgstr "Projektdetails nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Suggestion not found."
msgstr "Vorschlag nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Suggestions not found."
msgstr "Vorschläge nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Wake-up not found."
msgstr "Weckruf nicht gefunden."

#: front/lib/api_error_messages.ts
msgid "Another user has an active wake-up in this conversation. Only they can post until it fires or is canceled."
msgstr "Ein anderes Mitglied hat in dieser Unterhaltung einen aktiven Weckruf. Nur dieses Mitglied kann Nachrichten senden, bis der Weckruf ausgelöst oder abgebrochen wird."

#: front/lib/api_error_messages.ts
msgid "Open Pods are disabled in this workspace. Make the Pod private instead."
msgstr "Offene Pods sind in diesem Workspace deaktiviert. Machen Sie den Pod stattdessen privat."

#: front/lib/api_error_messages.ts
msgid "Only provisioned and manual groups can be given access to a space."
msgstr "Nur provisionierte und manuelle Gruppen können Zugriff auf einen Bereich erhalten."

#: front/lib/api_error_messages.ts
msgid "The company space can't be restricted."
msgstr "Der Unternehmensbereich kann nicht eingeschränkt werden."

#: front/lib/api_error_messages.ts
msgid "The company space can't be renamed."
msgstr "Der Unternehmensbereich kann nicht umbenannt werden."

#: front/lib/api_error_messages.ts
msgid "This space has data sources or apps used by agents or skills."
msgstr "Dieser Bereich enthält Datenquellen oder Apps, die von Agenten oder Fähigkeiten verwendet werden."

#: front/lib/api_error_messages.ts
msgid "You're already a member of this Pod."
msgstr "Sie sind bereits Mitglied dieses Pods."

#: front/lib/api_error_messages.ts
msgid "This user is already a member of the space."
msgstr "Diese Person ist bereits Mitglied des Bereichs."

#: front/lib/api_error_messages.ts
msgid "Users can't be added to or removed from system or global groups."
msgstr "Mitglieder können System- oder globalen Gruppen nicht hinzugefügt oder daraus entfernt werden."

#: front/lib/api_error_messages.ts
msgid "This kind of space can't have members."
msgstr "Diese Art von Bereich kann keine Mitglieder haben."

#: front/lib/api_error_messages.ts
msgid "This connection type can't be added to this space."
msgstr "Dieser Verbindungstyp kann diesem Bereich nicht hinzugefügt werden."

#: front/lib/api_error_messages.ts
msgid "An OpenAI API key is required. Configure it in your workspace settings or contact an admin."
msgstr "Ein OpenAI-API-Schlüssel ist erforderlich. Konfigurieren Sie ihn in den Einstellungen Ihres Workspace oder wenden Sie sich an einen Administrator."

#: front/lib/api_error_messages.ts
msgid "A data source with this name already exists."
msgstr "Eine Datenquelle mit diesem Namen existiert bereits."

#: front/lib/api_error_messages.ts
msgid "Data source names can't be empty or start with \"managed-\"."
msgstr "Namen von Datenquellen dürfen nicht leer sein oder mit „managed-“ beginnen."

#: front/lib/api_error_messages.ts
msgid "The connection couldn't be created."
msgstr "Die Verbindung konnte nicht erstellt werden."

#: front/lib/api_error_messages.ts
msgid "Data sources managed by a connection can't be edited."
msgstr "Datenquellen, die über eine Verbindung verwaltet werden, können nicht bearbeitet werden."

#: front/lib/api_error_messages.ts
msgid "This data source can't be deleted."
msgstr "Diese Datenquelle kann nicht gelöscht werden."

#: front/lib/api_error_messages.ts
msgid "This data source is already in this space."
msgstr "Diese Datenquelle befindet sich bereits in diesem Bereich."

#: front/lib/api_error_messages.ts
msgid "The search query is too short."
msgstr "Die Suchanfrage ist zu kurz."

#: front/lib/api_error_messages.ts
msgid "You don't have access to any space to search."
msgstr "Sie haben keinen Zugriff auf einen Bereich, in dem gesucht werden kann."

#: front/lib/api_error_messages.ts
msgid "App names must be 1 to 64 characters long and use only letters, numbers, underscores and dashes."
msgstr "App-Namen müssen 1 bis 64 Zeichen lang sein und dürfen nur Buchstaben, Ziffern, Unterstriche und Bindestriche enthalten."

#: front/lib/api_error_messages.ts
msgid "A dataset with this name already exists in this app."
msgstr "In dieser App existiert bereits ein Datensatz mit diesem Namen."

#: front/lib/api_error_messages.ts
msgid "Dataset names can only use letters, numbers and underscores."
msgstr "Namen von Datensätzen dürfen nur Buchstaben, Ziffern und Unterstriche enthalten."

#: front/lib/api_error_messages.ts
msgid "The dataset data is invalid. Check that every entry matches the schema."
