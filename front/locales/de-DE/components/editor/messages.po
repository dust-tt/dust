#: front/components/editor/MarkdownFileEditor.tsx
msgid "Content too long"
msgstr "Inhalt zu lang"

#: front/components/editor/MarkdownFileEditor.tsx
msgid "Shorten the file to {maxCharacterCount} characters or fewer before saving."
msgstr "Kürzen Sie die Datei vor dem Speichern auf höchstens {maxCharacterCount} Zeichen."

#: front/components/editor/MarkdownFileEditor.tsx
msgid "File not found"
msgstr "Datei nicht gefunden"

#: front/components/editor/MarkdownFileEditor.tsx
msgid "The file could not be found at this path."
msgstr "Die Datei wurde unter diesem Pfad nicht gefunden."

#: front/components/editor/MarkdownFileEditor.tsx
msgid "Failed to load file"
msgstr "Die Datei konnte nicht geladen werden."

#: front/components/editor/MarkdownFileEditor.tsx
msgid "Content exceeds the character limit"
msgstr "Der Inhalt überschreitet das Zeichenlimit"

#: front/components/editor/MarkdownFileEditor.tsx
msgid "This file is longer than {maxCharacterCount} characters. You can read and edit it, but trim it down before saving."
msgstr "Diese Datei ist länger als {maxCharacterCount} Zeichen. Sie können sie lesen und bearbeiten, müssen sie aber vor dem Speichern kürzen."

#: front/components/editor/MarkdownFileEditor.tsx
msgid "Save"
msgstr "Speichern"

#: front/components/editor/MarkdownFileEditor.tsx
msgid "Cancel"
msgstr "Abbrechen"

#: front/components/editor/RawMarkdownEditor.tsx
msgid "Markdown source"
msgstr "Markdown-Quelltext"

#: front/components/editor/SkillDescriptionEditor.tsx
msgid "When should this skill be used? What is this skill good for?"
msgstr "Wann sollte diese Fähigkeit verwendet werden? Wofür eignet sie sich?"

#: front/components/editor/SkillInstructionsEditor.tsx
msgid "What does this skill do? How should it behave?"
msgstr "Was macht diese Fähigkeit? Wie soll sie sich verhalten?"
