#: front/components/shared/RemoveSpaceDialog.tsx
msgid "This will remove the following elements from the agent:"
msgstr "Dadurch werden die folgenden Elemente aus dem Agenten entfernt:"

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "This will remove the following elements from the skill:"
msgstr "Dadurch werden die folgenden Elemente aus der Fähigkeit entfernt:"

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "The following elements from this Pod are used in the agent:"
msgstr "Die folgenden Elemente aus diesem Pod werden im Agenten verwendet:"

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "The following elements from this Pod are used in the skill:"
msgstr "Die folgenden Elemente aus diesem Pod werden in der Fähigkeit verwendet:"

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "The following elements from this space are used in the agent:"
msgstr "Die folgenden Elemente aus diesem Bereich werden im Agenten verwendet:"

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "The following elements from this space are used in the skill:"
msgstr "Die folgenden Elemente aus diesem Bereich werden in der Fähigkeit verwendet:"

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "Remove {spaceName} Pod"
msgstr "Pod {spaceName} entfernen"

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "Remove {spaceName} space"
msgstr "Bereich {spaceName} entfernen"

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "To remove this Pod, first update your instructions to remove the knowledge references."
msgstr "Um diesen Pod zu entfernen, passen Sie zuerst Ihre Anweisungen an und entfernen Sie die Verweise auf Wissen."

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "To remove this space, first update your instructions to remove the knowledge references."
msgstr "Um diesen Bereich zu entfernen, passen Sie zuerst Ihre Anweisungen an und entfernen Sie die Verweise auf Wissen."

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "OK"
msgstr "OK"

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "{spaceName} can't be removed"
msgstr "{spaceName} kann nicht entfernt werden"

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "This space can't be removed from the skill because the skill uses knowledge or capabilities that belong to it."
msgstr "Dieser Bereich kann nicht aus der Fähigkeit entfernt werden, da die Fähigkeit Wissen oder Funktionen verwendet, die zu ihm gehören."

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "Update the skill to stop relying on these items, then remove the space."
msgstr "Passen Sie die Fähigkeit so an, dass sie diese Elemente nicht mehr benötigt, und entfernen Sie dann den Bereich."

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "Close"
msgstr "Schließen"

#: front/components/shared/RemoveSpaceDialog.tsx
msgid "Remove"
msgstr "Entfernen"

