#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Gong configuration updated"
msgstr "Gong-Konfiguration aktualisiert"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Participant filter successfully updated."
msgstr "Der Teilnehmerfilter wurde aktualisiert."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Failed to update Gong configuration"
msgstr "Die Gong-Konfiguration konnte nicht aktualisiert werden."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Participant filter"
msgstr "Teilnehmerfilter"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "All participants"
msgstr "Alle Teilnehmer"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Saving..."
msgstr "Wird gespeichert…"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Save"
msgstr "Speichern"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Filter calls by Gong permission profile."
msgstr "Filtern Sie Anrufe nach Gong-Berechtigungsprofil."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Only calls involving users listed in the selected profile's \"Specific Teams\" section will be synced."
msgstr "Nur Anrufe mit Benutzern, die im Abschnitt „Specific Teams“ des ausgewählten Profils aufgeführt sind, werden synchronisiert."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Changing the filter only affects future syncs."
msgstr "Eine Änderung des Filters wirkt sich nur auf künftige Synchronisierungen aus."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Invalid retention period"
msgstr "Ungültige Aufbewahrungsdauer"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Retention period must be a positive integer or empty for no limit."
msgstr "Die Aufbewahrungsdauer muss eine positive ganze Zahl sein oder leer bleiben, um kein Limit festzulegen."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Retention period successfully updated."
msgstr "Die Aufbewahrungsdauer wurde aktualisiert."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Trackers synchronization successfully updated."
msgstr "Die Tracker-Synchronisierung wurde aktualisiert."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Accounts synchronization successfully updated."
msgstr "Die Kontensynchronisierung wurde aktualisiert."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Exclude keywords successfully updated."
msgstr "Die ausgeschlossenen Schlüsselwörter wurden aktualisiert."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Configuration successfully updated."
msgstr "Die Konfiguration wurde aktualisiert."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "All Gong data will sync automatically"
msgstr "Alle Gong-Daten werden automatisch synchronisiert"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "All your Gong resources will sync automatically."
msgstr "Alle Ihre Gong-Ressourcen werden automatisch synchronisiert."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Selecting items individually is not available."
msgstr "Die Auswahl einzelner Elemente ist nicht verfügbar."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Exclude calls by title keywords"
msgstr "Anrufe nach Schlüsselwörtern im Titel ausschließen"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "e.g. internal, test, demo"
msgstr "z. B. intern, Test, Demo"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Exclude calls whose title contains these keywords (case-insensitive, comma-separated)."
msgstr "Schließen Sie Anrufe aus, deren Titel diese Schlüsselwörter enthält (ohne Beachtung der Groß-/Kleinschreibung, durch Kommas getrennt)."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Max {MAX_EXCLUDE_KEYWORDS} keywords of {MAX_EXCLUDE_KEYWORD_LENGTH} characters each."
msgstr "Höchstens {MAX_EXCLUDE_KEYWORDS} Schlüsselwörter mit je {MAX_EXCLUDE_KEYWORD_LENGTH} Zeichen."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Adding keywords removes existing matching transcripts."
msgstr "Durch das Hinzufügen von Schlüsselwörtern werden passende vorhandene Transkripte entfernt."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Removing keywords only affects future syncs."
msgstr "Das Entfernen von Schlüsselwörtern wirkt sich nur auf künftige Synchronisierungen aus."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Retention period"
msgstr "Aufbewahrungsdauer"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgctxt "retention period input placeholder"
msgid "unlimited"
msgstr "unbegrenzt"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Set the number of days to retain Gong transcripts."
msgstr "Legen Sie fest, wie viele Tage Gong-Transkripte aufbewahrt werden."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Leave empty to disable retention (no limit)."
msgstr "Lassen Sie das Feld leer, um die Aufbewahrungsdauer zu deaktivieren (kein Limit)."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Outdated transcripts will be deleted on a daily basis."
msgstr "Veraltete Transkripte werden täglich gelöscht."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Enable trackers (keyword and smart)"
msgstr "Tracker aktivieren (Schlüsselwort- und Smart-Tracker)"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "If activated, Dust will sync the list of keyword and smart trackers associated to each call transcript."
msgstr "Wenn aktiviert, synchronisiert Dust die Liste der Schlüsselwort- und Smart-Tracker, die jedem Anruftranskript zugeordnet sind."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Only new transcripts will be affected, please contact us at support@dust.tt if you need to update the existing transcripts."
msgstr "Nur neue Transkripte sind betroffen. Wenden Sie sich an support@dust.tt, wenn vorhandene Transkripte aktualisiert werden müssen."

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "Sync account metadata"
msgstr "Kontometadaten synchronisieren"

#: front/components/data_source/gong/GongOptionComponent.tsx
msgid "If activated, Dust will sync the account names from CRM context associated to each call transcript."
msgstr "Wenn aktiviert, synchronisiert Dust die Kontonamen aus dem CRM-Kontext, die jedem Anruftranskript zugeordnet sind."
