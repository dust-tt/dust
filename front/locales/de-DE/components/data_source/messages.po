msgstr "Synchronisierung fehlgeschlagen"

#: front/components/data_source/DataSourceSyncChip.tsx
msgid "We are having trouble retrieving your data from {providerName}. Synchronization will resume automatically once the issue is resolved."
msgstr "Wir haben Probleme, Ihre Daten von {providerName} abzurufen. Die Synchronisierung wird automatisch fortgesetzt, sobald das Problem behoben ist."

#: front/components/data_source/DataSourceSyncChip.tsx
msgid "Synchronization delayed"
msgstr "Synchronisierung verzögert"

#: front/components/data_source/DataSourceSyncChip.tsx
