msgstr "Ungültige Aufbewahrungsdauer"

#: front/components/data_source/ZendeskConfigView.tsx
msgid "Retention period must be a positive integer."
msgstr "Die Aufbewahrungsdauer muss eine positive ganze Zahl sein."

#: front/components/data_source/ZendeskConfigView.tsx
msgid "Sync unresolved tickets"
msgstr "Ungelöste Tickets synchronisieren"

#: front/components/data_source/ZendeskConfigView.tsx
msgid "If activated, Dust will also sync the unresolved tickets."
msgstr "Wenn aktiviert, synchronisiert Dust auch die ungelösten Tickets."

#: front/components/data_source/ZendeskConfigView.tsx
msgid "Hide customer information"
msgstr "Kundeninformationen ausblenden"

#: front/components/data_source/ZendeskConfigView.tsx
msgid "Enable this option to prevent customer names and email addresses from being synced with Dust. This does not impact data within tickets, only the metadata attached to tickets."
msgstr "Aktivieren Sie diese Option, damit Namen und E-Mail-Adressen von Kunden nicht mit Dust synchronisiert werden. Das betrifft nicht die Daten in den Tickets, nur die zugehörigen Metadaten."

#: front/components/data_source/ZendeskConfigView.tsx
msgid "Data retention period"
msgstr "Aufbewahrungsdauer der Daten"

#: front/components/data_source/ZendeskConfigView.tsx
msgid "Set the retention period (in days), tickets older than the retention period will not be synced with Dust."
msgstr "Legen Sie die Aufbewahrungsdauer (in Tagen) fest. Ältere Tickets werden nicht mit Dust synchronisiert."

#: front/components/data_source/ZendeskConfigView.tsx
msgid "{savedRetentionDays, plural, one {# day} other {# days}}"
msgstr "{savedRetentionDays, plural, one {# Tag} other {# Tage}}"

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Invalid field ID"
msgstr "Ungültige Feld-ID"

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Field ID cannot be empty."
msgstr "Die Feld-ID darf nicht leer sein."

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Field ID must be a positive number."
msgstr "Die Feld-ID muss eine positive Zahl sein."

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Field already added"
msgstr "Feld bereits hinzugefügt"

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "This custom field is already configured."
msgstr "Dieses benutzerdefinierte Feld ist bereits konfiguriert."

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Custom field added"
msgstr "Benutzerdefiniertes Feld hinzugefügt"

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Added custom field with ID {numericFieldId}."
msgstr "Benutzerdefiniertes Feld mit der ID {numericFieldId} hinzugefügt."

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Failed to add custom field"
msgstr "Das benutzerdefinierte Feld konnte nicht hinzugefügt werden."

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Field not found"
msgstr "Feld nicht gefunden"

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "The field is not configured."
msgstr "Das Feld ist nicht konfiguriert."

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Custom field removed"
msgstr "Benutzerdefiniertes Feld entfernt"

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Removed custom field \"{fieldName}\"."
msgstr "Benutzerdefiniertes Feld „{fieldName}“ entfernt."

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Failed to remove custom field"
msgstr "Das benutzerdefinierte Feld konnte nicht entfernt werden."

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Custom field tags"
msgstr "Tags aus benutzerdefinierten Feldern"

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Configure custom ticket field that should be included as tags when syncing tickets. Custom field values will be added as tags in the format \"fieldName:value\"."
msgstr "Konfigurieren Sie benutzerdefinierte Ticketfelder, die beim Synchronisieren von Tickets als Tags übernommen werden. Die Feldwerte werden als Tags im Format „fieldName:value“ hinzugefügt."

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Enter custom field ID"
msgstr "ID des benutzerdefinierten Felds eingeben"

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Add field"
msgstr "Feld hinzufügen"

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Enter the numeric ID of the custom field from Zendesk. You can find this in your Zendesk admin settings under Fields."
msgstr "Geben Sie die numerische ID des benutzerdefinierten Felds aus Zendesk ein. Sie finden sie in den Zendesk-Administratoreinstellungen unter „Fields“."

#: front/components/data_source/ZendeskCustomTagFilters.tsx
msgid "Field ID: {fieldId}"
msgstr "Feld-ID: {fieldId}"

#: front/components/data_source/ZendeskCustomTagFilters.tsx
#: front/components/data_source/ZendeskTagFilters.tsx
msgid "No tag filters configured."
msgstr "Keine Tag-Filter konfiguriert."

#: front/components/data_source/ZendeskOAuthExtraConfig.tsx
msgid "Zendesk account subdomain"
msgstr "Subdomain des Zendesk-Kontos"

#: front/components/data_source/ZendeskOAuthExtraConfig.tsx
msgid "The first part of your Zendesk account URL."
msgstr "Der erste Teil der URL Ihres Zendesk-Kontos."

#: front/components/data_source/ZendeskOrganizationTagFilters.tsx
msgid "Organization tag filters"
msgstr "Organisations-Tag-Filter"

#: front/components/data_source/ZendeskOrganizationTagFilters.tsx
msgid "Include or exclude tickets from the sync based on their associated organization. These filters only apply to future syncing and will not retroactively remove already-synced tickets."
msgstr "Schließen Sie Tickets anhand ihrer Organisation in die Synchronisierung ein oder aus. Diese Filter gelten nur für künftige Synchronisierungen und entfernen bereits synchronisierte Tickets nicht nachträglich."

#: front/components/data_source/ZendeskOrganizationTagFilters.tsx
#: front/components/data_source/ZendeskTagFilters.tsx
#: front/components/data_source/ZendeskTicketTagFilters.tsx
msgid "Enter tag name"
msgstr "Tag-Namen eingeben"

#: front/components/data_source/ZendeskRateLimitConfig.tsx
msgid "Rate limit transactions per second updated"
msgstr "Ratenlimit (Transaktionen pro Sekunde) aktualisiert"

#: front/components/data_source/ZendeskRateLimitConfig.tsx
msgid "The rate limit transactions per second has been updated to {configValue}."
msgstr "Das Ratenlimit wurde auf {configValue} Transaktionen pro Sekunde aktualisiert."

#: front/components/data_source/ZendeskRateLimitConfig.tsx
msgid "Invalid rate limit transactions per second"
msgstr "Ungültiges Ratenlimit (Transaktionen pro Sekunde)"

#: front/components/data_source/ZendeskRateLimitConfig.tsx
msgid "Rate limit transactions per second must be a positive integer."
msgstr "Das Ratenlimit (Transaktionen pro Sekunde) muss eine positive ganze Zahl sein."

#: front/components/data_source/ZendeskRateLimitConfig.tsx
msgid "Rate limit transactions per second"
msgstr "Ratenlimit (Transaktionen pro Sekunde)"

#: front/components/data_source/ZendeskRateLimitConfig.tsx
msgid "Set a transaction-per-second limit to manage Zendesk rate restrictions. Leave empty to disable."
msgstr "Legen Sie ein Limit für Transaktionen pro Sekunde fest, um die Ratenbegrenzungen von Zendesk einzuhalten. Lassen Sie das Feld leer, um es zu deaktivieren."

#: front/components/data_source/ZendeskRateLimitConfig.tsx
msgid "{rateLimitTransactionsPerSecond} tps"
msgstr "{rateLimitTransactionsPerSecond} tps"

#: front/components/data_source/ZendeskRateLimitConfig.tsx
msgid "Disabled"
msgstr "Deaktiviert"

#: front/components/data_source/ZendeskRateLimitConfig.tsx
msgid "transactions per second"
msgstr "Transaktionen pro Sekunde"

#: front/components/data_source/ZendeskTagFilters.tsx
msgid "Include tags"
msgstr "Tags einschließen"

#: front/components/data_source/ZendeskTagFilters.tsx
msgid "Exclude tags"
msgstr "Tags ausschließen"

#: front/components/data_source/ZendeskTagFilters.tsx
msgid "Add"
msgstr "Hinzufügen"

#: front/components/data_source/ZendeskTagFilters.tsx
msgid "Add tags"
msgstr "Tags hinzufügen"

#: front/components/data_source/ZendeskTagFilters.tsx
msgid "Include tags (sync only items with these tags):"
msgstr "Tags einschließen (nur Elemente mit diesen Tags synchronisieren):"

#: front/components/data_source/ZendeskTagFilters.tsx
msgid "Exclude tags (don't sync items with these tags):"
msgstr "Tags ausschließen (Elemente mit diesen Tags nicht synchronisieren):"

#: front/components/data_source/ZendeskTicketTagFilters.tsx
msgid "Ticket tag filters"
msgstr "Ticket-Tag-Filter"

#: front/components/data_source/ZendeskTicketTagFilters.tsx
msgid "Include or exclude tickets from the sync based on their tags. These filters only apply to future syncing and will not retroactively remove already-synced tickets."
msgstr "Schließen Sie Tickets anhand ihrer Tags in die Synchronisierung ein oder aus. Diese Filter gelten nur für künftige Synchronisierungen und entfernen bereits synchronisierte Tickets nicht nachträglich."
