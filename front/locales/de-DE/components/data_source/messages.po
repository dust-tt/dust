msgstr "Die Synchronisierung ist fehlgeschlagen, weil zu viele übermäßig große Seiten gefunden wurden."

#: front/components/data_source/DataSourceSyncChip.tsx
msgid "Pages too large"
msgstr "Seiten zu groß"

#: front/components/data_source/DataSourceSyncChip.tsx
