#: front/components/groups/GroupDialog.tsx
msgid "Edit group"
msgstr "Gruppe bearbeiten"

#: front/components/groups/GroupDialog.tsx
msgid "New group"
msgstr "Neue Gruppe"

#: front/components/groups/GroupDialog.tsx
msgid "Managed by admins"
msgstr "Von Administratoren verwaltet"

#: front/components/groups/GroupDialog.tsx
msgid "This group grants the Admin role. Only workspace admins can change its members."
msgstr "Diese Gruppe vergibt die Administratorrolle. Nur Administratoren des Workspace können ihre Mitglieder ändern."

#: front/components/groups/GroupDialog.tsx
#: front/components/groups/GroupsList.tsx
msgid "Group name"
msgstr "Gruppenname"

#: front/components/groups/GroupDialog.tsx
msgid "e.g. Sales"
msgstr "z. B. Vertrieb"

#: front/components/groups/GroupDialog.tsx
msgid "Group members ({selectedMemberCount})"
msgstr "Gruppenmitglieder ({selectedMemberCount})"

#: front/components/groups/GroupDialog.tsx
#: front/components/groups/ProvisionedGroupDialog.tsx
msgid "Cancel"
msgstr "Abbrechen"

#: front/components/groups/GroupDialog.tsx
#: front/components/groups/ProvisionedGroupDialog.tsx
msgid "Save"
msgstr "Speichern"

#: front/components/groups/GroupDialog.tsx
msgid "Create"
msgstr "Erstellen"

#: front/components/groups/GroupKinds.ts
msgid "Provisioned"
msgstr "Provisioniert"

#: front/components/groups/GroupKinds.ts
msgid "Manual"
msgstr "Manuell"

#: front/components/groups/GroupKinds.ts
msgid "Other"
msgstr "Sonstige"

#: front/components/groups/GroupKinds.ts
msgid "Synced from your identity provider. Manage membership in your IdP."
msgstr "Von Ihrem Identitätsanbieter synchronisiert. Verwalten Sie die Mitgliedschaft in Ihrem IdP."

#: front/components/groups/GroupManagersField.tsx
msgid "Membership stays managed by your directory."
msgstr "Die Mitgliedschaft wird weiterhin von Ihrem Verzeichnis verwaltet."

#: front/components/groups/GroupManagersField.tsx
msgid "Only workspace admins can change this group's members."
msgstr "Nur Administratoren des Workspace können die Mitglieder dieser Gruppe ändern."

#: front/components/groups/GroupManagersField.tsx
msgid "Group managers can manage usage and credit limits for this group's members."
msgstr "Gruppenmanager können Nutzungs- und Credit-Limits für die Mitglieder dieser Gruppe verwalten."

#: front/components/groups/GroupManagersField.tsx
msgid "{fullName} isn't a member of {groupName} but can manage it."
msgstr "{fullName} ist kein Mitglied von {groupName}, kann die Gruppe aber verwalten."

#: front/components/groups/GroupManagersField.tsx
msgid "They can grant themselves access to the group's permissions and data."
msgstr "Diese Person kann sich selbst Zugriff auf die Berechtigungen und Daten der Gruppe gewähren."

#: front/components/groups/GroupManagersField.tsx
msgid "Not group member"
msgstr "Kein Gruppenmitglied"

#: front/components/groups/GroupManagersField.tsx
msgid "Group managers ({managerCount})"
msgstr "Gruppenmanager ({managerCount})"

#: front/components/groups/GroupManagersField.tsx
msgid "Group managers can add members and set their usage and credit limits."
msgstr "Gruppenmanager können Mitglieder hinzufügen und deren Nutzungs- und Credit-Limits festlegen."

#: front/components/groups/GroupSelectionTable.tsx
#: front/components/groups/ProvisionedGroupDialog.tsx
