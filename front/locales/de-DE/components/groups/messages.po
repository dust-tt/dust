msgid "Name"
msgstr "Name"

#: front/components/groups/GroupSelectionTable.tsx
#: front/components/groups/WorkspaceGroupsList.tsx
msgid "{memberCount, plural, one {# member} other {# members}}"
msgstr "{memberCount, plural, one {# Mitglied} other {# Mitglieder}}"

#: front/components/groups/GroupSelectionTable.tsx
msgid "Search groups..."
msgstr "Gruppen suchen…"

#: front/components/groups/GroupSelectionTable.tsx
msgid "Loading groups..."
msgstr "Gruppen werden geladen…"

#: front/components/groups/GroupsList.tsx
msgid "Remove group"
msgstr "Gruppe entfernen"

#: front/components/groups/GroupsList.tsx
msgid "Members"
msgstr "Mitglieder"

#: front/components/groups/ProvisionedGroupDialog.tsx
msgid "Group members ({memberCount})"
msgstr "Gruppenmitglieder ({memberCount})"

#: front/components/groups/ProvisionedGroupDialog.tsx
msgid "This group has no members."
msgstr "Diese Gruppe hat keine Mitglieder."

#: front/components/groups/WorkspaceGroupsList.tsx
msgid "Group manager"
msgstr "Gruppenmanager"

#: front/components/groups/WorkspaceGroupsList.tsx
msgid "More options"
msgstr "Weitere Optionen"

#: front/components/groups/WorkspaceGroupsList.tsx
msgid "Delete"
msgstr "Löschen"

#: front/components/groups/WorkspaceGroupsList.tsx
msgid "Delete group"
msgstr "Gruppe löschen"

#: front/components/groups/WorkspaceGroupsList.tsx
msgid "Are you sure you want to delete {groupName}? This action cannot be undone."
msgstr "Möchten Sie {groupName} wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden."

#: front/components/groups/WorkspaceGroupsList.tsx
msgid "Search groups"
msgstr "Gruppen suchen"

#: front/components/groups/WorkspaceGroupsList.tsx
msgid "Create group"
msgstr "Gruppe erstellen"

#: front/components/groups/WorkspaceGroupsList.tsx
msgid "You don’t have any groups yet."
msgstr "Sie haben noch keine Gruppen."

#: front/components/groups/useGroupManagerAppointmentReview.tsx
msgid "{fullName} isn't a member of {groupName}"
msgstr "{fullName} ist kein Mitglied von {groupName}"

#: front/components/groups/useGroupManagerAppointmentReview.tsx
msgid "As manager, they can add anyone to the group, including themselves. Anyone they add gains the group's permissions and access to every space and data source shared with it. Continue only if you trust {firstName} with those permissions."
msgstr "Als Manager kann diese Person beliebige Personen zur Gruppe hinzufügen, auch sich selbst. Jede hinzugefügte Person erhält die Berechtigungen der Gruppe und Zugriff auf alle Bereiche und Datenquellen, die mit ihr geteilt werden. Fahren Sie nur fort, wenn Sie {firstName} diese Berechtigungen anvertrauen."

#: front/components/groups/useGroupManagerAppointmentReview.tsx
msgid "{managerCount, plural, one {# person you're appointing isn't a member of {groupName}} other {# people you're appointing aren't members of {groupName}}}"
msgstr "{managerCount, plural, one {# Person, die Sie ernennen, ist kein Mitglied von {groupName}} other {# Personen, die Sie ernennen, sind keine Mitglieder von {groupName}}}"

#: front/components/groups/useGroupManagerAppointmentReview.tsx
msgid "As managers, they can add anyone to the group, including themselves. Anyone they add gains the group's permissions and access to every space and data source shared with it. Continue only if you trust them with those permissions."
msgstr "Als Manager können diese Personen beliebige Personen zur Gruppe hinzufügen, auch sich selbst. Jede hinzugefügte Person erhält die Berechtigungen der Gruppe und Zugriff auf alle Bereiche und Datenquellen, die mit ihr geteilt werden. Fahren Sie nur fort, wenn Sie ihnen diese Berechtigungen anvertrauen."

#: front/components/groups/useGroupManagerAppointmentReview.tsx
msgid "Appoint anyway"
msgstr "Trotzdem ernennen"
