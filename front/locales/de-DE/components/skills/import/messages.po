#: front/components/skills/import/ConnectWorkspaceGitHubMessage.tsx
msgid "Connect GitHub to import from private repositories"
msgstr "Verbinden Sie GitHub, um aus privaten Repositorys zu importieren"

#: front/components/skills/import/ConnectWorkspaceGitHubMessage.tsx
msgid "Connect a GitHub account to grant access. All workspace members will share this connection."
msgstr "Verbinden Sie ein GitHub-Konto, um Zugriff zu gewähren. Alle Mitglieder des Workspace nutzen diese Verbindung gemeinsam."

#: front/components/skills/import/ConnectWorkspaceGitHubMessage.tsx
msgid "Connect GitHub"
msgstr "GitHub verbinden"

#: front/components/skills/import/DetectedSkillsList.tsx
msgid "Skill name already in use"
msgstr "Name der Fähigkeit bereits vergeben"

#: front/components/skills/import/DetectedSkillsList.tsx
msgid "Override existing skill"
msgstr "Vorhandene Fähigkeit überschreiben"

#: front/components/skills/import/DetectedSkillsList.tsx
msgid "Invalid skill format"
msgstr "Ungültiges Fähigkeitsformat"

#: front/components/skills/import/DetectedSkillsList.tsx
msgid "Skill name"
msgstr "Name der Fähigkeit"

#: front/components/skills/import/DetectedSkillsList.tsx
msgid "Status"
msgstr "Status"

#: front/components/skills/import/DetectedSkillsList.tsx
msgid "Detecting skills"
msgstr "Fähigkeiten werden erkannt"

#: front/components/skills/import/DetectedSkillsList.tsx
msgid "Detection failed"
msgstr "Erkennung fehlgeschlagen"

#: front/components/skills/import/GitHubConnectionRow.tsx
msgid "Access repository - Shared connection"
msgstr "Repository-Zugriff - Gemeinsame Verbindung"

#: front/components/skills/import/GitHubConnectionRow.tsx
msgid "Connected"
msgstr "Verbunden"

#: front/components/skills/import/GitHubConnectionRow.tsx
msgid "More options"
msgstr "Weitere Optionen"

#: front/components/skills/import/GitHubConnectionRow.tsx
msgid "Disconnect"
msgstr "Trennen"

#: front/components/skills/import/ImportFromFilesTab.tsx
msgid "Only .zip or .skill files are accepted."
msgstr "Nur .zip- oder .skill-Dateien werden akzeptiert."

#: front/components/skills/import/ImportFromFilesTab.tsx
msgid "Drop files here"
msgstr "Dateien hier ablegen"

#: front/components/skills/import/ImportFromFilesTab.tsx
msgid "Upload .zip or .skill files"
msgstr ".zip- oder .skill-Dateien hochladen"

#: front/components/skills/import/ImportFromFilesTab.tsx
msgid "Uploading files..."
msgstr "Dateien werden hochgeladen…"

#: front/components/skills/import/ImportFromFilesTab.tsx
msgid "Drag and drop or click to upload"
msgstr "Per Drag-and-drop ablegen oder zum Hochladen klicken"

#: front/components/skills/import/ImportFromFilesTab.tsx
msgid "Upload files"
msgstr "Dateien hochladen"

#: front/components/skills/import/ImportFromFilesTab.tsx
msgid "File requirements"
msgstr "Dateianforderungen"

#: front/components/skills/import/ImportFromFilesTab.tsx
msgid "The imported .zip or .skill archive must include a SKILL.md file"
msgstr "Das importierte .zip- oder .skill-Archiv muss eine SKILL.md-Datei enthalten"

#: front/components/skills/import/ImportFromFilesTab.tsx
msgid "This file must contain the skill name and description formatted in YAML"
msgstr "Diese Datei muss den Namen und die Beschreibung der Fähigkeit im YAML-Format enthalten"

#: front/components/skills/import/ImportFromFilesTab.tsx
msgid "Read more about importing skills <0>here</0>."
msgstr "Weitere Informationen zum Importieren von Fähigkeiten finden Sie <0>hier</0>."

#: front/components/skills/import/ImportFromRepositoryTab.tsx
msgid "GitHub connection can't access this repository"
msgstr "GitHub-Verbindung kann nicht auf dieses Repository zugreifen"

#: front/components/skills/import/ImportFromRepositoryTab.tsx
msgid "The currently connected GitHub account can't access this repository. Check the URL or reconnect with an account that has access."
msgstr "Das aktuell verbundene GitHub-Konto kann nicht auf dieses Repository zugreifen. Prüfen Sie die URL oder verbinden Sie sich erneut mit einem Konto, das Zugriff hat."

#: front/components/skills/import/ImportFromRepositoryTab.tsx
msgid "The currently connected GitHub account can't access this repository. Check the URL or ask an admin to reconnect with an account that has access."
msgstr "Das aktuell verbundene GitHub-Konto kann nicht auf dieses Repository zugreifen. Prüfen Sie die URL oder bitten Sie einen Administrator, die Verbindung mit einem Konto herzustellen, das Zugriff hat."

#: front/components/skills/import/ImportFromRepositoryTab.tsx
msgid "Repository not found"
msgstr "Repository nicht gefunden"

#: front/components/skills/import/ImportFromRepositoryTab.tsx
msgid "Check the URL. For private repos, ask an admin to connect a GitHub account with access."
msgstr "Prüfen Sie die URL. Bitten Sie bei privaten Repositorys einen Administrator, ein GitHub-Konto mit Zugriff zu verbinden."

#: front/components/skills/import/ImportSkillsDialog.tsx
msgid "Enter a GitHub repository URL to detect skills."
msgstr "Geben Sie die URL eines GitHub-Repositorys ein, um Fähigkeiten zu erkennen."

#: front/components/skills/import/ImportSkillsDialog.tsx
msgid "Upload a .zip or .skill file with your skills."
msgstr "Laden Sie eine .zip- oder .skill-Datei mit Ihren Fähigkeiten hoch."

#: front/components/skills/import/ImportSkillsDialog.tsx
msgid "Detecting skills..."
msgstr "Fähigkeiten werden erkannt…"

#: front/components/skills/import/ImportSkillsDialog.tsx
msgid "{detectedCount, plural, one {# skill detected. Select the ones to import.} other {# skills detected. Select the ones to import.}}"
msgstr "{detectedCount, plural, one {# Fähigkeit erkannt. Wählen Sie die zu importierenden aus.} other {# Fähigkeiten erkannt. Wählen Sie die zu importierenden aus.}}"

#: front/components/skills/import/ImportSkillsDialog.tsx
msgid "Import skills"
msgstr "Fähigkeiten importieren"

#: front/components/skills/import/ImportSkillsDialog.tsx
msgid "Repository"
msgstr "Repository"

#: front/components/skills/import/ImportSkillsDialog.tsx
msgid "Files"
msgstr "Dateien"

#: front/components/skills/import/ImportSkillsDialog.tsx
msgid "Cancel"
msgstr "Abbrechen"

#: front/components/skills/import/ImportSkillsDialog.tsx
msgid "Importing skills"
msgstr "Fähigkeiten werden importiert"

#: front/components/skills/import/ImportSkillsDialog.tsx
msgctxt "verb, button label"
msgid "Import"
msgstr "Importieren"

#: front/components/skills/import/formSchema.ts
msgid "Select at least one skill to import"
msgstr "Wählen Sie mindestens eine Fähigkeit zum Importieren aus."

#: front/components/skills/import/formSchema.ts
msgid "A repository URL is required"
msgstr "Eine Repository-URL ist erforderlich."
