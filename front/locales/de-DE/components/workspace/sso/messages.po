#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "De-activate Auto-join"
msgstr "Automatischen Beitritt deaktivieren"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Activate Auto-join"
msgstr "Automatischen Beitritt aktivieren"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "De-activate"
msgstr "Deaktivieren"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Activate"
msgstr "Aktivieren"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "New members will need to be invited in order to gain access to your Dust workspace."
msgstr "Neue Mitglieder müssen eingeladen werden, um Zugriff auf Ihren Dust-Workspace zu erhalten."

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Anyone with a <0>{domainList}</0> email will have access to your Dust workspace."
msgstr "Alle Personen mit einer E-Mail-Adresse von <0>{domainList}</0> erhalten Zugriff auf Ihren Dust-Workspace."

#: front/components/workspace/sso/AutoJoinToggle.tsx
#: front/components/workspace/sso/MultiDomainAutoJoinModal.tsx
#: front/components/workspace/sso/Toggle.tsx
msgid "Update failed"
msgstr "Aktualisierung fehlgeschlagen"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Failed to enable auto-add for whitelisted domain."
msgstr "Das automatische Hinzufügen für die zugelassene Domain konnte nicht aktiviert werden."

#: front/components/workspace/sso/AutoJoinToggle.tsx
#: front/components/workspace/sso/MultiDomainAutoJoinModal.tsx
#: front/components/workspace/sso/Toggle.tsx
#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Cancel"
msgstr "Abbrechen"

#: front/components/workspace/sso/AutoJoinToggle.tsx
#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Free plan"
msgstr "Kostenloser Tarif"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "You cannot enable auto-join with the free plan. Upgrade your plan to invite other members."
msgstr "Mit dem kostenlosen Tarif können Sie den automatischen Beitritt nicht aktivieren. Wechseln Sie auf einen höheren Tarif, um weitere Mitglieder einzuladen."

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Joining the workspace"
msgstr "Beitritt zum Workspace"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Auto-join workspace"
msgstr "Workspace automatisch beitreten"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "{domainCount, plural, one {Allow your team members to access your Dust workspace when they authenticate with {domainList} account.} other {Allow your team members to access your Dust workspace when they authenticate with {domainList} accounts.}}"
msgstr "{domainCount, plural, one {Erlauben Sie Ihren Teammitgliedern den Zugriff auf Ihren Dust-Workspace, wenn sie sich mit einem Konto von {domainList} authentifizieren.} other {Erlauben Sie Ihren Teammitgliedern den Zugriff auf Ihren Dust-Workspace, wenn sie sich mit Konten von {domainList} authentifizieren.}}"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Allow your team members to access your Dust workspace when they authenticate with verified accounts."
msgstr "Erlauben Sie Ihren Teammitgliedern den Zugriff auf Ihren Dust-Workspace, wenn sie sich mit verifizierten Konten authentifizieren."

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Configure"
msgstr "Konfigurieren"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Enable Auto-join"
msgstr "Automatischen Beitritt aktivieren"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Auto-join is not available when SSO is enforced"
msgstr "Automatischer Beitritt ist nicht verfügbar, wenn SSO erzwungen wird"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Add a domain to enable Auto-join"
msgstr "Fügen Sie eine Domain hinzu, um den automatischen Beitritt zu aktivieren"

#: front/components/workspace/sso/AutoJoinToggle.tsx
msgid "Verify a domain to enable Auto-join"
msgstr "Verifizieren Sie eine Domain, um den automatischen Beitritt zu aktivieren"

#: front/components/workspace/sso/MultiDomainAutoJoinModal.tsx
msgid "Failed to update auto-join settings."
msgstr "Die Einstellungen für den automatischen Beitritt konnten nicht aktualisiert werden."

#: front/components/workspace/sso/MultiDomainAutoJoinModal.tsx
msgid "Configure Auto-join"
msgstr "Automatischen Beitritt konfigurieren"

#: front/components/workspace/sso/MultiDomainAutoJoinModal.tsx
msgid "Select which domains should allow users to automatically join your workspace when they sign up with a matching email address."
msgstr "Wählen Sie die Domains aus, deren Nutzer Ihrem Workspace automatisch beitreten können, wenn sie sich mit einer passenden E-Mail-Adresse registrieren."

#: front/components/workspace/sso/MultiDomainAutoJoinModal.tsx
msgid "Saving..."
msgstr "Wird gespeichert…"

#: front/components/workspace/sso/MultiDomainAutoJoinModal.tsx
msgid "Save"
msgstr "Speichern"

#: front/components/workspace/sso/Toggle.tsx
msgid "Enable Single Sign-On enforcement"
msgstr "SSO-Pflicht aktivieren"

#: front/components/workspace/sso/Toggle.tsx
msgid "By enforcing SSO, access through social media logins will be discontinued. Instead, you'll be directed to sign in via the SSO portal. Please note, this change will require all users to sign out and reconnect using SSO."
msgstr "Wenn Sie SSO erzwingen, ist die Anmeldung über soziale Netzwerke nicht mehr möglich. Stattdessen werden Sie zur Anmeldung an das SSO-Portal weitergeleitet. Beachten Sie, dass sich alle Nutzer danach abmelden und über SSO erneut anmelden müssen."

#: front/components/workspace/sso/Toggle.tsx
msgid "Enforce Single Sign-On"
msgstr "SSO erzwingen"

#: front/components/workspace/sso/Toggle.tsx
msgid "Disable Single Sign-On enforcement"
msgstr "SSO-Pflicht deaktivieren"

#: front/components/workspace/sso/Toggle.tsx
msgid "By disabling SSO enforcement, users will have the flexibility to login with social media."
msgstr "Wenn Sie die SSO-Pflicht deaktivieren, können sich Nutzer auch über soziale Netzwerke anmelden."

#: front/components/workspace/sso/Toggle.tsx
msgid "Failed to enforce sso on workspace."
msgstr "SSO konnte für den Workspace nicht erzwungen werden."

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Authentication and access"
msgstr "Authentifizierung und Zugriff"

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Single Sign-On (SSO)"
msgstr "Einmalanmeldung (SSO)"

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Enabled"
msgstr "Aktiviert"

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Manage your enterprise identity provider (IdP) settings and user provisioning via WorkOS."
msgstr "Verwalten Sie die Einstellungen Ihres Unternehmens-Identitätsanbieters (IdP) und die Nutzerbereitstellung über WorkOS."

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Configure SSO"
msgstr "SSO konfigurieren"

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "De-activate SSO"
msgstr "SSO deaktivieren"

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Activate SSO"
msgstr "SSO aktivieren"

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Add a domain to enable SSO"
msgstr "Fügen Sie eine Domain hinzu, um SSO zu aktivieren"

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Enforce SSO login"
msgstr "SSO-Anmeldung erzwingen"

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "When SSO is enforced, users will no longer be able to use social logins and will be redirected to the SSO portal."
msgstr "Wenn SSO erzwungen wird, können sich Nutzer nicht mehr über soziale Netzwerke anmelden und werden zum SSO-Portal weitergeleitet."

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "You cannot enable SSO with the free plan. Upgrade your plan to access SSO features."
msgstr "Mit dem kostenlosen Tarif können Sie SSO nicht aktivieren. Wechseln Sie auf einen höheren Tarif, um die SSO-Funktionen zu nutzen."

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Disable {connectionType} Single Sign-On"
msgstr "{connectionType}-SSO deaktivieren"

#: front/components/workspace/sso/WorkOSSSOConnection.tsx
msgid "Anyone with an {connectionType} account won't be able to access your Dust workspace anymore."
msgstr "Personen mit einem {connectionType}-Konto können nicht mehr auf Ihren Dust-Workspace zugreifen."
