#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Allow a Slack workflow"
msgstr "Slack-Workflow zulassen"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Anyone who can run the workflow in Slack will be able to summon agents through it, guests included."
msgstr "Jeder, der den Workflow in Slack ausführen kann, kann darüber Agenten aufrufen, auch Gäste."

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Workflow name"
msgstr "Name des Workflows"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "e.g. Weekly report"
msgstr "z. B. Wochenbericht"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "The sender name shown in Slack on the workflow's messages. It has to match exactly, spelling and capitalization included."
msgstr "Der in Slack bei den Nachrichten des Workflows angezeigte Absendername. Er muss genau übereinstimmen, einschließlich Schreibweise und Groß-/Kleinschreibung."

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Spaces it can reach"
msgstr "Erreichbare Bereiche"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Add spaces"
msgstr "Bereiche hinzufügen"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "Search spaces"
msgstr "Bereiche suchen"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "No space found"
msgstr "Kein Bereich gefunden"

#: front/components/workspace/analytics/automations/AllowSlackWorkflowDialog.tsx
msgid "The workflow always reaches agents shared in {GLOBAL_SPACE_NAME}. Add spaces to let it summon their agents too."
msgstr "Der Workflow erreicht immer die in {GLOBAL_SPACE_NAME} geteilten Agenten. Fügen Sie Bereiche hinzu, damit er auch deren Agenten aufrufen kann."

