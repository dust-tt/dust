msgstr "{defaultCapValue} (Standard)"

#: front/components/workspace/settings/SelfImprovingSkillsListSection.tsx
msgid "Skills"
msgstr "Fähigkeiten"

#: front/components/workspace/settings/SelfImprovingSkillsListSection.tsx
msgid "Search skills..."
msgstr "Fähigkeiten suchen…"

#: front/components/workspace/settings/SelfImprovingSkillsListSection.tsx
msgid "No active skills."
msgstr "Keine aktiven Fähigkeiten."

#: front/components/workspace/settings/SelfImprovingSkillsTogglesSection.tsx
msgid "Self-improving skills"
msgstr "Selbstverbessernde Fähigkeiten"

#: front/components/workspace/settings/SelfImprovingSkillsTogglesSection.tsx
msgid "Allow self-improving skills"
msgstr "Selbstverbessernde Fähigkeiten erlauben"

#: front/components/workspace/settings/SelfImprovingSkillsTogglesSection.tsx
msgid "Allow Dust to analyze conversations to improve your workspace's skills. Dust does not use conversations to train models."
msgstr "Dust erlauben, Unterhaltungen zu analysieren, um die Fähigkeiten Ihres Workspace zu verbessern. Dust verwendet Unterhaltungen nicht zum Trainieren von Modellen."

#: front/components/workspace/settings/SelfImprovingSkillsTogglesSection.tsx
msgid "Enable batch processing"
msgstr "Stapelverarbeitung aktivieren"

#: front/components/workspace/settings/SelfImprovingSkillsTogglesSection.tsx
msgid "Conversations are sent in batches to reduce costs. Data may remain on LLM provider servers for up to several hours before processing. Disable to ensure immediate data deletion (ZDR-compatible). This will increase your plan's pricing."
msgstr "Unterhaltungen werden zur Kostensenkung gebündelt gesendet. Daten können vor der Verarbeitung bis zu mehrere Stunden auf den Servern des LLM-Anbieters verbleiben. Deaktivieren Sie diese Option, um die sofortige Löschung der Daten sicherzustellen (ZDR-kompatibel). Dadurch steigt der Preis Ihres Tarifs."

#: front/components/workspace/settings/SlackPersonalFooterRemovalToggle.tsx
msgid "\"Sent via Agent\" Slack footer"
msgstr "Slack-Fußzeile „Sent via Agent“"

#: front/components/workspace/settings/SlackPersonalFooterRemovalToggle.tsx
msgid "Whether agents can remove the \"Sent via Agent\" footer on Slack messages posted with user credentials"
msgstr "Legt fest, ob Agenten die Fußzeile „Sent via Agent“ aus Slack-Nachrichten entfernen können, die mit den Anmeldedaten eines Mitglieds gepostet werden"

#: front/components/workspace/settings/VoiceTranscriptionToggle.tsx
msgid "Voice transcription"
msgstr "Sprachtranskription"

#: front/components/workspace/settings/VoiceTranscriptionToggle.tsx
msgid "Whether members can use voice transcription in conversations"
msgstr "Legt fest, ob Mitglieder die Sprachtranskription in Unterhaltungen verwenden können"

#: front/components/workspace/settings/WorkspaceAnalyticsToggle.tsx
msgid "Workspace Analyst"
msgstr "Analyst-Agent des Workspace"

#: front/components/workspace/settings/WorkspaceAnalyticsToggle.tsx
msgid "Whether workspace admins get the Analyst agent and analytics tools to explore how the workspace is used"
msgstr "Legt fest, ob Workspace-Administratoren den Analyst-Agenten und Statistik-Tools erhalten, um die Nutzung des Workspace zu untersuchen"

#: front/components/workspace/settings/WorkspaceDefaultAgentPicker.tsx
msgid "Warning"
msgstr "Warnung"

#: front/components/workspace/settings/WorkspaceDefaultAgentPicker.tsx
msgid "@Dust is designed to give your users the best experience by default. A custom default agent may not handle every request as reliably. Do you want to set it as the workspace default anyway?"
msgstr "@Dust ist darauf ausgelegt, Ihren Mitgliedern standardmäßig die beste Erfahrung zu bieten. Ein benutzerdefinierter Standard-Agent bearbeitet möglicherweise nicht jede Anfrage so zuverlässig. Möchten Sie ihn trotzdem als Standard-Agenten des Workspace festlegen?"

#: front/components/workspace/settings/WorkspaceDefaultAgentPicker.tsx
msgid "Yes"
msgstr "Ja"

#: front/components/workspace/settings/WorkspaceDefaultAgentPicker.tsx
msgid "No"
msgstr "Nein"

#: front/components/workspace/settings/WorkspaceDefaultAgentPicker.tsx
msgid "Default agent"
msgstr "Standard-Agent"

#: front/components/workspace/settings/WorkspaceDefaultAgentPicker.tsx
msgid "The agent pre-selected when anyone starts a new conversation in this workspace"
msgstr "Der Agent, der vorausgewählt ist, wenn jemand in diesem Workspace eine neue Unterhaltung beginnt"

#: front/components/workspace/settings/WorkspaceLocalePicker.tsx
msgid "Language"
msgstr "Sprache"

#: front/components/workspace/settings/WorkspaceLocalePicker.tsx
msgid "The default language of Dust for members who have not chosen their own"
msgstr "Die Standardsprache von Dust für Mitglieder, die keine eigene gewählt haben"

#: front/components/workspace/settings/WorkspaceNameEditor.tsx
msgid "Workspace name must only contain letters, numbers, and the characters `._-`"
msgstr "Der Workspace-Name darf nur Buchstaben, Ziffern und die Zeichen `._-` enthalten"

#: front/components/workspace/settings/WorkspaceNameEditor.tsx
msgid "Failed to update workspace."
msgstr "Der Workspace konnte nicht aktualisiert werden."

#: front/components/workspace/settings/WorkspaceNameEditor.tsx
msgid "Workspace name"
msgstr "Name des Workspace"

#: front/components/workspace/settings/WorkspaceNameEditor.tsx
