msgstr "Bearbeiten"

#: front/components/workspace/settings/WorkspaceNameEditor.tsx
msgid "Edit workspace name"
msgstr "Workspace-Namen bearbeiten"

#: front/components/workspace/settings/WorkspaceNameEditor.tsx
msgid "Think GitHub repository names, short and memorable."
msgstr "Denken Sie an GitHub-Repository-Namen: kurz und einprägsam."

#: front/components/workspace/settings/WorkspaceNameEditor.tsx
msgid "Saving..."
msgstr "Wird gespeichert…"

#: front/components/workspace/settings/WorkspaceNameEditor.tsx
