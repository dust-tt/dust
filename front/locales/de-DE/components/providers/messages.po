#: front/components/providers/ProviderSetup.tsx
msgid "{provider} API key"
msgstr "{provider}-API-Schlüssel"

#: front/components/providers/ProviderSetup.tsx
msgid "To use OpenAI models you must provide your API key. It can be found <0>here</0>."
msgstr "Um OpenAI-Modelle zu verwenden, müssen Sie Ihren API-Schlüssel angeben. Sie finden ihn <0>hier</0>."

#: front/components/providers/ProviderSetup.tsx
msgid "We'll never use your API key for anything other than to run your apps."
msgstr "Wir verwenden Ihren API-Schlüssel ausschließlich zum Ausführen Ihrer Apps."

#: front/components/providers/ProviderSetup.tsx
msgid "To use Azure OpenAI models you must provide your API key and endpoint. They can be found in the left menu of your OpenAI Azure Resource portal (menu item `Keys and Endpoint`)."
msgstr "Um Azure-OpenAI-Modelle zu verwenden, müssen Sie Ihren API-Schlüssel und Ihren Endpunkt angeben. Sie finden beide im linken Menü Ihres Azure-OpenAI-Ressourcenportals (Menüpunkt `Keys and Endpoint`)."

#: front/components/providers/ProviderSetup.tsx
msgid "To use Anthropic models you must provide your API key. It can be found <0>here</0> (you can create a new key specifically for Dust)."
msgstr "Um Anthropic-Modelle zu verwenden, müssen Sie Ihren API-Schlüssel angeben. Sie finden ihn <0>hier</0> (Sie können einen eigenen Schlüssel speziell für Dust erstellen)."

#: front/components/providers/ProviderSetup.tsx
msgid "To use Mistral AI models you must provide your API key. It can be found <0>here</0> (you can create a new key specifically for Dust)."
msgstr "Um Mistral-AI-Modelle zu verwenden, müssen Sie Ihren API-Schlüssel angeben. Sie finden ihn <0>hier</0> (Sie können einen eigenen Schlüssel speziell für Dust erstellen)."

#: front/components/providers/ProviderSetup.tsx
msgid "To use Google AI Studio models you must provide your API key. It can be found <0>here</0> (you can create a new key specifically for Dust)."
msgstr "Um Google-AI-Studio-Modelle zu verwenden, müssen Sie Ihren API-Schlüssel angeben. Sie finden ihn <0>hier</0> (Sie können einen eigenen Schlüssel speziell für Dust erstellen)."

#: front/components/providers/ProviderSetup.tsx
msgid "To use Deepseek models you must provide your API key."
msgstr "Um Deepseek-Modelle zu verwenden, müssen Sie Ihren API-Schlüssel angeben."

#: front/components/providers/ProviderSetup.tsx
msgid "To use Fireworks models you must provide your API key."
msgstr "Um Fireworks-Modelle zu verwenden, müssen Sie Ihren API-Schlüssel angeben."

#: front/components/providers/ProviderSetup.tsx
msgid "To use xAI's Grok models you must provide your API key. It can be found <0>here</0>."
msgstr "Um die Grok-Modelle von xAI zu verwenden, müssen Sie Ihren API-Schlüssel angeben. Sie finden ihn <0>hier</0>."

#: front/components/providers/ProviderSetup.tsx
msgid "SerpAPI lets you search Google (and other search engines). To use SerpAPI you must provide your API key. It can be found <0>here</0>."
msgstr "Mit SerpAPI können Sie Google (und andere Suchmaschinen) durchsuchen. Um SerpAPI zu verwenden, müssen Sie Ihren API-Schlüssel angeben. Sie finden ihn <0>hier</0>."

#: front/components/providers/ProviderSetup.tsx
msgid "Serper lets you search Google (and other search engines). To use Serper you must provide your API key. It can be found <0>here</0>."
msgstr "Mit Serper können Sie Google (und andere Suchmaschinen) durchsuchen. Um Serper zu verwenden, müssen Sie Ihren API-Schlüssel angeben. Sie finden ihn <0>hier</0>."

#: front/components/providers/ProviderSetup.tsx
msgid "Browserless lets you use headless browsers to scrape web content. To use Browserless, you must provide your API key. It can be found <0>here</0>."
msgstr "Mit Browserless können Sie Headless-Browser verwenden, um Webinhalte auszulesen. Um Browserless zu verwenden, müssen Sie Ihren API-Schlüssel angeben. Sie finden ihn <0>hier</0>."

#: front/components/providers/ProviderSetup.tsx
msgid "Note that it generally takes <0>5 mins</0> for the API key to become active (an email is sent when it's ready)."
msgstr "Beachten Sie, dass es in der Regel <0>5 Min.</0> dauert, bis der API-Schlüssel aktiv ist (Sie erhalten eine E-Mail, sobald er bereit ist)."

