msgstr "Verwendete Testnachrichten"

#: front/components/app/ViewAppAPIModal.tsx
msgid "You need to run this app at least once successfully to view the endpoint"
msgstr "Sie müssen diese App mindestens einmal erfolgreich ausführen, um den Endpunkt zu sehen."

#: front/components/app/ViewAppAPIModal.tsx
msgid "View how to run this app programmatically"
msgstr "Anzeigen, wie diese App über die API ausgeführt wird"

#: front/components/app/ViewAppAPIModal.tsx
msgid "Use with API"
msgstr "Mit der API verwenden"

#: front/components/app/ViewAppAPIModal.tsx
msgid "Apps API"
msgstr "Apps-API"

#: front/components/app/ViewAppAPIModal.tsx
msgid "Run app"
msgstr "App ausführen"

#: front/components/app/ViewAppAPIModal.tsx
msgid "Use the following cURL command to run the app <0>{appName}</0>:"
msgstr "Verwenden Sie den folgenden cURL-Befehl, um die App <0>{appName}</0> auszuführen:"

#: front/components/app/ViewAppAPIModal.tsx
msgid "Copied!"
msgstr "Kopiert!"

#: front/components/app/ViewAppAPIModal.tsx
msgid "Copy"
msgstr "Kopieren"

#: front/components/app/ViewAppAPIModal.tsx
msgid "API keys"
msgstr "API-Schlüssel"

#: front/components/app/ViewAppAPIModal.tsx
msgid "Manage workspace API keys"
msgstr "API-Schlüssel des Workspace verwalten"

#: front/components/app/ViewAppAPIModal.tsx
msgid "API keys are managed by workspace admins."
msgstr "API-Schlüssel werden von den Administratoren des Workspace verwaltet."

#: front/components/app/ViewAppAPIModal.tsx
msgid "Handle API keys with care as they provide access to your company data."
msgstr "Gehen Sie sorgfältig mit API-Schlüsseln um, da sie Zugriff auf die Daten Ihres Unternehmens gewähren."

#: front/components/app/ViewAppAPIModal.tsx
msgid "Documentation"
msgstr "Dokumentation"

#: front/components/app/ViewAppAPIModal.tsx
msgid "For a detailed documentation of the Data source API, please refer to the <0>API reference</0>"
msgstr "Eine ausführliche Dokumentation der Datenquellen-API finden Sie in der <0>API-Referenz</0>"
