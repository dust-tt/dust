msgstr "Fehler beim Parsen der JSONL-Zeile {lineIndex}: {parseError}"

#: front/components/app/DatasetView.tsx
msgid "Dataset size is currently limited to 256 entries"
msgstr "Die Größe eines Datensatzes ist derzeit auf 256 Einträge begrenzt."

#: front/components/app/DatasetView.tsx
msgid "JSONL upload size is currently limited to 512KB"
msgstr "Die Größe hochgeladener JSONL-Dateien ist derzeit auf 512 KB begrenzt."

#: front/components/app/DatasetView.tsx
msgid "Dataset name"
msgstr "Name des Datensatzes"

#: front/components/app/DatasetView.tsx
