msgid "{displayedLimit, plural, one {{usedCredits} / {limitCredits} credit per month} other {{usedCredits} / {limitCredits} credits per month}}"
msgstr "{displayedLimit, plural, one {{usedCredits} / {limitCredits} Credit pro Monat} other {{usedCredits} / {limitCredits} Credits pro Monat}}"

