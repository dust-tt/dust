msgstr "Neuen Datensatz erstellen"

#: front/components/app/DatasetView.tsx
msgid "A dataset with the same name already exists"
msgstr "Ein Datensatz mit diesem Namen existiert bereits."

#: front/components/app/DatasetView.tsx
msgid "Dataset name must only contain letters, numbers, and the characters `._-`"
msgstr "Der Name des Datensatzes darf nur Buchstaben, Ziffern und die Zeichen `._-` enthalten."

#: front/components/app/DatasetView.tsx
msgid "Key already exists"
msgstr "Der Schlüssel existiert bereits."

#: front/components/app/DatasetView.tsx
msgid "Please choose a different key"
msgstr "Wählen Sie einen anderen Schlüssel."

#: front/components/app/DatasetView.tsx
