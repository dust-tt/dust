msgstr "{displayedLimit, plural, one {{usedCredits} / {limitCredits} Credit} other {{usedCredits} / {limitCredits} Credits}}"

#: front/components/app/FairUseCreditsUsage.tsx
msgid "Fair usage"
msgstr "Angemessene Nutzung"

#: front/components/app/FairUseCreditsUsage.tsx
msgid "Fair Use policy"
msgstr "Richtlinie zur angemessenen Nutzung"

#: front/components/app/ModelPicker.tsx
msgid "Setup provider"
msgstr "Anbieter einrichten"

#: front/components/app/ModelPicker.tsx
msgid "No provider available"
msgstr "Kein Anbieter verfügbar"

#: front/components/app/ModelPicker.tsx
msgid "Select provider"
msgstr "Anbieter auswählen"

#: front/components/app/ModelPicker.tsx
msgid "Loading models..."
msgstr "Modelle werden geladen…"

#: front/components/app/NewBlock.tsx
msgid "Interact with a large language model (LLM)"
msgstr "Mit einem großen Sprachmodell (LLM) interagieren"

#: front/components/app/NewBlock.tsx
msgid "Query a large language model using a message-based interface."
msgstr "Ein großes Sprachmodell über eine nachrichtenbasierte Schnittstelle abfragen."

#: front/components/app/NewBlock.tsx
msgid "Data array"
msgstr "Datenarray"

#: front/components/app/NewBlock.tsx
msgid "Load a dataset and output its elements as an array. Typically used to seed few-shot prompts."
msgstr "Einen Datensatz laden und seine Elemente als Array ausgeben. Wird meist für Few-Shot-Prompts verwendet."

#: front/components/app/NewBlock.tsx
msgid "Run Javascript"
msgstr "JavaScript ausführen"

#: front/components/app/NewBlock.tsx
msgid "Run a snippet of JavaScript to modify, augment, or combine results from other blocks."
msgstr "Ein JavaScript-Snippet ausführen, um Ergebnisse anderer Blöcke zu ändern, zu erweitern oder zu kombinieren."

#: front/components/app/NewBlock.tsx
msgid "Search a datasource"
msgstr "Datenquelle durchsuchen"

#: front/components/app/NewBlock.tsx
msgid "Perform semantic search against chunked documents from a DataSource."
msgstr "Semantische Suche in aufgeteilten Dokumenten einer Datenquelle durchführen."

#: front/components/app/NewBlock.tsx
msgid "cURL Request"
msgstr "cURL-Anfrage"

#: front/components/app/NewBlock.tsx
msgid "Perform an HTTP request to interface with external services."
msgstr "Eine HTTP-Anfrage ausführen, um mit externen Diensten zu interagieren."

#: front/components/app/NewBlock.tsx
msgid "Extract website data"
msgstr "Website-Daten extrahieren"

#: front/components/app/NewBlock.tsx
msgid "Download the HTML or text content of page on the web (or a portion of it)."
msgstr "Den HTML- oder Textinhalt einer Webseite (oder eines Teils davon) herunterladen."

#: front/components/app/NewBlock.tsx
msgid "Google Search"
msgstr "Google-Suche"

#: front/components/app/NewBlock.tsx
msgid "Issue a query to Google so you can feed the results to other blocks."
msgstr "Eine Anfrage an Google senden, um die Ergebnisse an andere Blöcke weiterzugeben."

#: front/components/app/NewBlock.tsx
msgid "Map Reduce loop"
msgstr "Map-Reduce-Schleife"

#: front/components/app/NewBlock.tsx
msgid "Map over an array and execute a sequence of blocks in parallel."
msgstr "Über ein Array iterieren und eine Folge von Blöcken parallel ausführen."

#: front/components/app/NewBlock.tsx
msgid "While loop"
msgstr "While-Schleife"

#: front/components/app/NewBlock.tsx
msgid "Loop over a set of blocks until a condition is met."
msgstr "Eine Gruppe von Blöcken wiederholen, bis eine Bedingung erfüllt ist."

#: front/components/app/NewBlock.tsx
msgid "Retrieve a database schema"
msgstr "Datenbankschema abrufen"

#: front/components/app/NewBlock.tsx
msgid "Retrieve the schema of a database."
msgstr "Das Schema einer Datenbank abrufen."

#: front/components/app/NewBlock.tsx
msgid "Query a database"
msgstr "Datenbank abfragen"

#: front/components/app/NewBlock.tsx
msgid "Query a database by executing SQL queries on structured data sources."
msgstr "Eine Datenbank abfragen, indem SQL-Abfragen auf strukturierten Datenquellen ausgeführt werden."

#: front/components/app/NewBlock.tsx
msgctxt "Dust app block name"
msgid "Input"
msgstr "Eingabe"

#: front/components/app/NewBlock.tsx
msgid "Select a dataset of inputs used for the design your Dust app. Each element in the dataset kicks off a separate parallel execution of the Dust app."
msgstr "Einen Datensatz mit Eingaben für die Gestaltung Ihrer Dust-App auswählen. Jedes Element des Datensatzes startet eine separate, parallele Ausführung der Dust-App."

#: front/components/app/NewBlock.tsx
msgid "Add block"
msgstr "Block hinzufügen"

#: front/components/app/ReachedLimitPopup.tsx
msgid "Your account has reached its limit of {credits, plural, one {# credit} other {# credits}} over the past 24 hours."
msgstr "Ihr Konto hat sein Limit von {credits, plural, one {# Credit} other {# Credits}} in den letzten 24 Stunden erreicht."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Your account has reached its limit of {credits, plural, one {# credit} other {# credits}} over the past 7 days."
msgstr "Ihr Konto hat sein Limit von {credits, plural, one {# Credit} other {# Credits}} in den letzten 7 Tagen erreicht."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Your account has reached its limit of {credits, plural, one {# credit} other {# credits}} over the past 30 days."
msgstr "Ihr Konto hat sein Limit von {credits, plural, one {# Credit} other {# Credits}} in den letzten 30 Tagen erreicht."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Your account has reached its limit of {credits, plural, one {# credit} other {# credits}} for your current plan."
msgstr "Ihr Konto hat sein Limit von {credits, plural, one {# Credit} other {# Credits}} für Ihren aktuellen Tarif erreicht."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Your workspace has reached its shared limit of {messages, plural, one {# message per user} other {# messages per user}} over the past 24 hours."
msgstr "Ihr Workspace hat sein gemeinsames Limit von {messages, plural, one {# Nachricht pro Nutzer} other {# Nachrichten pro Nutzer}} in den letzten 24 Stunden erreicht."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Your workspace has reached its shared limit of {messages, plural, one {# message per user} other {# messages per user}} for your current plan."
msgstr "Ihr Workspace hat sein gemeinsames Limit von {messages, plural, one {# Nachricht pro Nutzer} other {# Nachrichten pro Nutzer}} für Ihren aktuellen Tarif erreicht."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Plan limits"
msgstr "Tariflimits"

#: front/components/app/ReachedLimitPopup.tsx
msgid "Manage your subscription"
msgstr "Abonnement verwalten"

#: front/components/app/ReachedLimitPopup.tsx
msgid "Workspace has reached its member limit. Please upgrade or remove inactive members to add more."
msgstr "Der Workspace hat sein Mitgliederlimit erreicht. Wechseln Sie auf einen höheren Tarif oder entfernen Sie inaktive Mitglieder, um weitere hinzuzufügen."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Free plan"
msgstr "Kostenloser Tarif"

#: front/components/app/ReachedLimitPopup.tsx
msgid "You cannot invite other members with the free plan. Upgrade your plan for unlimited members."
msgstr "Mit dem kostenlosen Tarif können Sie keine weiteren Mitglieder einladen. Wechseln Sie auf einen höheren Tarif, um unbegrenzt viele Mitglieder zu haben."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Failed payment"
msgstr "Fehlgeschlagene Zahlung"

#: front/components/app/ReachedLimitPopup.tsx
msgid "You cannot invite other members while your workspace has a failed payment."
msgstr "Sie können keine weiteren Mitglieder einladen, solange für Ihren Workspace eine Zahlung fehlgeschlagen ist."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Dust trial message limit reached"
msgstr "Nachrichtenlimit der Dust-Testphase erreicht"

#: front/components/app/ReachedLimitPopup.tsx
#: front/components/app/TrialMessageUsage.tsx
msgid "Subscribe to Dust"
msgstr "Dust abonnieren"

#: front/components/app/ReachedLimitPopup.tsx
msgid "Ok"
msgstr "OK"

#: front/components/app/ReachedLimitPopup.tsx
msgid "You have reached the message limit under the trial. You can subscribe to a paid plan to continue using Dust."
msgstr "Sie haben das Nachrichtenlimit der Testphase erreicht. Sie können einen kostenpflichtigen Tarif abonnieren, um Dust weiter zu nutzen."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Credit quota exceeded"
msgstr "Credit-Kontingent überschritten"

#: front/components/app/ReachedLimitPopup.tsx
msgid "We've paused messaging for your account due to our fair usage policy."
msgstr "Wir haben das Senden von Nachrichten für Ihr Konto aufgrund unserer Richtlinie zur angemessenen Nutzung pausiert."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Check our <0>Fair Use policy</0> to learn more."
msgstr "Weitere Informationen finden Sie in unserer <0>Richtlinie zur angemessenen Nutzung</0>."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Message quota exceeded"
msgstr "Nachrichtenkontingent überschritten"

#: front/components/app/ReachedLimitPopup.tsx
msgid "We've paused messaging for your workspace due to our fair usage policy."
msgstr "Wir haben das Senden von Nachrichten für Ihren Workspace aufgrund unserer Richtlinie zur angemessenen Nutzung pausiert."

#: front/components/app/ReachedLimitPopup.tsx
msgid "This total limit is collectively shared by all users in the workspace."
msgstr "Dieses Gesamtlimit wird von allen Mitgliedern des Workspace gemeinsam genutzt."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Workspace out of credits"
msgstr "Workspace hat keine Credits mehr"

#: front/components/app/ReachedLimitPopup.tsx
msgid "Manage credits"
msgstr "Credits verwalten"

#: front/components/app/ReachedLimitPopup.tsx
msgid "Your workspace has run out of credits. Please purchase more credits to continue using Dust."
msgstr "Ihr Workspace hat keine Credits mehr. Kaufen Sie weitere Credits, um Dust weiter zu nutzen."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Your workspace has run out of credits. Please contact your administrator to purchase more credits."
msgstr "Ihr Workspace hat keine Credits mehr. Wenden Sie sich an Ihren Administrator, um weitere Credits zu kaufen."

#: front/components/app/ReachedLimitPopup.tsx
msgid "No seat assigned"
msgstr "Kein Platz zugewiesen"

#: front/components/app/ReachedLimitPopup.tsx
msgid "Go to usage page"
msgstr "Zur Nutzungsseite"

#: front/components/app/ReachedLimitPopup.tsx
msgid "You don't have a seat assigned in this workspace. Go to the usage page to assign yourself one."
msgstr "Ihnen ist in diesem Workspace kein Platz zugewiesen. Auf der Nutzungsseite können Sie sich selbst einen zuweisen."

#: front/components/app/ReachedLimitPopup.tsx
msgid "You don't have a seat assigned in this workspace. Please contact your administrator to assign you one."
msgstr "Ihnen ist in diesem Workspace kein Platz zugewiesen. Wenden Sie sich an Ihren Administrator, damit er Ihnen einen zuweist."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Usage cap reached"
msgstr "Nutzungsobergrenze erreicht"

#: front/components/app/ReachedLimitPopup.tsx
msgid "Go to Usage"
msgstr "Zur Nutzung"

#: front/components/app/ReachedLimitPopup.tsx
msgid "You have reached your personal usage cap. On the usage page you can change your seat or adjust user caps."
msgstr "Sie haben Ihre persönliche Nutzungsobergrenze erreicht. Auf der Nutzungsseite können Sie Ihren Platz ändern oder die Nutzungsobergrenzen der Mitglieder anpassen."

#: front/components/app/ReachedLimitPopup.tsx
msgid "You have reached your personal usage cap. Please contact your Dust representative to adjust it."
msgstr "Sie haben Ihre persönliche Nutzungsobergrenze erreicht. Wenden Sie sich an Ihren Dust-Ansprechpartner, um sie anzupassen."

#: front/components/app/ReachedLimitPopup.tsx
msgid "You have reached your personal usage cap. Please contact your administrator to increase it."
msgstr "Sie haben Ihre persönliche Nutzungsobergrenze erreicht. Wenden Sie sich an Ihren Administrator, um sie zu erhöhen."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Group budget reached"
msgstr "Gruppenbudget erreicht"

#: front/components/app/ReachedLimitPopup.tsx
msgid "Your group has reached its budget. You can adjust group budgets on the usage page."
msgstr "Ihre Gruppe hat ihr Budget erreicht. Auf der Nutzungsseite können Sie die Gruppenbudgets anpassen."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Your group has reached its budget. Please contact your group managers or administrator to increase it."
msgstr "Ihre Gruppe hat ihr Budget erreicht. Wenden Sie sich an die Manager Ihrer Gruppe oder Ihren Administrator, um es zu erhöhen."

#: front/components/app/ReachedLimitPopup.tsx
msgid "Cancel"
msgstr "Abbrechen"

#: front/components/app/SpecRunView.tsx
msgid "Unknown block type: {blockType}"
msgstr "Unbekannter Blocktyp: {blockType}"

#: front/components/app/TrialMessageUsage.tsx
