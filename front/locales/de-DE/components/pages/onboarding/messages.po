msgid "Please enter your phone number."
msgstr "Geben Sie Ihre Telefonnummer ein."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Please enter a valid phone number."
msgstr "Geben Sie eine gültige Telefonnummer ein."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Unexpected error. Please try again."
msgstr "Unerwarteter Fehler. Versuchen Sie es erneut."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Too many verification attempts. Please try again in {waitMinutes, plural, one {# minute} other {# minutes}}."
msgstr "Zu viele Verifizierungsversuche. Versuchen Sie es in {waitMinutes, plural, one {# Minute} other {# Minuten}} erneut."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Please enter the full 6-digit code."
msgstr "Geben Sie den vollständigen 6-stelligen Code ein."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Network error. Please try again."
msgstr "Netzwerkfehler. Versuchen Sie es erneut."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Captcha could not load. Please refresh and try again."
msgstr "Das Captcha konnte nicht geladen werden. Aktualisieren Sie die Seite und versuchen Sie es erneut."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Verify your phone"
msgstr "Telefon verifizieren"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "We verify your number once to keep free credits fair. We won't text you otherwise."
msgstr "Wir verifizieren Ihre Nummer einmalig, um eine faire Nutzung der kostenlosen Credits zu gewährleisten. Darüber hinaus senden wir Ihnen keine SMS."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Phone number"
msgstr "Telefonnummer"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "To start your free trial, we need to verify your account with an SMS code."
msgstr "Um Ihre kostenlose Testphase zu starten, müssen wir Ihr Konto mit einem SMS-Code verifizieren."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Your number will only be used for this verification."
msgstr "Ihre Nummer wird nur für diese Verifizierung verwendet."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Sending..."
msgstr "Wird gesendet…"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Send code"
msgstr "Code senden"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Enter verification code"
msgstr "Bestätigungscode eingeben"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "A verification code has been sent to <0>{maskedPhone}</0>"
msgstr "Ein Bestätigungscode wurde an <0>{maskedPhone}</0> gesendet"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Back"
msgstr "Zurück"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Resend code ({resendCooldown}s)"
msgstr "Code erneut senden ({resendCooldown} s)"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Resend code"
msgstr "Code erneut senden"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Verifying..."
msgstr "Wird verifiziert…"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Verify now"
msgstr "Jetzt verifizieren"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Verify you're human"
msgstr "Bestätigen Sie, dass Sie ein Mensch sind"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "A quick check before we send your verification code."
msgstr "Eine kurze Prüfung, bevor wir Ihren Bestätigungscode senden."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Your phone number has already been verified."
msgstr "Ihre Telefonnummer wurde bereits verifiziert."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Click below to activate your free subscription."
msgstr "Klicken Sie unten, um Ihr kostenloses Abonnement zu aktivieren."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Activating..."
msgstr "Wird aktiviert…"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "Activate trial"
msgstr "Testphase aktivieren"

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "You're in. Welcome to Dust."
msgstr "Geschafft. Willkommen bei Dust."

#: front/components/pages/onboarding/VerifyPage.tsx
msgid "You've got <0>{formattedCredits} credits</0> to explore, they never expire, so take your time. Let's put them to work."
msgstr "Sie haben <0>{formattedCredits} Credits</0> zum Ausprobieren. Sie verfallen nie, lassen Sie sich also Zeit. Legen wir los."
