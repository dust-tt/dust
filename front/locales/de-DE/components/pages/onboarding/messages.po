msgid "Start your subscription"
msgstr "Abonnement starten"

#: front/components/pages/onboarding/SubscribePage.tsx
msgid "Resume your subscription"
msgstr "Abonnement fortsetzen"

#: front/components/pages/onboarding/SubscribePage.tsx
msgid "Start your subscription with yearly billing"
msgstr "Abonnement mit jährlicher Abrechnung starten"

#: front/components/pages/onboarding/SubscribePage.tsx
