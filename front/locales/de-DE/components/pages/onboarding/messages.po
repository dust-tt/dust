msgstr "Beim Einrichten Ihres Abonnements ist ein Fehler aufgetreten: {error}"

#: front/components/pages/onboarding/PaymentProcessingPage.tsx
msgid "Back to subscribe"
msgstr "Zurück zum Abonnement"

#: front/components/pages/onboarding/PaymentProcessingPage.tsx
msgid "Processing"
