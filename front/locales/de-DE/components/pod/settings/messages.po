#: front/components/pod/settings/PodSettingsCustomizationTab.tsx
msgid "@Dust is designed to give your users the best experience by default. A custom default agent may not handle every request as reliably. Do you want to set it as the default anyway?"
msgstr "@Dust ist darauf ausgelegt, Ihren Mitgliedern standardmäßig die beste Erfahrung zu bieten. Ein eigener Standard-Agent bearbeitet möglicherweise nicht jede Anfrage so zuverlässig. Möchten Sie ihn trotzdem als Standard festlegen?"

#: front/components/pod/settings/PodSettingsCustomizationTab.tsx
msgid "Yes"
msgstr "Ja"

#: front/components/pod/settings/PodSettingsCustomizationTab.tsx
msgid "No"
msgstr "Nein"

#: front/components/pod/settings/PodSettingsCustomizationTab.tsx
msgid "Default agent: {defaultAgentName} (workspace default)"
msgstr "Standard-Agent: {defaultAgentName} (Workspace-Standard)"

#: front/components/pod/settings/PodSettingsCustomizationTab.tsx
msgid "Default agent: {defaultAgentName}"
msgstr "Standard-Agent: {defaultAgentName}"

#: front/components/pod/settings/PodSettingsCustomizationTab.tsx
msgid "Workspace default"
msgstr "Workspace-Standard"

#: front/components/pod/settings/PodSettingsCustomizationTab.tsx
msgid "This Pod's default agent isn't available to you, so @Dust is used instead. Contact the editor of the Pod for more information."
msgstr "Der Standard-Agent dieses Pods ist für Sie nicht verfügbar, daher wird stattdessen @Dust verwendet. Wenden Sie sich für weitere Informationen an den Bearbeiter des Pods."

