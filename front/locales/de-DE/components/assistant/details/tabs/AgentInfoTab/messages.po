#: front/components/assistant/details/tabs/AgentInfoTab/RedactedAgentMessage.tsx
msgid "Security notice"
msgstr "Sicherheitshinweis"

#: front/components/assistant/details/tabs/AgentInfoTab/RedactedAgentMessage.tsx
msgid "By becoming an editor you will have access to this agent's private data (instructions, skills, knowledge). This action will be logged for security purposes. Do you want to proceed?"
msgstr "Wenn Sie Bearbeiter werden, erhalten Sie Zugriff auf die privaten Daten dieses Agenten (Anweisungen, Fähigkeiten, Wissen). Diese Aktion wird aus Sicherheitsgründen protokolliert. Möchten Sie fortfahren?"

#: front/components/assistant/details/tabs/AgentInfoTab/RedactedAgentMessage.tsx
msgid "Proceed"
msgstr "Fortfahren"

#: front/components/assistant/details/tabs/AgentInfoTab/RedactedAgentMessage.tsx
msgid "{missingSpacesCount, plural, one {You are about to join this space. This action will be logged for security purposes. Do you want to proceed?} other {You are about to join these spaces. This action will be logged for security purposes. Do you want to proceed?}}"
msgstr "{missingSpacesCount, plural, one {Sie sind dabei, diesem Bereich beizutreten. Diese Aktion wird aus Sicherheitsgründen protokolliert. Möchten Sie fortfahren?} other {Sie sind dabei, diesen Bereichen beizutreten. Diese Aktion wird aus Sicherheitsgründen protokolliert. Möchten Sie fortfahren?}}"

