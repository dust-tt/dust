#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Share"
msgstr "Teilen"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Share this frame"
msgstr "Dieses Frame teilen"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Could not load sharing settings."
msgstr "Die Freigabeeinstellungen konnten nicht geladen werden."

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Only workspace members can be added"
msgstr "Nur Workspace-Mitglieder können hinzugefügt werden"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Your admin has disabled external sharing. You can only invite people already in your workspace."
msgstr "Ihr Administrator hat das externe Teilen deaktiviert. Sie können nur Personen einladen, die bereits in Ihrem Workspace sind."

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "You don’t have permission to invite people outside your workspace. You can only invite people already in your workspace."
msgstr "Sie sind nicht berechtigt, Personen außerhalb Ihres Workspace einzuladen. Sie können nur Personen einladen, die bereits in Ihrem Workspace sind."

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "You no longer have permission to share frames publicly"
msgstr "Sie sind nicht mehr berechtigt, Frames öffentlich zu teilen"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "This frame is currently shared publicly. You can restrict access, but you won’t be able to make it public again."
msgstr "Dieses Frame ist derzeit öffentlich geteilt. Sie können den Zugriff einschränken, es danach aber nicht wieder öffentlich machen."

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Some referenced files cannot be shared"
msgstr "Einige referenzierte Dateien können nicht geteilt werden"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Viewers will only be able to access files you can verify. Fix or remove these references before sharing: {blockedRefs}"
msgstr "Betrachter können nur auf Dateien zugreifen, die Sie überprüfen können. Korrigieren oder entfernen Sie diese Verweise vor dem Teilen: {blockedRefs}"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
msgid "Who has access"
msgstr "Wer hat Zugriff"

#: front/components/assistant/conversation/interactive_content/frame/ShareFramePopover.tsx
