msgid "Invited by {grantedBy} {grantedAgo}"
msgstr "Eingeladen von {grantedBy} {grantedAgo}"

#: front/components/assistant/conversation/interactive_content/frame/FrameSharingGrants.tsx
msgid "Invited {grantedAgo}"
msgstr "Eingeladen {grantedAgo}"

