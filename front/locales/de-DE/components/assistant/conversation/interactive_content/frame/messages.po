msgstr "Nur auf Einladung"

#: front/components/assistant/conversation/interactive_content/frame/shareFrameScopeOptions.ts
msgid "Invited workspace members only"
msgstr "Nur eingeladene Workspace-Mitglieder"

#: front/components/assistant/conversation/interactive_content/frame/shareFrameScopeOptions.ts
msgid "All workspace members + invites"
msgstr "Alle Workspace-Mitglieder + Eingeladene"

#: front/components/assistant/conversation/interactive_content/frame/shareFrameScopeOptions.ts
msgid "All workspace members"
msgstr "Alle Workspace-Mitglieder"

#: front/components/assistant/conversation/interactive_content/frame/shareFrameScopeOptions.ts
msgid "Anyone with the link"
msgstr "Alle mit dem Link"

