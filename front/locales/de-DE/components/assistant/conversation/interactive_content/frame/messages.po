msgid "The Frame didn't respond. Your edits are still staged, try saving again."
msgstr "Das Frame hat nicht reagiert. Ihre Änderungen sind noch vorgemerkt. Versuchen Sie erneut zu speichern."

#: front/components/assistant/conversation/interactive_content/frame/useFrameEditSession.ts
msgid "Discard unsaved edits?"
msgstr "Ungespeicherte Änderungen verwerfen?"

#: front/components/assistant/conversation/interactive_content/frame/useFrameEditSession.ts
msgid "You have unsaved text edits. Leaving Edit will discard them."
msgstr "Sie haben ungespeicherte Textänderungen. Wenn Sie den Bearbeitungsmodus verlassen, werden sie verworfen."

#: front/components/assistant/conversation/interactive_content/frame/useFrameEditSession.ts
msgid "Discard"
msgstr "Verwerfen"
