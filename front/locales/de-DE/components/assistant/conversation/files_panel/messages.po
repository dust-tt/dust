#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Delete Frame?"
msgstr "Frame löschen?"

#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Are you sure you want to delete the Frame \"{fileName}\"? Its source, functions, databases and share links will be permanently removed. This action cannot be undone."
msgstr "Möchten Sie das Frame „{fileName}“ wirklich löschen? Quellcode, Funktionen, Datenbanken und Freigabelinks werden dauerhaft entfernt. Diese Aktion kann nicht rückgängig gemacht werden."

#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Delete folder?"
msgstr "Ordner löschen?"

#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Are you sure you want to delete \"{name}\" and all its contents? This action cannot be undone."
msgstr "Möchten Sie „{name}“ und den gesamten Inhalt wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden."

#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Delete file?"
msgstr "Datei löschen?"

#: front/components/assistant/conversation/files_panel/ConversationFileExplorer.tsx
msgid "Are you sure you want to delete \"{fileName}\"? This action cannot be undone."
msgstr "Möchten Sie „{fileName}“ wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden."

