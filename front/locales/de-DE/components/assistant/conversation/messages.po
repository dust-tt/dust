msgid "Workspace out of credits"
msgstr "Workspace hat keine Credits mehr"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Personal usage cap reached"
msgstr "Persönliche Nutzungsobergrenze erreicht"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Shared usage limit reached"
msgstr "Gemeinsames Nutzungslimit erreicht"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "No seat assigned"
msgstr "Kein Platz zugewiesen"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Plan message limit exceeded"
msgstr "Nachrichtenlimit des Tarifs überschritten"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Rate limit exceeded"
msgstr "Ratenlimit überschritten"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Your workspace has run out of credits. Purchase more credits to continue using Dust."
msgstr "Ihr Workspace hat keine Credits mehr. Kaufen Sie weitere Credits, um Dust weiter zu nutzen."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Your workspace has run out of credits. Contact your administrator to purchase more credits."
msgstr "Ihr Workspace hat keine Credits mehr. Wenden Sie sich an Ihren Administrator, um weitere Credits zu kaufen."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "You've reached your personal usage cap. You can adjust user caps on the usage page."
msgstr "Sie haben Ihre persönliche Nutzungsobergrenze erreicht. Sie können die Obergrenzen der Mitglieder auf der Nutzungsseite anpassen."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "You've reached your personal usage cap. Contact your administrator to increase it."
msgstr "Sie haben Ihre persönliche Nutzungsobergrenze erreicht. Wenden Sie sich an Ihren Administrator, um sie zu erhöhen."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Your group has reached its shared usage limit. You can adjust shared usage limits on the usage page."
msgstr "Ihre Gruppe hat ihr gemeinsames Nutzungslimit erreicht. Sie können gemeinsame Nutzungslimits auf der Nutzungsseite anpassen."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Your group has reached its shared usage limit. Contact your group managers or administrator to increase it."
msgstr "Ihre Gruppe hat ihr gemeinsames Nutzungslimit erreicht. Wenden Sie sich an die Manager Ihrer Gruppe oder Ihren Administrator, um es zu erhöhen."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "You don't have a seat assigned in this workspace. Go to the usage page to assign yourself one."
msgstr "Ihnen ist in diesem Workspace kein Platz zugewiesen. Auf der Nutzungsseite können Sie sich selbst einen zuweisen."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "You don't have a seat assigned in this workspace. Contact your administrator to assign you one."
msgstr "Ihnen ist in diesem Workspace kein Platz zugewiesen. Wenden Sie sich an Ihren Administrator, damit er Ihnen einen zuweist."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Too many steps"
msgstr "Zu viele Schritte"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "This agent took too many steps to answer your query. Try narrowing down your question or breaking it into smaller parts."
msgstr "Dieser Agent hat zu viele Schritte benötigt, um Ihre Anfrage zu beantworten. Versuchen Sie, Ihre Frage einzugrenzen oder in kleinere Teile aufzuteilen."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "No answer generated"
msgstr "Keine Antwort generiert"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Agent response generation failed"
msgstr "Generierung der Antwort fehlgeschlagen"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "An unexpected error occurred while generating the agent response. Try again."
msgstr "Beim Generieren der Antwort des Agenten ist ein unerwarteter Fehler aufgetreten. Versuchen Sie es erneut."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Model tier not enabled"
msgstr "Modellstufe nicht aktiviert"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "This agent uses a model tier that isn't enabled for you. Contact your workspace administrator or use another agent."
msgstr "Dieser Agent verwendet eine Modellstufe, die für Sie nicht aktiviert ist. Wenden Sie sich an den Administrator Ihres Workspace oder verwenden Sie einen anderen Agenten."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Early exit"
msgstr "Vorzeitiger Abbruch"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "A tool stopped before it finished. Check whether it completed, then retry."
msgstr "Ein Tool wurde vor dem Abschluss beendet. Prüfen Sie, ob es fertig ausgeführt wurde, und versuchen Sie es dann erneut."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Agent not available"
msgstr "Agent nicht verfügbar"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "This agent is no longer available to you. Contact your workspace administrator or use another agent."
msgstr "Dieser Agent ist für Sie nicht mehr verfügbar. Wenden Sie sich an den Administrator Ihres Workspace oder verwenden Sie einen anderen Agenten."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "The model this agent uses isn't available. Edit the agent to use another model (advanced settings in the Instructions panel)."
msgstr "Das von diesem Agenten verwendete Modell ist nicht verfügbar. Bearbeiten Sie den Agenten, um ein anderes Modell zu verwenden (erweiterte Einstellungen unter „Anweisungen“)."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Several tools have the same name. Each tool needs a unique name so the agent can pick the right one."
msgstr "Mehrere Tools haben denselben Namen. Jedes Tool braucht einen eindeutigen Namen, damit der Agent das richtige auswählen kann."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "You've reached the free usage cap for this 24-hour period. Try again later."
msgstr "Sie haben die kostenlose Nutzungsobergrenze für diesen 24-Stunden-Zeitraum erreicht. Versuchen Sie es später erneut."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "The agent tried to run an action that doesn't exist. You can retry."
msgstr "Der Agent hat versucht, eine Aktion auszuführen, die nicht existiert. Sie können es erneut versuchen."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "The agent sent invalid inputs to a tool."
msgstr "Der Agent hat ungültige Eingaben an ein Tool gesendet."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "The tool call couldn't be parsed."
msgstr "Der Tool-Aufruf konnte nicht analysiert werden."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "This tool isn't available to the agent."
msgstr "Dieses Tool ist für den Agenten nicht verfügbar."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "This answer was marked as failed because it stopped responding."
msgstr "Diese Antwort wurde als fehlgeschlagen markiert, da sie nicht mehr reagiert hat."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Context window exceeded"
msgstr "Kontextfenster überschritten"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Your message or retrieved data is too large. Break your request into smaller parts or reduce agent output."
msgstr "Ihre Nachricht oder die abgerufenen Daten sind zu groß. Teilen Sie Ihre Anfrage in kleinere Teile auf oder verringern Sie die Ausgabe des Agenten."

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Code: {code}"
msgstr "Code: {code}"

#: front/components/assistant/conversation/agentErrorMessages.ts
msgid "Message: {rawMessage}"
msgstr "Nachricht: {rawMessage}"

#: front/components/assistant/conversation/utils.ts
msgid "Unnamed parent conversation"
msgstr "Unbenannte übergeordnete Unterhaltung"

#: front/components/assistant/conversation/utils.ts
msgid "Compacting context, this may take a moment…"
msgstr "Kontext wird komprimiert, dies kann einen Moment dauern…"

#: front/components/assistant/conversation/utils.ts
msgid "Summarizing “{truncatedParentConversationTitle}”, this may take a moment…"
msgstr "„{truncatedParentConversationTitle}“ wird zusammengefasst, dies kann einen Moment dauern…"

#: front/components/assistant/conversation/utils.ts
msgid "Context compacted"
msgstr "Kontext komprimiert"

#: front/components/assistant/conversation/utils.ts
msgid "Summarized “{truncatedParentConversationTitle}” here"
msgstr "„{truncatedParentConversationTitle}“ hier zusammengefasst"

#: front/components/assistant/conversation/utils.ts
msgid "Summarized another conversation here"
msgstr "Eine andere Unterhaltung hier zusammengefasst"
