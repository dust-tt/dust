#: front/components/navigation/AdminSettingsSearchNav.tsx
msgid "Search"
msgstr "Suchen"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Check our <0>status page</0> for updates."
msgstr "Aktuelle Informationen finden Sie auf unserer <0>Statusseite</0>."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace is not operational"
msgstr "Ihr Workspace ist nicht betriebsbereit"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Model providers"
msgstr "Modellanbieter"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Contact your workspace admin."
msgstr "Wenden Sie sich an den Administrator Ihres Workspace."

#: front/components/navigation/AppStatusBanner.tsx
msgid "No provider credentials configured. Please set up at least one model provider."
msgstr "Keine Anbieter-Anmeldedaten konfiguriert. Richten Sie mindestens einen Modellanbieter ein."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Please set up your OpenAI credentials."
msgstr "Richten Sie Ihre OpenAI-Anmeldedaten ein."

#: front/components/navigation/AppStatusBanner.tsx
msgid "The following model providers have invalid credentials: {invalidProviderNames}."
msgstr "Die folgenden Modellanbieter haben ungültige Anmeldedaten: {invalidProviderNames}."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your payment has failed!"
msgstr "Ihre Zahlung ist fehlgeschlagen!"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Please make sure to update your payment method in the Admin section to maintain access to your workspace. We will retry in a few days."
msgstr "Aktualisieren Sie Ihre Zahlungsmethode im Administrationsbereich, um den Zugriff auf Ihren Workspace zu behalten. Wir versuchen es in einigen Tagen erneut."

#: front/components/navigation/AppStatusBanner.tsx
msgid "After 3 attempts, your workspace will be downgraded to the free plan. Connections will be deleted and members will be revoked. Details <0>here</0>."
msgstr "Nach 3 Versuchen wird Ihr Workspace auf den kostenlosen Tarif herabgestuft. Verbindungen werden gelöscht und der Zugriff der Mitglieder wird entzogen. Details <0>hier</0>."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Manage credits"
msgstr "Credits verwalten"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace is out of credits"
msgstr "Ihr Workspace hat keine Credits mehr"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace has used all its credits"
msgstr "Ihr Workspace hat alle Credits aufgebraucht"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace has run out of credits. Agents are blocked until you top up."
msgstr "Ihr Workspace hat keine Credits mehr. Agenten sind blockiert, bis Sie Credits aufladen."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace has used all of its included credits and is now billed pay-as-you-go. Top up to avoid overage charges."
msgstr "Ihr Workspace hat alle enthaltenen Credits aufgebraucht und wird nun nach Verbrauch abgerechnet. Laden Sie Credits auf, um Mehrkosten zu vermeiden."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Programmatic API cap reached"
msgstr "API-Limit erreicht"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Programmatic API cap at 80%"
msgstr "API-Limit bei 80 %"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace has exhausted its monthly programmatic API credit cap. Programmatic API calls are blocked until the billing cycle resets or the cap is raised."
msgstr "Ihr Workspace hat sein monatliches Limit für API-Credits ausgeschöpft. API-Aufrufe sind blockiert, bis der Abrechnungszeitraum neu beginnt oder das Limit erhöht wird."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace has used 80% of its monthly programmatic API credit cap. Consider raising the cap to avoid interruptions."
msgstr "Ihr Workspace hat 80 % seines monatlichen Limits für API-Credits verbraucht. Erhöhen Sie das Limit, um Unterbrechungen zu vermeiden."

#: front/components/navigation/AppStatusBanner.tsx
msgid "Manage usage"
msgstr "Nutzung verwalten"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your credit balance is running low"
msgstr "Ihr Credit-Guthaben wird knapp"

#: front/components/navigation/AppStatusBanner.tsx
msgid "Your workspace's remaining credit balance has dropped below the threshold you set. Top up to avoid running out of credits."
msgstr "Das verbleibende Credit-Guthaben Ihres Workspace ist unter den von Ihnen festgelegten Schwellenwert gefallen. Laden Sie Credits auf, damit sie nicht ausgehen."

#: front/components/navigation/Navigation.tsx
msgid "Open navigation"
msgstr "Navigation öffnen"

#: front/components/navigation/TrialBanner.tsx
msgid "Heads up, your trial has ended"
msgstr "Achtung, Ihre Testphase ist beendet"

#: front/components/navigation/TrialBanner.tsx
msgid "{daysRemaining, plural, one {Heads up, your trial ends in # day} other {Heads up, your trial ends in # days}}"
msgstr "{daysRemaining, plural, one {Achtung, Ihre Testphase endet in # Tag} other {Achtung, Ihre Testphase endet in # Tagen}}"

#: front/components/navigation/TrialBanner.tsx
msgid "When your trial wraps up, your connections and team member access will be removed. Subscribe now to keep everything."
msgstr "Nach Ende Ihrer Testphase werden Ihre Verbindungen und der Zugriff Ihrer Teammitglieder entfernt. Abonnieren Sie jetzt, um alles zu behalten."

#: front/components/navigation/TrialBanner.tsx
msgid "Your current subscription period has ended"
msgstr "Ihr aktueller Abonnementzeitraum ist beendet"

#: front/components/navigation/TrialBanner.tsx
msgid "{daysRemaining, plural, one {Your current subscription period ends in # day} other {Your current subscription period ends in # days}}"
msgstr "{daysRemaining, plural, one {Ihr aktueller Abonnementzeitraum endet in # Tag} other {Ihr aktueller Abonnementzeitraum endet in # Tagen}}"

#: front/components/navigation/TrialBanner.tsx
msgid "Please reach out to your account manager to ensure continuity."
msgstr "Wenden Sie sich an Ihren Account Manager, um einen unterbrechungsfreien Betrieb sicherzustellen."

#: front/components/navigation/TrialBanner.tsx
msgid "Heads up, your subscription has ended"
msgstr "Achtung, Ihr Abonnement ist beendet"

#: front/components/navigation/TrialBanner.tsx
msgid "{daysRemaining, plural, one {Heads up, your subscription ends in # day} other {Heads up, your subscription ends in # days}}"
msgstr "{daysRemaining, plural, one {Achtung, Ihr Abonnement endet in # Tag} other {Achtung, Ihr Abonnement endet in # Tagen}}"

#: front/components/navigation/TrialBanner.tsx
msgid "When your subscription wraps up, your connections and team member access will be removed. Subscribe now to keep everything."
msgstr "Nach Ende Ihres Abonnements werden Ihre Verbindungen und der Zugriff Ihrer Teammitglieder entfernt. Abonnieren Sie jetzt, um alles zu behalten."

#: front/components/navigation/TrialBanner.tsx
msgid "Subscribe to Dust"
msgstr "Dust abonnieren"

#: front/components/navigation/TrialBanner.tsx
msgid "Resume subscription"
msgstr "Abonnement fortsetzen"

