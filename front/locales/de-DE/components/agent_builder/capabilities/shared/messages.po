#: front/components/agent_builder/capabilities/shared/AdditionalConfigurationSection.tsx
msgid "Enter value for {keyLabel}"
msgstr "Wert für {keyLabel} eingeben"

#: front/components/agent_builder/capabilities/shared/AdditionalConfigurationSection.tsx
msgid "Select {keyLabel}"
msgstr "{keyLabel} auswählen"

#: front/components/agent_builder/capabilities/shared/AdditionalConfigurationSection.tsx
msgid "Search {keyLabel}..."
msgstr "{keyLabel} suchen…"

#: front/components/agent_builder/capabilities/shared/AdditionalConfigurationSection.tsx
msgid "No options available"
msgstr "Keine Optionen verfügbar"

#: front/components/agent_builder/capabilities/shared/AdditionalConfigurationSection.tsx
msgid "No options match \"{searchQuery}\""
msgstr "Keine Option entspricht „{searchQuery}“"

#: front/components/agent_builder/capabilities/shared/AdditionalConfigurationSection.tsx
msgid "Additional configuration"
msgstr "Zusätzliche Konfiguration"

#: front/components/agent_builder/capabilities/shared/AdditionalConfigurationSection.tsx
msgid "Configure additional parameters required by this action."
msgstr "Konfigurieren Sie die für diese Aktion erforderlichen zusätzlichen Parameter."

#: front/components/agent_builder/capabilities/shared/ChildAgentSection.tsx
#: front/components/agent_builder/capabilities/shared/DustAppSection.tsx
msgid "Search"
msgstr "Suchen"

#: front/components/agent_builder/capabilities/shared/ChildAgentSection.tsx
#: front/components/agent_builder/capabilities/shared/DustAppSection.tsx
