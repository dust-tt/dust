msgstr "{duration, plural, one {Woche} other {Wochen}}"

#: front/components/agent_builder/capabilities/shared/TimeFrameSection.tsx
msgid "{duration, plural, one {month} other {months}}"
msgstr "{duration, plural, one {Monat} other {Monate}}"

#: front/components/agent_builder/capabilities/shared/TimeFrameSection.tsx
msgid "{duration, plural, one {year} other {years}}"
msgstr "{duration, plural, one {Jahr} other {Jahre}}"

