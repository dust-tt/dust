#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "{disconnectedCount, plural, one {Connection required for personal tools} other {Connections required for personal tools}}"
msgstr "{disconnectedCount, plural, one {Verbindung für persönliche Tools erforderlich} other {Verbindungen für persönliche Tools erforderlich}}"

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "About personal tools"
msgstr "Über persönliche Tools"

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "Personal tools uses credentials of the user running the agent. Other users will be asked to connect their own accounts when they run the agent. <0>Learn more</0>"
msgstr "Persönliche Tools verwenden die Anmeldedaten des Mitglieds, das den Agenten ausführt. Andere Mitglieder werden beim Ausführen des Agenten aufgefordert, ihre eigenen Konten zu verbinden. <0>Mehr erfahren</0>"

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "Connected"
msgstr "Verbunden"

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "Connect"
msgstr "Verbinden"

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "Failed to connect provider"
msgstr "Der Anbieter konnte nicht verbunden werden."

#: front/components/agent_builder/PersonalConnectionRequiredDialog.tsx
msgid "{disconnectedCount, plural, one {# connection is required.} other {# connections are required.}} If you proceed without connecting, the agent will request credentials when they use the tool."
msgstr "{disconnectedCount, plural, one {# Verbindung ist erforderlich.} other {# Verbindungen sind erforderlich.}} Wenn Sie ohne Verbindung fortfahren, fragt der Agent bei der Nutzung des Tools nach Anmeldedaten."

