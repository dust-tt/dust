msgstr "Beschreibung wird generiert…"

#: front/components/agent_builder/settings/AgentBuilderDescriptionSection.tsx
msgid "Add at least {MIN_INSTRUCTIONS_LENGTH_SUGGESTIONS} characters to the instructions to get suggestions"
msgstr "Fügen Sie den Anweisungen mindestens {MIN_INSTRUCTIONS_LENGTH_SUGGESTIONS} Zeichen hinzu, um Vorschläge zu erhalten"

#: front/components/agent_builder/settings/AgentBuilderDescriptionSection.tsx
msgid "Generate description"
msgstr "Beschreibung generieren"

#: front/components/agent_builder/settings/AgentBuilderNameSection.tsx
msgid "Failed to generate name suggestions"
msgstr "Die Namensvorschläge konnten nicht generiert werden."

#: front/components/agent_builder/settings/AgentBuilderNameSection.tsx
msgid "No suggestions available"
msgstr "Keine Vorschläge verfügbar"

#: front/components/agent_builder/settings/AgentBuilderNameSection.tsx
