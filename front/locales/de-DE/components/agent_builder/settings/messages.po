msgstr "Nur Bearbeiter können diesen Agenten sehen und verwenden."

#: front/components/agent_builder/settings/AgentBuilderAvailabilityMessage.tsx
msgid "Only editors with access to all of the following can view and use this agent: {spaceLinks}."
msgstr "Nur Bearbeiter mit Zugriff auf alle folgenden Bereiche können diesen Agenten sehen und verwenden: {spaceLinks}."

#: front/components/agent_builder/settings/AgentBuilderAvailabilityMessage.tsx
msgid "Only editors with access to {spaceLinks} can view and use this agent."
msgstr "Nur Bearbeiter mit Zugriff auf {spaceLinks} können diesen Agenten sehen und verwenden."

#: front/components/agent_builder/settings/AgentBuilderAvailabilityMessage.tsx
msgid "All members can view and use this agent."
msgstr "Alle Mitglieder können diesen Agenten sehen und verwenden."

#: front/components/agent_builder/settings/AgentBuilderAvailabilityMessage.tsx
