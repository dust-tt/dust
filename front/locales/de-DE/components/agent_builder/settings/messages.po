msgstr "Namen des Agenten eingeben"

#: front/components/agent_builder/settings/AgentBuilderNameSection.tsx
msgid "Generating name..."
msgstr "Name wird generiert…"

#: front/components/agent_builder/settings/AgentBuilderNameSection.tsx
msgid "Add at least {MIN_INSTRUCTIONS_LENGTH_SUGGESTIONS} characters to instructions to get suggestions"
msgstr "Fügen Sie den Anweisungen mindestens {MIN_INSTRUCTIONS_LENGTH_SUGGESTIONS} Zeichen hinzu, um Vorschläge zu erhalten"

#: front/components/agent_builder/settings/AgentBuilderNameSection.tsx
msgid "Get name suggestions"
msgstr "Namensvorschläge erhalten"

#: front/components/agent_builder/settings/AgentBuilderSettingsBlock.tsx
msgid "Settings"
msgstr "Einstellungen"

#: front/components/agent_builder/settings/CostManagementSection.tsx
msgid "Cost management"
msgstr "Kostenverwaltung"

#: front/components/agent_builder/settings/CostManagementSection.tsx
msgid "Ignore credit spend threshold alert"
msgstr "Warnung zur Credit-Ausgabeschwelle ignorieren"

#: front/components/agent_builder/settings/CostManagementSection.tsx
msgid "Conversations with this agent will not pause to ask for confirmation when they cross the workspace's credit spend checkpoint."
msgstr "Unterhaltungen mit diesem Agenten werden nicht für eine Bestätigung angehalten, wenn sie die Credit-Ausgabeschwelle des Workspace überschreiten."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Failed to retrieve Slack channels. Please check your Slack integration."
msgstr "Die Slack-Kanäle konnten nicht abgerufen werden. Überprüfen Sie Ihre Slack-Integration."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Search channels..."
msgstr "Kanäle suchen…"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "No channels available"
msgstr "Keine Kanäle verfügbar"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "No channels match \"{searchQuery}\""
msgstr "Keine Kanäle entsprechen „{searchQuery}“"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Open in Slack"
msgstr "In Slack öffnen"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Slack channel settings"
msgstr "Slack-Kanaleinstellungen"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Select channels in which this agent replies by default."
msgstr "Wählen Sie die Kanäle aus, in denen dieser Agent standardmäßig antwortet."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Set this agent as the default agent on one or several of your Slack channels. It will answer by default when the <0>@Dust</0> Slack bot is mentioned in these channels. Private channels you belong to appear here after you add the Slack tool, connect your personal Slack account, and invite <1>@Dust</1> to the channel."
msgstr "Legen Sie diesen Agenten als Standard-Agenten für einen oder mehrere Ihrer Slack-Kanäle fest. Er antwortet standardmäßig, wenn der Slack-Bot <0>@Dust</0> in diesen Kanälen erwähnt wird. Private Kanäle, in denen Sie Mitglied sind, erscheinen hier, nachdem Sie das Slack-Tool hinzugefügt, Ihr persönliches Slack-Konto verbunden und <1>@Dust</1> in den Kanal eingeladen haben."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Admin access required"
msgstr "Administratorzugriff erforderlich"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Only administrators can enable default agents for specific Slack channels."
msgstr "Nur Administratoren können Standard-Agenten für bestimmte Slack-Kanäle aktivieren."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Close"
msgstr "Schließen"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Save"
msgstr "Speichern"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Respond to all messages in channel"
msgstr "Auf alle Nachrichten im Kanal antworten"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Private channels only reply to @mentions. Auto-respond applies to public channels."
msgstr "In privaten Kanälen antwortet der Agent nur auf @Erwähnungen. Die automatische Antwort gilt für öffentliche Kanäle."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Auto-respond isn't available in private Slack channels. The agent will only reply when @Dust is mentioned."
msgstr "Die automatische Antwort ist in privaten Slack-Kanälen nicht verfügbar. Der Agent antwortet nur, wenn @Dust erwähnt wird."

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Agent will automatically respond to messages in selected channels (not just @mentions)"
msgstr "Der Agent antwortet automatisch auf Nachrichten in den ausgewählten Kanälen (nicht nur auf @Erwähnungen)"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Top-level posts only"
msgstr "Nur Beiträge der obersten Ebene"

#: front/components/agent_builder/settings/SlackSettingsSheet.tsx
msgid "Only respond to new channel messages, not replies within threads"
msgstr "Nur auf neue Kanalnachrichten antworten, nicht auf Antworten in Threads"

#: front/components/agent_builder/settings/TagsSection.tsx
msgid "Could not get tag suggestions."
msgstr "Es konnten keine Tag-Vorschläge abgerufen werden."

#: front/components/agent_builder/settings/TagsSection.tsx
msgid "An error occurred while generating tag suggestions. Please contact us if the error persists."
msgstr "Beim Generieren der Tag-Vorschläge ist ein Fehler aufgetreten. Kontaktieren Sie uns, wenn der Fehler weiterhin besteht."

#: front/components/agent_builder/settings/TagsSection.tsx
msgid "No tag suggestions available"
msgstr "Keine Tag-Vorschläge verfügbar"

#: front/components/agent_builder/settings/TagsSection.tsx
msgid "We couldn't find any relevant tags to suggest for this agent."
msgstr "Wir konnten keine passenden Tags für diesen Agenten finden."

#: front/components/agent_builder/settings/TagsSection.tsx
msgid "Tags"
msgstr "Tags"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Add"
msgstr "Hinzufügen"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Select a tag"
msgstr "Tag auswählen"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Choose an option"
msgstr "Option auswählen"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Create \"{newTagName}\""
msgstr "„{newTagName}“ erstellen"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Generating suggestions..."
msgstr "Vorschläge werden generiert…"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Suggested tags"
msgstr "Vorgeschlagene Tags"

#: front/components/agent_builder/settings/TagsSelector.tsx
msgid "Other tags"
msgstr "Weitere Tags"
