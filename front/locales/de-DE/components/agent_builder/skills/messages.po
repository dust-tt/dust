#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Add capabilities"
msgstr "Funktionen hinzufügen"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Add knowledge"
msgstr "Wissen hinzufügen"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Configuration validation failed"
msgstr "Die Validierung der Konfiguration ist fehlgeschlagen."

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Remove {skillName}?"
msgstr "{skillName} entfernen?"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "You will not be able to add this skill back because it is only accessible to the skill editors and you are not an editor."
msgstr "Sie können diese Fähigkeit nicht wieder hinzufügen, da sie nur ihren Bearbeitern zugänglich ist und Sie kein Bearbeiter sind."

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Remove"
msgstr "Entfernen"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Cancel"
msgstr "Abbrechen"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Capabilities and knowledge"
msgstr "Funktionen und Wissen"

#: front/components/agent_builder/skills/AgentBuilderCapabilitiesBlock.tsx
msgid "Add skills, tools, and knowledge to enhance your agent's abilities. Need help? Check our <0>guide</0>."
msgstr "Fügen Sie Fähigkeiten, Tools und Wissen hinzu, um die Möglichkeiten Ihres Agenten zu erweitern. Brauchen Sie Hilfe? Lesen Sie unseren <0>Leitfaden</0>."
