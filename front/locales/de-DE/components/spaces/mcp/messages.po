#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Error sending email"
msgstr "Die E-Mail konnte nicht gesendet werden."

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "An unexpected error occurred while sending email."
msgstr "Beim Senden der E-Mail ist ein unerwarteter Fehler aufgetreten."

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Email sent!"
msgstr "E-Mail gesendet!"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Your request was sent to {adminFullName}"
msgstr "Ihre Anfrage wurde an {adminFullName} gesendet."

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "An unexpected error occurred while sending the request."
msgstr "Beim Senden der Anfrage ist ein unerwarteter Fehler aufgetreten."

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Request tool"
msgstr "Tool anfordern"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Requesting access to {selectedToolName}"
msgstr "Zugriff auf {selectedToolName} anfordern"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Requesting access"
msgstr "Zugriff anfordern"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "There are no extra tools set up that you can request access to. Ask an admin to set one up."
msgstr "Es sind keine weiteren Tools eingerichtet, für die Sie Zugriff anfordern können. Bitten Sie einen Administrator, eines einzurichten."

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Which tools you want to get access to?"
msgstr "Auf welche Tools möchten Sie zugreifen?"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Pick tools"
msgstr "Tools auswählen"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "{adminName} is the administrator for the {selectedToolName} tool within Dust. Send an email to {adminName}, explaining your request."
msgstr "{adminName} ist der Administrator des Tools {selectedToolName} in Dust. Senden Sie {adminName} eine E-Mail, in der Sie Ihre Anfrage erläutern."

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Hello"
msgstr "Hallo"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Cancel"
msgstr "Abbrechen"

#: front/components/spaces/mcp/RequestActionsModal.tsx
msgid "Send"
msgstr "Senden"
