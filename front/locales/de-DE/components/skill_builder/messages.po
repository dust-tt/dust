msgstr "Abbrechen"

#: front/components/skill_builder/SkillBuilder.tsx
msgid "Saving..."
msgstr "Wird gespeichert…"

#: front/components/skill_builder/SkillBuilder.tsx
msgid "Save"
msgstr "Speichern"

#: front/components/skill_builder/SkillBuilderAgentFacingDescriptionSection.tsx
#: front/components/skill_builder/SkillSuggestionCard.tsx
msgid "When to use this skill"
msgstr "Wann diese Fähigkeit verwendet wird"

