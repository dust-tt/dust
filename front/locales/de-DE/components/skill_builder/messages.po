msgid "Create new skill"
msgstr "Neue Fähigkeit erstellen"

#: front/components/skill_builder/SkillBuilder.tsx
msgid "This is a generated skill suggestion"
msgstr "Dies ist ein generierter Fähigkeitsvorschlag"

