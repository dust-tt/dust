msgstr "Unerwartete Antwort vom Server (Status {status})."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "One or more fields are invalid."
msgstr "Ein oder mehrere Felder sind ungültig."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Please check the Snowflake credentials"
msgstr "Überprüfen Sie die Snowflake-Anmeldedaten"

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Enter credentials for a Snowflake service user configured for key-pair authentication."
msgstr "Geben Sie die Anmeldedaten eines Snowflake-Dienstbenutzers ein, der für die Schlüsselpaar-Authentifizierung konfiguriert ist."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
