msgstr "Das Warehouse ist erforderlich."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Private key is required."
msgstr "Der private Schlüssel ist erforderlich."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
