#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "{serverName} API key"
msgstr "API-Schlüssel für {serverName}"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Bearer token"
msgstr "Bearer-Token"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Automatic"
msgstr "Automatisch"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Static OAuth"
msgstr "Statisches OAuth"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Paste your {serverName} API key here"
msgstr "Fügen Sie hier Ihren API-Schlüssel für {serverName} ein"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Paste the bearer token here"
msgstr "Fügen Sie hier das Bearer-Token ein"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "See {presetName} documentation."
msgstr "Siehe Dokumentation von {presetName}."

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "URL"
msgstr "URL"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Authentication"
msgstr "Authentifizierung"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Choose how to authenticate to the MCP server: Automatic discovery, Bearer token, or Static OAuth credentials."
msgstr "Wählen Sie, wie Sie sich beim MCP-Server authentifizieren: automatische Erkennung, Bearer-Token oder statische OAuth-Anmeldedaten."

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Dust will automatically discover if OAuth authentication is required. If OAuth is not needed, the server will be accessed without authentication. Otherwise, Dust will try to use dynamic client registration to get the OAuth credentials."
msgstr "Dust erkennt automatisch, ob eine OAuth-Authentifizierung erforderlich ist. Ist OAuth nicht nötig, wird ohne Authentifizierung auf den Server zugegriffen. Andernfalls versucht Dust, die OAuth-Anmeldedaten über die dynamische Client-Registrierung abzurufen."

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Could not load the redirect URI."
msgstr "Die Weiterleitungs-URI konnte nicht geladen werden."

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Retry"
msgstr "Erneut versuchen"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "Loading redirect URI…"
msgstr "Weiterleitungs-URI wird geladen…"

#: front/components/actions/mcp/create/RemoteMCPServerConfigurationSection.tsx
msgid "In your OAuth app, allow this redirect URI: <0>{redirectUri}</0>"
msgstr "Erlauben Sie in Ihrer OAuth-App diese Weiterleitungs-URI: <0>{redirectUri}</0>"

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Account is required."
msgstr "Das Konto ist erforderlich."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Username is required."
msgstr "Der Benutzername ist erforderlich."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
msgid "Role is required."
msgstr "Die Rolle ist erforderlich."

#: front/components/actions/mcp/create/SnowflakeKeypairCredentialForm.tsx
