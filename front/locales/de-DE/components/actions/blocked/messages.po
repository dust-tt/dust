#: front/components/actions/blocked/PersonalAuthenticationCard.tsx
msgid "Connect account"
msgstr "Konto verbinden"

#: front/components/actions/blocked/PersonalAuthenticationCard.tsx
msgid "Dust needs access to {serverDisplayName} to complete this action."
msgstr "Dust benötigt Zugriff auf {serverDisplayName}, um diese Aktion auszuführen."

#: front/components/actions/blocked/PersonalAuthenticationCard.tsx
msgid "Dust needs access to this service to complete this action."
msgstr "Dust benötigt Zugriff auf diesen Dienst, um diese Aktion auszuführen."

#: front/components/actions/blocked/PersonalAuthenticationCard.tsx
msgid "Once connected, {serverDisplayName} will remain connected for future requests."
msgstr "Nach der Verbindung bleibt {serverDisplayName} für künftige Anfragen verbunden."

#: front/components/actions/blocked/PersonalAuthenticationCard.tsx
msgid "Once connected, this service will remain connected for future requests."
msgstr "Nach der Verbindung bleibt dieser Dienst für künftige Anfragen verbunden."

#: front/components/actions/blocked/PersonalAuthenticationCard.tsx
msgid "Waiting for <0>{triggeringUserName}</0> to connect their account."
msgstr "Warten, bis <0>{triggeringUserName}</0> das Konto verbindet."

#: front/components/actions/blocked/PersonalAuthenticationCard.tsx
#: front/components/actions/blocked/ToolValidationCard.tsx
msgid "Decline"
msgstr "Ablehnen"

#: front/components/actions/blocked/PersonalAuthenticationCard.tsx
msgid "Connect {serverDisplayName}"
msgstr "{serverDisplayName} verbinden"

#: front/components/actions/blocked/SandboxFunctionToolApprovalCard.tsx
msgid "Failed to assess action approval. Please try again."
msgstr "Die Genehmigung der Aktion konnte nicht verarbeitet werden. Versuchen Sie es erneut."

#: front/components/actions/blocked/ToolValidationCard.tsx
msgid "Approval {current} of {total}"
msgstr "Genehmigung {current} von {total}"

