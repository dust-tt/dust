#: front/components/actions/blocked/ToolValidationCard.tsx
msgid "Allow {agentName} to use {serverName}?"
msgstr "{agentName} erlauben, {serverName} zu verwenden?"

#: front/components/actions/blocked/ToolValidationCard.tsx
msgid "Waiting for <0>{triggeringUserName}</0> to confirm."
msgstr "Warten auf die Bestätigung von <0>{triggeringUserName}</0>."

#: front/components/actions/blocked/ToolValidationCard.tsx
msgid "Always allow"
msgstr "Immer erlauben"

#: front/components/actions/blocked/ToolValidationCard.tsx
msgid "Allow all inputs this session"
msgstr "Alle Eingaben in dieser Sitzung erlauben"

#: front/components/actions/blocked/ToolValidationCard.tsx
msgid "Run this tool for the rest of this session without asking again, whatever the inputs. Nothing is saved afterwards."
msgstr "Dieses Tool für den Rest dieser Sitzung ohne erneute Nachfrage ausführen, unabhängig von den Eingaben. Danach wird nichts gespeichert."

