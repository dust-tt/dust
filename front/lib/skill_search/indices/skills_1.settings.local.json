{
  "number_of_shards": 1,
  "number_of_replicas": 0,
  "refresh_interval": "1s",
  "analysis": {
    "filter": {
      "skill_name_words": {
        "type": "word_delimiter_graph",
        "split_on_case_change": true,
        "split_on_numerics": false,
        "stem_english_possessive": false
      }
    },
    "analyzer": {
      "skill_name_analyzer": {
        "type": "custom",
        "tokenizer": "icu_tokenizer",
        "filter": [
          "skill_name_words",
          "icu_folding"
        ]
      }
    }
  }
}
