{
  "name": "@dust-tt/dust-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Run Web-standard HTTP handlers as isolated, serverless-style invocations (no server), and discover their I/O contracts for model tool-use.",
  "type": "module",
  "bin": {
    "dust-functions": "cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun build cli.ts --compile --outfile dist/dust-functions",
    "build:linux-x64": "bun build cli.ts --compile --target=bun-linux-x64 --outfile dist/dust-functions-linux-x64",
    "build:linux-arm64": "bun build cli.ts --compile --target=bun-linux-arm64 --outfile dist/dust-functions-linux-arm64"
  },
  "keywords": ["dust", "functions", "handlers", "serverless"],
  "author": "Dust",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dust-tt/dust",
    "directory": "cli/dust-functions"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
