{
  "extends": "../front/tsconfig.json",
  "compilerOptions": {
    "checkers": 1,
    "paths": {
      "@app/*": [
        "../front/*"
      ],
      "@front-api/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../front/global.d.ts",
    "../front/lib/i18n/po.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "app"
  ]
}