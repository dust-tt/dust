{
  "name": "@dust-tt/sparkle",
  "version": "0.7.7",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "prebuild": "npm run i18n:compile",
    "build": "npm run clean:dist && npm run build:assets && npm run build:esm",
    "build:watch": "npm run build && touch dist/.build-complete",
    "clean:dist": "mkdir -p dist && find dist -mindepth 1 -delete",
    "build:assets": "npm run tailwind && npm run copy:esm",
    "tailwind": "npx @tailwindcss/cli -i ./src/styles/tailwind.css -o dist/sparkle.css",
    "copy:esm": "copyfiles -u 1 src/**/*.css src/**/*.svg src/**/*.png src/**/*.json dist/esm",
    "build:esm": "tsgo --emitDeclarationOnly && npm run build:js && tsc-alias",
    "build:js": "babel src --out-dir dist/esm --extensions .ts,.tsx --ignore 'src/**/*.d.ts' --config-file ./babel.esm.json --source-maps",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile",
    "i18n:check": "npm run i18n:extract && git diff --exit-code -- src/locales && ! git status --porcelain -- src/locales | grep . && npm run i18n:compile -- --strict",
    "prestorybook": "npm run i18n:compile",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run i18n:compile",
    "build-storybook": "storybook build",
    "pretest:unit": "npm run i18n:compile",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "a11y:sync": "node scripts/sync-a11y-tags.mjs",
    "watch": "npm-watch"
  },
  "watch": {
    "build:watch": {
      "patterns": [
        "src"
      ],
      "extensions": "ts,tsx,css,po",
      "ignore": "src/locales/*/messages.ts"
    }
  },
  "nodemonConfig": {
    "signal": "SIGQUIT"
  },
  "main": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./i18n": {
      "types": "./dist/esm/lib/i18n/index.d.ts",
      "import": "./dist/esm/lib/i18n/index.js",
      "default": "./dist/esm/lib/i18n/index.js"
    },
    "./dist/esm/*": {
      "types": "./dist/esm/*.d.ts",
      "import": "./dist/esm/*.js",
      "default": "./dist/esm/*.js"
    },
    "./dist/sparkle.css": "./dist/sparkle.css",
    "./styles/tailwind.css": "./src/styles/tailwind.css",
    "./styles/theme.css": "./src/styles/theme.css"
  },
  "files": [
    "dist/",
    "src/",
    "!src/stories/"
  ],
  "sideEffects": [
    "src/index_with_tw_base.ts",
    "*.css"
  ],
  "devDependencies": {
    "@babel/cli": "^7.29.0",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.28.5",
    "@lingui/babel-plugin-lingui-macro": "6.4.0",
    "@lingui/cli": "6.4.0",
    "@lingui/format-po": "6.4.0",
    "@lingui/vite-plugin": "6.4.0",
    "@radix-ui/react-focus-scope": "^1.0.3",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/addon-themes": "10.5.8",
    "@storybook/addon-vitest": "10.5.8",
    "@storybook/react": "10.5.8",
    "@storybook/react-vite": "10.5.8",
    "@svgr/cli": "^8.0.1",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript/native-preview": "^7.0.0-dev.20260224.1",
    "@vitest/browser": "4.0.18",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "copyfiles": "^2.4.1",
    "npm-watch": "^0.11.0",
    "playwright": "1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "10.5.8",
    "storybook-addon-tag-badges": "^3.1.0",
    "tailwindcss": "^4.3.0",
    "tsc-alias": "^1.8.10",
    "tw-animate-css": "^1.4.0",
    "typescript-transform-paths": "^3.4.7",
    "uuid": "^11.1.1",
    "vite": "^8.0.0",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": "Sparkle is Dust's Design System",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dust-tt/dust.git"
  },
  "author": "Dust (Permutation Labs SAS)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dust-tt/dust/issues"
  },
  "homepage": "https://github.com/dust-tt/dust#readme",
  "dependencies": {
    "@emoji-mart/data": "^1.1.2",
    "@emoji-mart/react": "^1.1.1",
    "@headlessui/react": "^1.7.19",
    "@lingui/core": "6.4.0",
    "@lingui/react": "6.4.0",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-table": "^8.13.0",
    "@tanstack/react-virtual": "^3.5.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "allotment": "^1.20.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emoji-mart": "^5.5.2",
    "framer-motion": "^11.18.2",
    "lottie-react": "^2.4.0",
    "mermaid": "^11.4.1",
    "react-confetti": "^6.1.0",
    "react-katex": "^3.0.1",
    "react-markdown": "^8.0.7",
    "react-resizable-panels": "^2.1.7",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^2.0.1",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.3",
    "tailwind-scrollbar-hide": "^1.1.7",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.25.76"
  }
}